# Copy to $HOME/.config/oi-manager/operations.env with mode 600.
# Never commit the real webhook URL, recipient or storage credentials.
MONITOR_ALERT_COMMAND=/data/oi-manager-response-refactor/scripts/send-monitor-alert.sh
MONITOR_ALERT_WEBHOOK_URL_FILE=/home/ecs-user/.config/oi-manager/monitor-webhook-url

# This must execute a trusted uploader that copies both the archive and its
# checksum to a different host or object store and exits non-zero on failure.
LOG_ARCHIVE_COMMAND=/usr/local/bin/oi-manager-log-upload
LOG_ARCHIVE_SPOOL_DIR=/data/backups/oi-manager/log-archive-spool
LOG_ARCHIVE_SINCE_HOURS=24
LOG_ARCHIVE_KEEP_DAYS=7
