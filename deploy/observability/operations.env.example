# Copy to $HOME/.config/oi-manager/operations.env with mode 600.
# Never commit the real webhook URL, recipient or storage credentials.
MONITOR_ALERT_COMMAND=/data/oi-manager-response-refactor/scripts/send-monitor-alert.sh
MONITOR_ALERT_WEBHOOK_URL_FILE=/home/ecs-user/.config/oi-manager/monitor-webhook-url

# Runtime thresholds. Tune only from observed production baselines, and record
# the reason for every change. A first transition into failure automatically
# captures a protected incident evidence bundle before alert delivery.
MONITOR_METRICS_MAX_AGE_SECONDS=600
MONITOR_API_RSS_MAX_MB=1024
MONITOR_EVENT_LOOP_P99_MAX_MS=250
MONITOR_API_ENDPOINT_MIN_REQUESTS=20
MONITOR_API_ENDPOINT_5XX_MAX_PERCENT=5
MONITOR_API_ENDPOINT_P99_MAX_MS=5000
MONITOR_JUDGE_METRICS_MAX_AGE_SECONDS=180
MONITOR_JUDGE_RSS_MAX_MB=2048
MONITOR_INCIDENT_CAPTURE_COMMAND=/data/oi-manager-response-refactor/scripts/capture-incident-evidence.sh

# Both values must be absolute executable files, not shell fragments. The
# uploader copies the archive and checksum to a different host or object store.
# The verifier must independently read/download the remote object and compare
# LOG_ARCHIVE_SHA256 and LOG_ARCHIVE_SIZE before the local archive is marked as
# safely uploaded and becomes eligible for retention cleanup.
LOG_ARCHIVE_COMMAND=/usr/local/bin/oi-manager-log-upload
LOG_ARCHIVE_VERIFY_COMMAND=/usr/local/bin/oi-manager-log-verify
LOG_ARCHIVE_SPOOL_DIR=/data/backups/oi-manager/log-archive-spool
LOG_ARCHIVE_SINCE_HOURS=24
LOG_ARCHIVE_KEEP_DAYS=7
