[Unit]
Description=OI Manager API server
Documentation=file:///data/oi-manager-response-refactor/docs/operations/SYSTEMD_DEPLOYMENT.md
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/data/oi-manager-response-refactor/apps/server
Environment=NODE_ENV=development
Environment=APP_ENV=development
Environment=HOME=/home/ecs-user
EnvironmentFile=/data/oi-manager-response-refactor/apps/server/.env
Environment=DISABLE_BACKGROUND_JOBS=true
ExecStart=/usr/bin/env DISABLE_BACKGROUND_JOBS=true /usr/bin/node /data/oi-manager-response-refactor/apps/server/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
MemoryMax=1024M
TasksMax=512
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/data/oi-manager-response-refactor

[Install]
WantedBy=multi-user.target
