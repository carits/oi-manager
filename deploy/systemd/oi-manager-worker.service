[Unit]
Description=OI Manager singleton background worker
Documentation=file:///data/oi-manager-response-refactor/docs/operations/SYSTEMD_DEPLOYMENT.md
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/data/oi-manager-response-refactor/apps/server
EnvironmentFile=/data/oi-manager-response-refactor/apps/server/.env
Environment=NODE_ENV=development
Environment=APP_ENV=development
Environment=HOME=/home/ecs-user
ExecStart=/usr/bin/node /data/oi-manager-response-refactor/apps/server/dist/background-worker.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/data/oi-manager-response-refactor

[Install]
WantedBy=multi-user.target
