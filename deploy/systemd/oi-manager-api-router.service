[Unit]
Description=OI Manager stable API router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/data/oi-manager-response-refactor
Environment=API_ROUTER_HOST=127.0.0.1
Environment=API_ROUTER_PORT=3002
Environment=API_ACTIVE_UPSTREAM_FILE=/data/oi-manager-response-refactor/.run/api-active-upstream
ExecStart=/usr/bin/node /data/oi-manager-response-refactor/scripts/api-router.mjs
Restart=always
RestartSec=2s
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadOnlyPaths=/data/oi-manager-response-refactor

[Install]
WantedBy=multi-user.target
