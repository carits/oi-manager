[Unit]
Description=OI Manager API server on port %i
Documentation=file:///data/oi-manager-response-refactor/docs/operations/SYSTEMD_DEPLOYMENT.md
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/data/oi-manager-response-refactor/apps/server
EnvironmentFile=/data/oi-manager-response-refactor/apps/server/.env
Environment=NODE_ENV=development
Environment=APP_ENV=development
Environment=HOME=/home/ecs-user
Environment=PORT=%i
Environment=API_HOST=127.0.0.1
Environment=SKIP_JUDGE_RECOVERY=true
# EnvironmentFile can contain the legacy stable PORT=3002. Put slot-specific
# values on the final exec command so a blue/green candidate never binds the
# stable router port before promotion.
ExecStart=/usr/bin/env PORT=%i API_HOST=127.0.0.1 SKIP_JUDGE_RECOVERY=true /usr/bin/node /data/oi-manager-response-refactor/apps/server/dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGUSR2
MemoryMax=1024M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/data/oi-manager-response-refactor

[Install]
WantedBy=multi-user.target
