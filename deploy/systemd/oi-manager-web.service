[Unit]
Description=OI Manager web preview
Documentation=file:///data/oi-manager-response-refactor/docs/operations/SYSTEMD_DEPLOYMENT.md
Wants=network-online.target
After=network-online.target oi-manager-server.service
Wants=oi-manager-server.service
StartLimitIntervalSec=60s
StartLimitBurst=10

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/data/oi-manager-response-refactor/apps/web
Environment=APP_ENV=development
Environment=NODE_ENV=production
Environment=NEXT_DIST_DIR=.next-current
Environment=HOME=/home/ecs-user
ExecStart=/usr/bin/node /data/oi-manager-response-refactor/apps/web/node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000
Restart=on-failure
RestartSec=5s
MemoryMax=1024M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/data/oi-manager-response-refactor/apps/web/.next-current

[Install]
WantedBy=multi-user.target
