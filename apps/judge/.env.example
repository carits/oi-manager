# 评测机配置

# 后端 WebSocket 地址
BACKEND_URL=ws://localhost:3001

# 必须与同环境后端的 JUDGE_TOKEN 一致
JUDGE_TOKEN=CHANGE_ME_TO_A_DEVELOPMENT_TOKEN
ALLOW_UNAUTHENTICATED_JUDGE=false

# go-judge 沙箱地址
SANDBOX_HOST=http://localhost:5050

# 评测机标识
JUDGE_ID=judge-1

# 最大并发评测数
MAX_CONCURRENT=2

# 测试数据目录
TESTDATA_DIR=../server/testdata

# 评测超时（毫秒）
JUDGE_TIMEOUT=60000

# 日志级别
LOG_LEVEL=info
