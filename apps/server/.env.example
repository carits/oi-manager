# 数据库（必须）
DATABASE_URL="file:./dev.db"

# JWT 密钥（生产环境必须）
# 开发环境可省略，生产环境必须配置
JWT_SECRET="your-secret-key-change-in-production"

# 服务端口（可选，默认 3001）
PORT=3001

# 运行环境（可选，默认 development）
NODE_ENV=development

# CORS 跨域白名单（生产环境必须）
# 多个域名用逗号分隔
# 开发环境自动允许 localhost，无需配置
# 生产环境示例：CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com
CORS_ORIGINS=

# 洛谷 Cookie（可选，用于下载洛谷附件）
# 某些洛谷附件需要登录才能下载
# 获取方式：
# 1. 登录洛谷 https://www.luogu.com.cn
# 2. 打开浏览器开发者工具 (F12) -> Application -> Cookies
# 3. 复制所有 cookie 字符串（格式如 "key1=value1; key2=value2"）
# LUOGU_COOKIE="_uid=xxx; __client_id=xxx; ..."