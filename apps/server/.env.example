# 数据库（必须）
DATABASE_URL="postgresql://oi:oi_password@127.0.0.1:5432/oi_manager?schema=public"

# JWT 密钥（生产环境必须）
# 开发环境可省略，生产环境必须配置
JWT_SECRET="your-secret-key-change-in-production"

# 服务端口（可选，默认 3002）
PORT=3002

# 运行环境（可选，默认 development）
NODE_ENV=development
APP_ENV=development
COOKIE_SECURE=false
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3100

# CORS 跨域白名单（生产环境必须）
# 多个域名用逗号分隔
# 开发环境自动允许 localhost，无需配置
# 生产环境示例：CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com
CORS_ORIGINS=

# 评测机认证（开发和生产环境使用不同的随机值）
# 同一个环境中必须与 apps/judge/.env 的值一致
JUDGE_TOKEN="CHANGE_ME_TO_A_DEVELOPMENT_TOKEN"

# 仅允许在明确的 loopback 开发场景开启；默认 false
ALLOW_UNAUTHENTICATED_JUDGE=false

# 数据迁移维护接口默认关闭，需要时临时开启并在完成后关闭
ENABLE_MAINTENANCE_API=false

# 洛谷 Cookie（可选，用于下载洛谷附件）
# 某些洛谷附件需要登录才能下载
# 获取方式：
# 1. 登录洛谷 https://www.luogu.com.cn
# 2. 打开浏览器开发者工具 (F12) -> Application -> Cookies
# 3. 复制所有 cookie 字符串（格式如 "key1=value1; key2=value2"）
# LUOGU_COOKIE="_uid=xxx; __client_id=xxx; ..."
