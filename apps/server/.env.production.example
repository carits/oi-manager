# 生产环境配置模板
# 复制为 .env.production 并修改为实际值

# PostgreSQL 数据库连接
DATABASE_URL="postgresql://oi:CHANGE_ME@localhost:5432/oi_manager?schema=public"

# JWT Secret（生产环境必须使用强随机密钥）
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# CORS 跨域白名单（生产环境必须配置）
# 多个域名用逗号分隔
CORS_ORIGINS=https://your-domain.com

# 评测机认证 Token（生产环境必须配置）
# 评测机连接 WebSocket 时必须携带此 Token
JUDGE_TOKEN="CHANGE_ME_TO_A_RANDOM_TOKEN"

# OJ 账号加密密钥（生产环境必须配置）
# 用于加密存储的 OJ 平台账号密码
ACCOUNT_ENCRYPT_KEY="CHANGE_ME_TO_A_32_CHAR_KEY"

# 服务端口
PORT=3002

# API 限流（每分钟最大请求数）
RATE_LIMIT_MAX=2000

# DeepSeek API Key（AI 翻译用）
# DEEPSEEK_API_KEY=sk-xxx

# 洛谷 Cookie（用于下载附件）
# LUOGU_COOKIE="__client_id=xxx; _uid=xxx"

# QOJ Session（用于 PDF 下载）
# QOJ_SESSION="xxx"
