model ProblemSolution {
  id               String                   @id
  problemId        String
  type             SolutionType
  authorUserId     String?
  organizationId   String?
  approachKey      String?
  title            String
  status           ProblemSolutionStatus    @default(PUBLISHED)
  primary          Boolean                  @default(false)
  recommended      Boolean                  @default(false)
  visibilityPolicy SolutionVisibilityPolicy @default(PUBLIC)
  currentVersionId String?                  @unique
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  Problem          Problem                  @relation(fields: [problemId], references: [id], onDelete: Restrict)
  Author           User?                    @relation("ProblemSolutionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  Organization     Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  CurrentVersion   ProblemSolutionVersion?  @relation("ProblemSolutionCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  Versions         ProblemSolutionVersion[] @relation("ProblemSolutionVersions")
  Contributions    SolutionContribution[]   @relation("SolutionContributionBaseSolution")

  @@index([problemId, status, recommended])
  @@index([organizationId, status])
  @@index([authorUserId])
}

model ProblemSolutionVersion {
  id                           String                       @id
  solutionId                   String
  version                      Int
  title                        String
  contentMarkdown              String                       @db.Text
  algorithmTags                Json?
  approachKey                  String?
  complexityTime               String?
  complexityMemory             String?
  language                     String?
  referenceCode                String?                      @db.Text
  sourceType                   SolutionSourceType
  sourceUrl                    String?
  citation                     String?
  licenseDeclarationVersion    Int
  statementSnapshot            Json
  statementSnapshotHash        String
  verifiedTestSetSlot          ProblemTestSetSlotKind       @default(STABLE)
  verifiedTestSetGraphHash     String
  sourceContributionRevisionId String                       @unique
  verificationId               String                       @unique
  contentHash                  String
  status                       ProblemSolutionVersionStatus @default(PUBLISHED)
  visibilityPolicy             SolutionVisibilityPolicy     @default(PUBLIC)
  publishedByUserId            String
  publishedAt                  DateTime                     @default(now())
  createdAt                    DateTime                     @default(now())
  Solution                     ProblemSolution              @relation("ProblemSolutionVersions", fields: [solutionId], references: [id], onDelete: Restrict)
  CurrentForSolution           ProblemSolution?             @relation("ProblemSolutionCurrentVersion")
  SourceContributionRevision   SolutionContributionRevision @relation(fields: [sourceContributionRevisionId], references: [id], onDelete: Restrict)
  Verification                 SolutionVerification         @relation(fields: [verificationId], references: [id], onDelete: Restrict)
  PublishedBy                  User                         @relation("SolutionVersionPublisher", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  BasedContributions           SolutionContribution[]       @relation("SolutionContributionBaseVersion")
  BlogReferences               BlogReference[]
  SimilarityMatches            SolutionSimilarityCheck[]    @relation("SolutionSimilarityPublishedMatch")

  @@unique([solutionId, version])
  @@index([status, publishedAt])
}

model SolutionSimilarityCheck {
  id                            String                        @id
  contributionRevisionId        String                        @unique
  textSimilarityBasisPoints     Int
  codeSimilarityBasisPoints     Int
  maximumSimilarityBasisPoints  Int
  riskLevel                     SolutionSimilarityRisk
  matchedSolutionVersionId      String?
  matchedContributionRevisionId String?
  sourceDeclared                Boolean
  comparisonCount               Int
  algorithmVersion              Int                           @default(1)
  details                       Json?
  checkedAt                     DateTime                      @default(now())
  ContributionRevision          SolutionContributionRevision  @relation("SolutionSimilaritySubject", fields: [contributionRevisionId], references: [id], onDelete: Restrict)
  MatchedSolutionVersion        ProblemSolutionVersion?       @relation("SolutionSimilarityPublishedMatch", fields: [matchedSolutionVersionId], references: [id], onDelete: SetNull)
  MatchedContributionRevision   SolutionContributionRevision? @relation("SolutionSimilarityContributionMatch", fields: [matchedContributionRevisionId], references: [id], onDelete: SetNull)

  @@index([riskLevel, checkedAt])
  @@index([matchedSolutionVersionId])
  @@index([matchedContributionRevisionId])
}

model SolutionSimilarityJob {
  id                     String                       @id
  contributionRevisionId String                       @unique
  status                 String                       @default("QUEUED")
  attempts               Int                          @default(0)
  leaseOwner             String?
  leaseToken             String?
  leaseExpiresAt         DateTime?
  nextAttemptAt          DateTime                     @default(now())
  lastError              String?                      @db.Text
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  ContributionRevision   SolutionContributionRevision @relation(fields: [contributionRevisionId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model SolutionContentFingerprint {
  id               String   @id
  targetType       String
  targetId         String
  contentHash      String
  algorithmVersion Int      @default(2)
  textSignature    Json
  codeSignature    Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([targetType, targetId, algorithmVersion])
  @@index([contentHash, algorithmVersion])
}

model School {
  id                           String        @id
  name                         String
  nameKey                      String?       @unique
  shortName                    String?
  description                  String?
  announcement                 String?
  region                       String?
  schoolType                   String?
  schoolNature                 String?
  educationSystem              String?       @default("6-3-3")
  educationSystemDetail        Json?
  informaticsEnabled           Boolean       @default(false)
  informaticsStages            Json?
  informaticsContests          Json?
  informaticsTracks            Json?
  contactPerson                String?
  contactPhone                 String?
  contactEmail                 String?
  status                       String        @default("active")
  directoryStatus              String        @default("pending")
  currentPrincipalMembershipId String?       @unique
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @default(now())
  organizationId               String?       @unique
  Organization                 Organization? @relation(fields: [organizationId], references: [id])

  @@index([directoryStatus, status])
}

model Organization {
  id                       String                                @id
  name                     String
  type                     String                                @default("school")
  status                   String                                @default("active")
  joinPolicy               String                                @default("invite_only")
  description              String?
  createdAt                DateTime                              @default(now())
  updatedAt                DateTime                              @updatedAt
  School                   School?
  Membership               OrganizationMembership[]
  JoinApplications         OrganizationJoinApplication[]
  CreationApplications     OrganizationCreationApplication[]
  Invitations              OrganizationInvitation[]
  AuditLogs                OrganizationAuditLog[]
  CaritsAccount            CaritsAccount?                        @relation("CaritsAccountOrganization")
  CaritsTransactions       CaritsTransaction[]                   @relation("CaritsTransactionOrganization")
  ContributionAttributions OrganizationContributionAttribution[]
  ContributionProjects     ContributionProject[]
  ContributionDataJobs     ProblemDataGenerationJob[]            @relation("DataGenerationContributionOrganization")
  ContributionHackAttempts ProblemHackAttempt[]                  @relation("HackContributionOrganization")
  ContributionCandidates   TestcaseCandidate[]                   @relation("CandidateContributionOrganization")
  SolutionContributions    SolutionContribution[]
  ProblemSolutions         ProblemSolution[]
  PrincipalTransferLog     PrincipalTransferLog[]
  Problem                  Problem[]
  ProblemList              ProblemList[]
  SchoolProblemList        SchoolProblemList[]
  Team                     Team[]
  TrainingSession          TrainingSession[]
  Assignment               Assignment[]
  Submission               Submission[]
  Contests                 Contest[]
  RatingPools              RatingPool[]
  BlogPosts                BlogPost[]
  BlogSeries               BlogSeries[]
  SoldDataProducts         DataProduct[]                         @relation("DataProductSellerOrganization")
  DataPurchases            DataPurchase[]
  DataEntitlements         DataEntitlement[]

  @@index([type, status])
}

model OrganizationMembership {
  id                       String                             @id
  organizationId           String
  userId                   String
  memberRole               String
  relationType             String
  status                   String                             @default("active")
  joinedAt                 DateTime?
  createdAt                DateTime                           @default(now())
  updatedAt                DateTime                           @updatedAt
  Organization             Organization                       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  User                     User                               @relation(fields: [userId], references: [id], onDelete: Restrict)
  StudentProfile           OrganizationStudentProfile?
  TeacherProfile           OrganizationTeacherProfile?
  StudentMilestones        Milestone[]                        @relation("MilestoneStudentMembership")
  TeacherMilestones        Milestone[]                        @relation("MilestoneTeacherMembership")
  FormerPrincipalTransfers PrincipalTransferLog[]             @relation("FormerPrincipalMembership")
  NewPrincipalTransfers    PrincipalTransferLog[]             @relation("NewPrincipalMembership")
  ReviewedJoinApplications OrganizationJoinApplication[]      @relation("JoinApplicationReviewerMembership")
  SentInvitations          OrganizationInvitation[]           @relation("InvitationSenderMembership")
  AssignedInvitations      OrganizationInvitation[]           @relation("InvitationHeadTeacherMembership")
  CreatedAssignments       Assignment[]                       @relation("AssignmentCreatorMembership")
  AssignmentRecipients     AssignmentRecipient[]
  RoleAssignments          OrganizationMembershipRole[]
  CapabilityGrants         OrganizationMembershipCapability[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

/// Normalized, additive authorization roles for one organization relationship.
/// OrganizationMembership.memberRole remains only the profile discriminator;
/// authorization reads this relation and explicit capability grants.
model OrganizationMembershipRole {
  id           String                 @id
  membershipId String
  roleKey      String
  source       String                 @default("application")
  grantedBy    String?
  createdAt    DateTime               @default(now())
  Membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleKey])
  @@index([roleKey])
}

/// Explicit capability grants supplement role-derived capabilities. Revoking a
/// role does not rewrite historical profile identity.
model OrganizationMembershipCapability {
  id            String                 @id
  membershipId  String
  capabilityKey String
  source        String                 @default("explicit")
  grantedBy     String?
  createdAt     DateTime               @default(now())
  Membership    OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, capabilityKey])
  @@index([capabilityKey])
}

model OrganizationJoinApplication {
  id                     String                  @id
  organizationId         String
  userId                 String
  requestedRole          String
  requestedRelationType  String
  realName               String
  profileData            Json?
  message                String?
  status                 String                  @default("pending")
  reviewedByUserId       String?
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  decisionMessage        String?
  internalReviewNote     String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  Organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  User                   User                    @relation("JoinApplicationApplicant", fields: [userId], references: [id], onDelete: Restrict)
  ReviewedByUser         User?                   @relation("JoinApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  ReviewedByMembership   OrganizationMembership? @relation("JoinApplicationReviewerMembership", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([userId, status, createdAt])
}

model OrganizationInvitation {
  id                      String                  @id
  organizationId          String
  userId                  String
  memberRole              String
  relationType            String
  invitedByUserId         String
  invitedByMembershipId   String
  headTeacherMembershipId String?
  profileData             Json?
  message                 String?
  status                  String                  @default("pending")
  expiresAt               DateTime?
  respondedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  Organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  User                    User                    @relation("OrganizationInvitee", fields: [userId], references: [id], onDelete: Restrict)
  InvitedByUser           User                    @relation("OrganizationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  InvitedByMembership     OrganizationMembership  @relation("InvitationSenderMembership", fields: [invitedByMembershipId], references: [id], onDelete: Restrict)
  HeadTeacherMembership   OrganizationMembership? @relation("InvitationHeadTeacherMembership", fields: [headTeacherMembershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([expiresAt, status])
}

model OrganizationAuditLog {
  id                String       @id
  organizationId    String
  actorUserId       String?
  actorMembershipId String?
  action            String
  targetUserId      String?
  sourceType        String?
  sourceId          String?
  metadata          Json?
  createdAt         DateTime     @default(now())
  Organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

model OrganizationCreationApplication {
  id                    String        @id
  applicantUserId       String
  organizationType      String        @default("school")
  name                  String
  nameKey               String
  shortName             String?
  region                String
  schoolType            String
  schoolNature          String?
  educationSystem       String?
  contactPerson         String?
  contactPhone          String?
  contactEmail          String?
  applicantRealName     String
  applicantTitle        String?
  description           String        @db.Text
  evidenceData          Json?
  status                String        @default("pending")
  reviewedByUserId      String?
  reviewedAt            DateTime?
  decisionMessage       String?
  internalReviewNote    String?
  createdOrganizationId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  Applicant             User          @relation("OrganizationCreationApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  ReviewedBy            User?         @relation("OrganizationCreationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  CreatedOrganization   Organization? @relation(fields: [createdOrganizationId], references: [id], onDelete: SetNull)

  @@index([applicantUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([nameKey, status])
}

model PlatformAuditLog {
  id          String   @id
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  Actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model OrganizationStudentProfile {
  id                      String                      @id
  membershipId            String                      @unique
  name                    String
  gender                  String?
  enrollmentYear          Int?
  targetContest           String?
  headTeacherMembershipId String?
  tags                    String?
  notes                   String?
  avatar                  String?
  rating                  Int                         @default(1200)
  status                  String                      @default("active")
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  Membership              OrganizationMembership      @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  ContestProblemScores    ContestProblemScore[]       @relation("ContestProblemScoreStudentProfile")
  ContestResults          ContestResult[]             @relation("ContestResultStudentProfile")
  ExternalAccounts        TeamMemberExternalAccount[] @relation("ExternalAccountStudentProfile")

  @@index([headTeacherMembershipId])
  @@index([status])
}

model OrganizationTeacherProfile {
  id           String                 @id
  membershipId String                 @unique
  name         String
  email        String?
  phone        String?
  avatar       String?
  bio          String?
  title        String?
  status       String                 @default("active")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  Membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([status])
}

enum CaritsAccountOwnerType {
  USER
  ORGANIZATION
  SYSTEM
}

model CaritsAccount {
  id             String                 @id
  ownerType      CaritsAccountOwnerType
  userId         String?                @unique
  organizationId String?                @unique
  systemKey      String?                @unique
  balance        BigInt                 @default(0)
  status         String                 @default("active")
  version        Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  User           User?                  @relation("CaritsAccountUser", fields: [userId], references: [id], onDelete: Restrict)
  Organization   Organization?          @relation("CaritsAccountOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  LedgerEntries  CaritsLedgerEntry[]

  @@index([ownerType, status])
}

model CaritsTransaction {
  id                 String                       @id
  type               String
  status             String                       @default("draft")
  idempotencyKey     String                       @unique
  requestFingerprint String?
  referenceType      String?
  referenceId        String?
  operatorUserId     String?
  organizationId     String?
  metadata           Json?
  createdAt          DateTime                     @default(now())
  postedAt           DateTime?
  Operator           User?                        @relation("CaritsTransactionOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  Organization       Organization?                @relation("CaritsTransactionOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  Entries            CaritsLedgerEntry[]
  RewardDeliveries   ContributionRewardDelivery[] @relation("ContributionRewardTransaction")
  RewardReversals    ContributionRewardDelivery[] @relation("ContributionRewardReversal")
  ResourcePurchase   ResourcePurchase?
  DataPurchase       DataPurchase?

  @@index([referenceType, referenceId])
  @@index([organizationId, createdAt])
}

model CaritsLedgerEntry {
  id            String            @id
  transactionId String
  accountId     String
  amount        BigInt
  balanceAfter  BigInt
  createdAt     DateTime          @default(now())
  Transaction   CaritsTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  Account       CaritsAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, accountId])
  @@index([accountId, createdAt])
  @@index([transactionId])
}

model ContributionEvent {
  id             String                               @id
  actorUserId    String
  type           String
  sourceType     String
  sourceId       String
  score          Int
  ruleCode       String
  ruleVersion    Int
  dedupeKey      String                               @unique
  status         String                               @default("pending")
  evidence       Json?
  occurredAt     DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  revokeReason   String?
  createdAt      DateTime                             @default(now())
  Actor          User                                 @relation("ContributionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  Attribution    OrganizationContributionAttribution?
  RewardDelivery ContributionRewardDelivery?

  @@index([actorUserId, status, acceptedAt])
  @@index([sourceType, sourceId])
  @@index([status, acceptedAt])
}

model ContributionRewardDelivery {
  id                    String             @id
  contributionId        String             @unique
  policyCode            String
  policyVersion         Int
  userCarits            BigInt
  organizationCarits    BigInt             @default(0)
  status                String             @default("pending")
  transactionId         String?            @unique
  reversalTransactionId String?            @unique
  attemptCount          Int                @default(0)
  fencingToken          String?            @unique
  leaseExpiresAt        DateTime?
  nextAttemptAt         DateTime?
  errorMessage          String?            @db.Text
  createdAt             DateTime           @default(now())
  postedAt              DateTime?
  reversedAt            DateTime?
  Contribution          ContributionEvent  @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  Transaction           CaritsTransaction? @relation("ContributionRewardTransaction", fields: [transactionId], references: [id], onDelete: Restrict)
  ReversalTransaction   CaritsTransaction? @relation("ContributionRewardReversal", fields: [reversalTransactionId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model OrganizationContributionAttribution {
  id             String            @id
  contributionId String            @unique
  organizationId String
  reason         String
  evidence       Json?
  createdAt      DateTime          @default(now())
  Contribution   ContributionEvent @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  Organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

model ContributionProject {
  id                    String       @id
  organizationId        String
  name                  String
  description           String?
  resourceType          String?
  resourceId            String?
  status                String       @default("active")
  createdByMembershipId String
  createdAt             DateTime     @default(now())
  archivedAt            DateTime?
  Organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
}

model SchoolProblemList {
  id             String       @id
  organizationId String
  problemListId  String
  addedBy        String
  addedByRole    String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  ProblemList    ProblemList  @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, problemListId])
  @@index([addedBy])
  @@index([problemListId])
  @@index([organizationId])
}

model RejudgeBatch {
  id           String             @id
  contestId    String?
  scopeType    String
  scopePayload Json?
  status       RejudgeBatchStatus @default(CREATED)
  requestedBy  String
  matchedCount Int                @default(0)
  queuedCount  Int                @default(0)
  skippedCount Int                @default(0)
  errorMessage String?
  createdAt    DateTime           @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  Contest      Contest?           @relation(fields: [contestId], references: [id], onDelete: Cascade)
  JudgeRuns    JudgeRun[]

  @@index([contestId, createdAt])
  @@index([status, createdAt])
  @@index([requestedBy, createdAt])
}

model JudgeRun {
  id                        String                  @id
  submissionId              Int
  runNumber                 Int
  runType                   JudgeRunType
  status                    JudgeRunStatus          @default(QUEUED)
  testSetSlot               ProblemTestSetSlotKind?
  testSetFencingToken       Int?
  testSetGraphHash          String?
  testSetReaderId           String?                 @unique
  judgeConfigHash           String?
  judgeConfigSnapshot       String?                 @db.Text
  inputFilename             String?
  outputFilename            String?
  ioAdapterVersion          Int                     @default(1)
  rejudgeBatchId            String?
  requestedBy               String?
  result                    String?
  score                     Int?
  cases                     String?
  subtasks                  String?
  errorMessage              String?
  timeUsed                  Int?
  wallTimeUsed              Int?
  memoryUsed                Int?
  timeoutReason             String?
  metricSource              String?
  currentAttemptId          String?                 @unique
  trainingScoreGoalIndex    Int?
  trainingScoreGoalSnapshot Json?
  createdAt                 DateTime                @default(now())
  startedAt                 DateTime?
  finalizedAt               DateTime?
  updatedAt                 DateTime                @updatedAt
  Submission                Submission              @relation("SubmissionJudgeRuns", fields: [submissionId], references: [id], onDelete: Cascade)
  CurrentForSubmission      Submission?             @relation("SubmissionCurrentJudgeRun")
  RejudgeBatch              RejudgeBatch?           @relation(fields: [rejudgeBatchId], references: [id], onDelete: SetNull)
  Attempts                  JudgeAttempt[]          @relation("JudgeRunAttempts")
  CurrentAttempt            JudgeAttempt?           @relation("JudgeRunCurrentAttempt", fields: [currentAttemptId], references: [id], onDelete: SetNull)
  TestSetReader             ProblemTestSetReader?   @relation("JudgeRunTestSetReader", fields: [testSetReaderId], references: [id], onDelete: SetNull)

  @@unique([submissionId, runNumber])
  @@index([status, createdAt])
  @@index([testSetSlot])
  @@index([rejudgeBatchId])
}

model JudgeAttempt {
  id                String            @id
  judgeRunId        String
  attemptNumber     Int
  state             JudgeAttemptState @default(QUEUED)
  judgeId           String?
  fencingToken      String            @unique
  retryOfAttemptId  String?
  leaseUntil        DateTime?
  result            String?
  score             Int?
  cases             String?
  subtasks          String?
  errorMessage      String?
  timeUsed          Int?
  wallTimeUsed      Int?
  memoryUsed        Int?
  timeoutReason     String?
  metricSource      String?
  queueLatencyMs    Int?
  dispatchLatencyMs Int?
  compileLatencyMs  Int?
  runLatencyMs      Int?
  persistLatencyMs  Int?
  totalLatencyMs    Int?
  createdAt         DateTime          @default(now())
  claimedAt         DateTime?
  startedAt         DateTime?
  finalizedAt       DateTime?
  updatedAt         DateTime          @updatedAt
  JudgeRun          JudgeRun          @relation("JudgeRunAttempts", fields: [judgeRunId], references: [id], onDelete: Cascade)
  CurrentForRun     JudgeRun?         @relation("JudgeRunCurrentAttempt")
  RetryOfAttempt    JudgeAttempt?     @relation("JudgeAttemptRetry", fields: [retryOfAttemptId], references: [id], onDelete: SetNull)
  RetriedBy         JudgeAttempt[]    @relation("JudgeAttemptRetry")

  @@unique([judgeRunId, attemptNumber])
  @@index([state, createdAt])
  @@index([judgeId, state])
  @@index([retryOfAttemptId])
}

model Submission {
  id                        Int                      @id @default(autoincrement())
  userId                    String
  oj                        String
  problemId                 String
  language                  String
  code                      String
  codeLength                Int
  submitMethod              String
  ojAccountId               String?
  ojRemoteId                String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @default(now())
  problemInternalId         String?
  isGlobalVisible           Boolean                  @default(true)
  sourceId                  String?
  submitSource              String?
  submitScope               String                   @default("problem")
  workspaceScope            String                   @default("campus")
  organizationId            String?
  trainingSessionId         String?
  trainingSessionProblemId  String?
  trainingRoundId           String?
  trainingScoreGoalIndex    Int?
  trainingScoreGoalSnapshot Json?
  assignmentId              String?
  assignmentProblemId       String?
  assignmentRecipientId     String?
  submissionPhase           String?
  canonicalContestId        String?
  canonicalContestProblemId String?
  testSetSlot               ProblemTestSetSlotKind?
  testSetFencingToken       Int?
  testSetGraphHash          String?
  judgeConfigHash           String?
  judgeConfigSnapshot       String?                  @db.Text
  inputFilename             String?
  outputFilename            String?
  ioAdapterVersion          Int                      @default(1)
  currentJudgeRunId         String?                  @unique
  OjAccount                 OjAccount?               @relation(fields: [ojAccountId], references: [id])
  TrainingSession           TrainingSession?         @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)
  TrainingSessionProblem    TrainingSessionProblem?  @relation(fields: [trainingSessionProblemId], references: [id], onDelete: SetNull)
  TrainingRound             TrainingSessionRound?    @relation(fields: [trainingRoundId], references: [id], onDelete: SetNull)
  Assignment                Assignment?              @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  AssignmentProblem         AssignmentProblem?       @relation(fields: [assignmentProblemId], references: [id], onDelete: SetNull)
  AssignmentRecipient       AssignmentRecipient?     @relation(fields: [assignmentRecipientId], references: [id], onDelete: SetNull)
  Organization              Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  CanonicalContest          Contest?                 @relation("CanonicalContestSubmissions", fields: [canonicalContestId], references: [id], onDelete: Restrict)
  CanonicalContestProblem   ContestProblem?          @relation("CanonicalContestProblemSubmissions", fields: [canonicalContestProblemId], references: [id], onDelete: Restrict)
  User                      User                     @relation(fields: [userId], references: [id])
  JudgeRuns                 JudgeRun[]               @relation("SubmissionJudgeRuns")
  CurrentJudgeRun           JudgeRun?                @relation("SubmissionCurrentJudgeRun", fields: [currentJudgeRunId], references: [id], onDelete: SetNull)
  SolutionVerification      SolutionVerification?
  QualitySolutionProfiles   ProblemSolutionProfile[]
  BlogSubmissionSnapshots   BlogSubmissionSnapshot[]

  @@index([canonicalContestId])
  @@index([canonicalContestProblemId])
  @@index([createdAt])
  @@index([isGlobalVisible])
  @@index([language])
  @@index([oj])
  @@index([problemId])
  @@index([sourceId])
  @@index([submitScope])
  @@index([workspaceScope])
  @@index([organizationId, workspaceScope, createdAt])
  @@index([workspaceScope, userId, createdAt])
  @@index([submitSource])
  @@index([trainingSessionId])
  @@index([trainingSessionProblemId])
  @@index([trainingRoundId])
  @@index([assignmentId, createdAt])
  @@index([assignmentProblemId, createdAt])
  @@index([assignmentRecipientId, createdAt])
  @@index([userId])
  @@index([userId, oj, problemId])
  @@index([testSetSlot])
}

model Team {
  id                        String                      @id
  name                      String
  avatar                    String?
  description               String?
  announcement              String?
  organizationId            String?
  scope                     String                      @default("campus")
  isPublic                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now())
  Contest                   Contest[]
  Organization              Organization?               @relation(fields: [organizationId], references: [id])
