  aggregation String                            @default("min")
  orderIndex  Int                               @default(0)
  Revision    ProblemTestSetRevision            @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  Subtask     ProblemTestSetRevisionSubtask     @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
