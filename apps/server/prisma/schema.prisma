  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
}

model TrainingAttachment {
  id                String          @id
  trainingProblemId String
  fileName          String
  fileUrl           String
  fileSize          Int
  uploadedBy        String
  uploadedAt        DateTime        @default(now())
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)

  @@index([trainingProblemId])
}

model TrainingParticipant {
  id         String   @id
  trainingId Int
  userId     String
  userType   String
  joinedAt   DateTime @default(now())
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, userType])
  @@index([trainingId])
  @@index([userId])
}

model TrainingProblem {
  id                        String                           @id
  trainingId                Int
  problemId                 String
  alias                     String?
  orderIndex                Int
  points                    Int?
  createdAt                 DateTime                         @default(now())
  dataVersion               String?
  snapshotCreatedAt         DateTime?
  statementSnapshot         String?
  titleSnapshot             String?
  statementsSnapshotJson    String?                          @db.Text
  timeLimitSnapshot         Int?
  memoryLimitSnapshot       Int?
  judgeConfigSnapshot       String?                          @db.Text
  testGraphRevisionSnapshot Int?
  testSetRevisionId         String?
  allowedLanguagesSnapshot  String?
  sourcePlatformSnapshot    String?
  sourceProblemIdSnapshot   String?
  sourceUrlSnapshot         String?
  ContestUserProblemStatus  ContestUserProblemStatus[]
  TrainingAttachment        TrainingAttachment[]
  Problem                   Problem                          @relation(fields: [problemId], references: [id])
  TestSetRevision           ProblemTestSetRevision?          @relation(fields: [testSetRevisionId], references: [id], onDelete: SetNull)
  Training                  Training                         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  TrainingSolution          TrainingSolution?
  ContentSnapshot           TrainingProblemContentSnapshot[]
  StatementSet              TrainingProblemStatementSet[]
  TrainingUserProblemStatus TrainingUserProblemStatus[]

  @@unique([trainingId, alias])
  @@unique([trainingId, orderIndex])
  @@index([problemId])
  @@index([trainingId])
  @@index([testSetRevisionId])
}

model TrainingProblemStatementSet {
  id                String                             @id
  trainingProblemId String
  revision          Int
  selectedBy        String
  selectedAt        DateTime                           @default(now())
  TrainingProblem   TrainingProblem                    @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
  Snapshot          TrainingProblemStatementSnapshot[]

  @@unique([trainingProblemId, revision])
  @@index([trainingProblemId, revision])
}

model TrainingProblemStatementSnapshot {
  id                     String                      @id
  statementSetId         String
  sourceType             String
  sourceContentId        String?
  name                   String
  title                  String?
  language               String?
  format                 String
  content                String?                     @db.Text
  snapshotFileId         String?
  fileName               String?
  authorUserId           String?
  authorUsernameSnapshot String?
  isDefault              Boolean                     @default(false)
  orderIndex             Int
  StatementSet           TrainingProblemStatementSet @relation(fields: [statementSetId], references: [id], onDelete: Cascade)

  @@unique([statementSetId, orderIndex])
  @@index([statementSetId, isDefault])
  @@index([sourceContentId])
}

model TrainingProblemContentSnapshot {
  id                     String          @id
  trainingProblemId      String
  kind                   String
  revision               Int
  sourceType             String
  sourceContentId        String?
  sourceRevision         Int?
  format                 String
  language               String?
  title                  String?
  content                String?         @db.Text
  snapshotFileId         String?
  fileName               String?
  authorUserId           String?
  authorUsernameSnapshot String?
  selectedBy             String
  selectedAt             DateTime        @default(now())
  TrainingProblem        TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)

  @@unique([trainingProblemId, kind, revision])
  @@index([trainingProblemId, kind, revision])
  @@index([sourceContentId])
}

model TrainingSolution {
  id                String          @id
  trainingProblemId String          @unique
  content           String
  visible           Boolean         @default(false)
  createdBy         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now())
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
}

model TrainingUserProblemStatus {
  id                String          @id
  trainingId        Int
  userId            String
  trainingProblemId String
  bestScore         Int?
  bestResult        String?
  attemptCount      Int             @default(0)
  acAt              DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now())
  Training          Training        @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
  User              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, trainingProblemId])
  @@index([trainingId, userId])
  @@index([userId])
}

model User {
  id                        String                      @id
  username                  String                      @unique
  passwordHash              String
  // 平台角色仅表达平台级权限；校园身份由 OrganizationMembership 决定。
  role                      String                      @default("user")
  status                    String                      @default("active")
  avatar                    String?
  phone                     String?
  email                     String?
  bio                       String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now())
  PersonalProfile           PersonalProfile?
  Problem                   Problem[]                   @relation("ProblemOwner")
  ProblemHackAttempt        ProblemHackAttempt[]
  ContestUserProblemStatus  ContestUserProblemStatus[]
  Submission                Submission[]
  TeamJoinRequest           TeamJoinRequest[]
  TeamMember                TeamMember[]
  TrainingUserProblemStatus TrainingUserProblemStatus[]
  UserArchivedProblem       UserArchivedProblem[]
  UserPlatformBinding       UserPlatformBinding[]
  UserNotification          UserNotification[]
  UserProblemContent        UserProblemContent[]
  OrganizationMembership    OrganizationMembership[]
  CaritsAccount             CaritsAccount?              @relation("CaritsAccountUser")
  CaritsTransactions        CaritsTransaction[]         @relation("CaritsTransactionOperator")
  ContributionEvents        ContributionEvent[]         @relation("ContributionActor")

  @@index([createdAt])
  @@index([role])
  @@index([status])
}

model UserNotification {
  id         String    @id
  userId     String
  scope      String
  type       String
  title      String
  body       String
  href       String?
  sourceType String
  sourceId   String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  User       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, sourceType, sourceId])
  @@index([userId, scope, readAt, createdAt])
  @@index([userId, scope, createdAt])
}

model UserArchivedProblem {
  id          String    @id
  userId      String
  platform    String
  problemId   String
  title       String?
  difficulty  String?
  tags        String?
  solvedAt    DateTime?
  sourceUrl   String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  ojRemoteId  String?
  result      String?
  submittedAt DateTime?
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, problemId])
  @@index([platform])
  @@index([userId])
  @@index([userId, platform])
}

model UserPlatformBinding {
  id               String    @id
  userId           String
  platform         String
  platformUsername String?
  bindingStatus    String    @default("unbound")
  bindingData      String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  platformConfig   String?
  platformUid      String?
  statusMessage    String?
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([platform])
  @@index([userId])
}

model UserStatusLog {
  id           String   @id
  operatorRole String
  oldStatus    String
  newStatus    String
  reason       String?
  createdAt    DateTime @default(now())
  operatorId   String
  targetId     String
}

model carits_sequence {
  id     Int @id @default(1)
  nextId Int @default(1000)
}
