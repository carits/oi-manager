generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model AiUsageLog {
  id          String   @id
  userId      String
  problemId   String
  action      String
  sourceLang  String?
  targetLang  String?
  model       String?
  tokensUsed  Int      @default(0)
  status      String   @default("success")
  message     String?
  createdAt   DateTime @default(now())
  statementId String?

  @@index([userId, createdAt])
  @@index([userId, problemId, action, createdAt])
}

model Contest {
  id                  String                @id
  title               String
  description         String?
  contestDate         DateTime
  status              String                @default("upcoming")
  type                String                @default("mock")
  teamId              String?
  countRating         Boolean               @default(false)
  scope               String                @default("public")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  Team                Team?                 @relation(fields: [teamId], references: [id])
  ContestProblem      ContestProblem[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]
  ContestResult       ContestResult[]

  @@index([contestDate])
  @@index([scope])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
}

model ContestProblem {
  id                  String                @id
  contestId           String
  orderIndex          Int
  title               String?
  description         String?
  ojName              String?
  problemId           String?
  isCustom            Boolean               @default(false)
  difficulty          String?
  points              Int?
  statementType       String                @default("none")
  statementMarkdown   String?
  solutionType        String                @default("none")
  solutionMarkdown    String?
  solutionVisible     Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  Contest             Contest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]

  @@unique([contestId, orderIndex])
}

model ContestProblemScore {
  id             String         @id
  contestId      String
  problemId      String
  studentProfileId String
  studentNameSnapshot String
  usernameSnapshot String
  score          Float?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
  Contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  OrganizationStudentProfile OrganizationStudentProfile @relation("ContestProblemScoreStudentProfile", fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([contestId, problemId, studentProfileId])
  @@index([studentProfileId])
}

model ContestRecord {
  id         String   @id
  trainingId Int
  userId     String
  userType   String
  content    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, userType])
  @@index([updatedAt])
  @@index([userId])
}

model ContestResource {
  id               String          @id
  contestId        String
  contestProblemId String?
  fileName         String
  fileType         String
  fileFormat       String          @default("pdf")
  fileUrl          String
  visibleRoles     String          @default("all")
  uploadedBy       String
  uploadedAt       DateTime        @default(now())
  Contest          Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem   ContestProblem? @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
}

model ContestResult {
  id           String   @id
  contestId    String
  studentProfileId String
  studentNameSnapshot String
  usernameSnapshot String
  rank         Int?
  score        Float?
  ratingBefore Int
  ratingAfter  Int
  ratingChange Int
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  Contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  OrganizationStudentProfile OrganizationStudentProfile @relation("ContestResultStudentProfile", fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([contestId, studentProfileId])
  @@index([createdAt])
  @@index([studentProfileId])
}

model ContestUserProblemStatus {
  id               String          @id
  contestId        Int
  userId           String
  contestProblemId String
  bestScore        Int?
  bestResult       String?
  attemptCount     Int             @default(0)
  acAt             DateTime?
  frozenScore      Int?
  frozenResult     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now())
  Training         Training        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  TrainingProblem  TrainingProblem @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
  User             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId, contestProblemId])
  @@index([contestId, userId])
  @@index([userId])
}

model File {
  id           String    @id
  storageType  String    @default("local")
  disk         String    @default("default")
  relativePath String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  md5Hash      String?
  sha256Hash   String?
  accessLevel  String    @default("private")
  isPublic     Boolean   @default(false)
  ownerType    String
  ownerId      String
  category     String
  status       String    @default("active")
  deletedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@index([category])
  @@index([md5Hash])
  @@index([ownerType, ownerId])
  @@index([status, deletedAt])
  @@index([storageType, disk])
}

model LoginLog {
  id            String   @id
  userId        String?
  username      String
  loginRole     String
  userRole      String?
  result        String
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([result])
  @@index([username])
}

model Milestone {
  id            String   @id
  studentMembershipId String
  teacherMembershipId String
  studentNameSnapshot String
  teacherNameSnapshot String
  title         String
  description   String?
  milestoneDate DateTime
  type          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  StudentMembership OrganizationMembership @relation("MilestoneStudentMembership", fields: [studentMembershipId], references: [id], onDelete: Restrict)
  TeacherMembership OrganizationMembership @relation("MilestoneTeacherMembership", fields: [teacherMembershipId], references: [id], onDelete: Restrict)

  @@index([milestoneDate])
  @@index([studentMembershipId])
  @@index([teacherMembershipId])
}

model OjAccount {
  id                          String       @id
  platform                    String
  username                    String
  password                    String?
  passwordIV                  String?
  cookie                      String?
  cookieRaw                   String?
  status                      String       @default("unverified")
  lastVerifiedAt              DateTime?
  lastErrorMessage            String?
  loginMethod                 String       @default("cookie")
  addedBy                     String
  lastLoginAt                 DateTime?
  lastLoginFailureAt          DateTime?
  lastSubmitAt                DateTime?
  lastRateLimitAt             DateTime?
  consecutiveFailures         Int          @default(0)
  rateLimitCount              Int          @default(0)
  totalSubmissions            Int          @default(0)
  totalSubmissionErrors       Int          @default(0)
  enabled                     Boolean      @default(true)
  priority                    Int          @default(0)
  maxConsecutiveFailures      Int          @default(3)
  freezeDurationMinutes       Int          @default(30)
  submitMaxRetries            Int          @default(1)
  retryIntervalSeconds        Int          @default(10)
  minSubmitIntervalSeconds    Int          @default(30)
  minRequestIntervalSeconds   Int          @default(3)
  maxConcurrentSubmissions    Int          @default(1)
  maxConcurrentRequests       Int          @default(2)
  loginFailureCooldownMinutes Int          @default(15)
  cookieValidMinutes          Int          @default(3600)
  renewLoginThresholdMinutes  Int          @default(10)
  reverifyIntervalMinutes     Int          @default(30)
  autoVerifyIntervalMinutes   Int          @default(1440)
  firstPollDelaySeconds       Int          @default(5)
  pollIntervalSeconds         Int          @default(5)
  maxWaitDurationMinutes      Int          @default(10)
  rateLimitThreshold          Int          @default(2)
  banSuspicionCooldownHours   Int          @default(6)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @default(now())
  Submission                  Submission[]

  @@unique([platform, username])
  @@index([platform])
  @@index([status])
}

model OjFetchJob {
  id               String   @id
  platform         String
  problemId        String
  status           String   @default("pending")
  message          String?
  hasAttachment    Boolean  @default(false)
  attachmentStatus String?
  createdProblemId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@unique([platform, problemId])
  @@index([createdAt])
  @@index([status])
}

model OjPlatformConfig {
  id         String    @id
  platform   String    @unique
  cookies    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
}

model PasswordResetLog {
  id           String   @id
  operatorRole String
  resetMethod  String
  result       String
  message      String?
  createdAt    DateTime @default(now())
  operatorId   String
  targetId     String
}

model PrincipalTransferLog {
  id                    String   @id
  organizationId        String
  oldPrincipalMembershipId String?
  newPrincipalMembershipId String
  oldPrincipalNameSnapshot String?
  newPrincipalNameSnapshot String
  result                String
  message               String?
  createdAt             DateTime @default(now())
  operatorId            String
  Organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  OldPrincipalMembership OrganizationMembership? @relation("FormerPrincipalMembership", fields: [oldPrincipalMembershipId], references: [id], onDelete: Restrict)
  NewPrincipalMembership OrganizationMembership @relation("NewPrincipalMembership", fields: [newPrincipalMembershipId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([oldPrincipalMembershipId])
  @@index([newPrincipalMembershipId])
}

model Problem {
  id                String              @id
  platform          String
  problemId         String
  title             String
  description       String?
  statementType     String              @default("none")
  statementPdfUrl   String?
  solutionType      String              @default("none")
  solutionMarkdown  String?
  solutionPdfUrl    String?
  solutionVisible   Boolean             @default(false)
  difficulty        String?
  timeLimit         Int?
  memoryLimit       Int?
  judgeConfig       String?
  problemType       String              @default("default")
  visibility        String              @default("private")
  ownerType         String              @default("teacher")
  ownerId           String
  libraryScope      String              @default("platform")
  libraryKey        String              @default("platform")
  organizationId    String?
  sourceProblemId   String?
  status            String              @default("draft")
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now())
  testGraphRevision Int                 @default(0)
  allowedLanguages  String?
  ojBindings        String?
  ProblemAttachment ProblemAttachment[]
  ProblemListEntry  ProblemListEntry[]
  ProblemNote       ProblemNote[]
  ProblemStatement  ProblemStatement[]
  UserProblemContent UserProblemContent[]
  TestdataFile      TestdataFile[]
  ProblemChecker    ProblemChecker[]
  ProblemHackConfig ProblemHackConfig?
  ProblemHackAttempt ProblemHackAttempt[]
  ProblemTestcase   ProblemTestcase[]
  ProblemSubtask    ProblemSubtask[]
  ProblemTestGroup  ProblemTestGroup[]
  TrainingProblem   TrainingProblem[]
  Owner             User                @relation("ProblemOwner", fields: [ownerId], references: [id])
  Organization       Organization?        @relation(fields: [organizationId], references: [id])
  SourceProblem     Problem?            @relation("ProblemCopies", fields: [sourceProblemId], references: [id], onDelete: SetNull)
  CopiedProblems    Problem[]           @relation("ProblemCopies")

  @@unique([libraryKey, platform, problemId])
  @@index([createdAt])
  @@index([libraryScope, status])
  @@index([ownerId, ownerType])
  @@index([organizationId, status])
  @@index([sourceProblemId])
  @@index([visibility])
  @@index([visibility, status])
}

model ProblemHackConfig {
  id              String   @id
  problemId       String   @unique
  enabled         Boolean  @default(false)
  mode            String   @default("acm")
  standardSource  String   @db.Text
  standardLanguage String  @default("cpp17")
  validatorSource String   @db.Text
  validatorLanguage String @default("cpp17")
  classifierSource String   @default("") @db.Text
  classifierLanguage String @default("cpp17")
  revision        Int      @default(1)
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Problem         Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([updatedBy])
}

model ProblemHackAttempt {
  id                    String   @id
  problemId             String
  userId                String
  status                String   @default("queuing")
  inputMode             String
  inputData             String?  @db.Text
  generatorSource       String?  @db.Text
  generatorLanguage     String?
  hackSource            String   @db.Text
  hackLanguage          String
  hackConfigRevision    Int
  judgeConfigHash       String
  baselineResult        String?
  baselineScore         Int?
  candidateResult       String?
  candidateScore        Int?
  scoreDelta            Int?
  affectedSubtaskIds    String?
  acceptedTestcaseId    String?
  testGraphRevision     Int      @default(0)
  failureStage          String?
  message               String?  @db.Text
  inputSha256           String?
  outputSha256          String?
  acceptedInputFile     String?
  acceptedOutputFile    String?
  judgeId               String?
  judgeStarted          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  finishedAt            DateTime?
  Problem               Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  User                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([problemId, status, createdAt])
  @@index([status, judgeId])
  @@index([userId, problemId, createdAt])
}

model ProblemAttachment {
  id          String   @id
  problemId   String
  fileName    String
  fileSize    Int
  fileUrl     String
  description String?
  uploadedAt  DateTime @default(now())
  Problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model ProblemChecker {
  id         String   @id
  problemId  String
  fileName   String
  fileSize   Int
  fileUrl    String
  language   String?
  uploadedAt DateTime @default(now())
  Problem    Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  @@unique([problemId, fileName])
  @@index([problemId])
}

model ProblemList {
  id                 String               @id
  title              String
  description        String?
  coverUrl           String?
  organizationId      String?
  ownerId            String
  ownerType          String               @default("teacher")
  scope              String               @default("campus")
  visibility         String               @default("private")
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  ProblemListSection ProblemListSection[]
  ProblemListShare   ProblemListShare[]
  SchoolProblemList  SchoolProblemList[]
  TeamProblemList    TeamProblemList[]
  Organization       Organization? @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
  @@index([ownerId, ownerType])
  @@index([organizationId])
  @@index([scope])
  @@index([scope, ownerId])
  @@index([visibility])
}

model PersonalProfile {
  userId    String   @id
  rating    Int      @default(1200)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
}

model ProblemListEntry {
  id                 String             @id
  sectionId          String
  problemId          String
  sortOrder          Int                @default(0)
  alias              String?
  notes              String?
  ojName             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now())
  Problem            Problem            @relation(fields: [problemId], references: [id])
  ProblemListSection ProblemListSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, problemId])
  @@index([problemId])
  @@index([sectionId])
}

model ProblemListSection {
  id               String             @id
  problemListId    String
  title            String
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now())
  ProblemListEntry ProblemListEntry[]
  ProblemList      ProblemList        @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@index([problemListId])
}

model ProblemListShare {
  id            String      @id
  problemListId String
  targetType    String
  targetId      String
  permission    String      @default("view")
  sharedBy      String
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@unique([problemListId, targetType, targetId])
  @@index([sharedBy])
  @@index([targetType, targetId])
}

model ProblemNote {
  id        String   @id
  problemId String
  userId    String
  userType  String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId, userType])
  @@index([updatedAt])
  @@index([userId])
}

model ProblemStatement {
  id        String   @id
  problemId String
  type      String
  format    String
  language  String?
  content   String?
  fileUrl   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, type, format, language])
  @@index([problemId, type])
}

model UserProblemContent {
  id                   String   @id
  problemId            String
  userId               String
  kind                 String
  name                 String?
  nameKey              String?
  title                String?
  format               String
  language             String?
  content              String?  @db.Text
  fileId               String?
  visibility           String   @default("private")
  sourceType           String   @default("blank")
  sourceId             String?
  sourceNameSnapshot   String?
  sourceAuthorSnapshot String?
  revision             Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?
  Problem              Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  User                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([problemId, kind, visibility, deletedAt])
  @@index([problemId, userId, kind, nameKey])
  @@index([userId, updatedAt])
}

model School {
  id                                                String                 @id
  name                                              String
  shortName                                         String?
  description                                       String?
  announcement                                      String?
  region                                            String?
  schoolType                                        String?
  schoolNature                                      String?
  educationSystem                                   String?                @default("6-3-3")
  educationSystemDetail                             Json?
  informaticsEnabled                                Boolean                @default(false)
  informaticsStages                                 Json?
  informaticsContests                               Json?
  informaticsTracks                                 Json?
  contactPerson                                     String?
  contactPhone                                      String?
  contactEmail                                      String?
  status                                            String                 @default("active")
  currentPrincipalMembershipId                       String?                @unique
  createdAt                                         DateTime               @default(now())
  updatedAt                                         DateTime               @default(now())
  organizationId                                    String?                @unique
  Organization                                      Organization?          @relation(fields: [organizationId], references: [id])
}

model Organization {
  id          String                   @id
  name        String
  type        String                   @default("school")
  status      String                   @default("active")
  description String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  School      School?
  Membership  OrganizationMembership[]
  CaritsAccount CaritsAccount? @relation("CaritsAccountOrganization")
  CaritsTransactions CaritsTransaction[] @relation("CaritsTransactionOrganization")
  ContributionAttributions OrganizationContributionAttribution[]
  ContributionProjects ContributionProject[]
  PrincipalTransferLog PrincipalTransferLog[]
  Problem Problem[]
  ProblemList ProblemList[]
  SchoolProblemList SchoolProblemList[]
  Team Team[]
  Training Training[]
  Submission Submission[]

  @@index([type, status])
}

model OrganizationMembership {
  id             String       @id
  organizationId String
  userId         String
  memberRole     String
  relationType   String
  status         String       @default("active")
  invitedBy      String?
  joinedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  User           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  StudentProfile OrganizationStudentProfile?
  TeacherProfile OrganizationTeacherProfile?
  StudentMilestones Milestone[] @relation("MilestoneStudentMembership")
  TeacherMilestones Milestone[] @relation("MilestoneTeacherMembership")
  FormerPrincipalTransfers PrincipalTransferLog[] @relation("FormerPrincipalMembership")
  NewPrincipalTransfers PrincipalTransferLog[] @relation("NewPrincipalMembership")

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model OrganizationStudentProfile {
  id                      String                 @id
  membershipId            String                 @unique
  name                    String
  gender                  String?
  enrollmentYear          Int?
  targetContest           String?
  headTeacherMembershipId String?
  tags                    String?
  notes                   String?
  avatar                  String?
  rating                  Int                    @default(1200)
  status                  String                 @default("active")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  Membership              OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  ContestProblemScores ContestProblemScore[] @relation("ContestProblemScoreStudentProfile")
  ContestResults ContestResult[] @relation("ContestResultStudentProfile")
  ExternalAccounts TeamMemberExternalAccount[] @relation("ExternalAccountStudentProfile")

  @@index([headTeacherMembershipId])
  @@index([status])
}

model OrganizationTeacherProfile {
  id           String                 @id
  membershipId String                 @unique
  name         String
  email        String?
  phone        String?
  avatar       String?
  bio          String?
  title        String?
  status       String                 @default("active")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  Membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([status])
}

enum CaritsAccountOwnerType {
  USER
  ORGANIZATION
  SYSTEM
}

model CaritsAccount {
  id             String                  @id
  ownerType      CaritsAccountOwnerType
  userId         String?                 @unique
  organizationId String?                 @unique
  systemKey      String?                 @unique
  balance        BigInt                  @default(0)
  status         String                  @default("active")
  version        Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  User           User?                   @relation("CaritsAccountUser", fields: [userId], references: [id], onDelete: Restrict)
  Organization   Organization?           @relation("CaritsAccountOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  LedgerEntries  CaritsLedgerEntry[]

  @@index([ownerType, status])
}

model CaritsTransaction {
  id             String                  @id
  type           String
  status         String                  @default("draft")
  idempotencyKey String                  @unique
  referenceType  String?
  referenceId    String?
  operatorUserId String?
  organizationId String?
  metadata       Json?
  createdAt      DateTime                @default(now())
  postedAt       DateTime?
  Operator       User?                   @relation("CaritsTransactionOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  Organization   Organization?           @relation("CaritsTransactionOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  Entries        CaritsLedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([organizationId, createdAt])
}

model CaritsLedgerEntry {
  id             String             @id
  transactionId  String
  accountId      String
  amount         BigInt
  balanceAfter   BigInt
  createdAt      DateTime           @default(now())
  Transaction    CaritsTransaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  Account        CaritsAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
}

model ContributionEvent {
  id            String    @id
  actorUserId   String
  type          String
  sourceType    String
  sourceId      String
  score         Int
  ruleCode      String
  ruleVersion   Int
  dedupeKey     String    @unique
  status        String    @default("pending")
  evidence      Json?
  occurredAt    DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime  @default(now())
  Actor         User      @relation("ContributionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  Attribution   OrganizationContributionAttribution?

  @@index([actorUserId, status, acceptedAt])
  @@index([sourceType, sourceId])
  @@index([status, acceptedAt])
}

model OrganizationContributionAttribution {
  id             String             @id
  contributionId String             @unique
  organizationId String
  reason         String
  evidence       Json?
  createdAt      DateTime           @default(now())
  Contribution   ContributionEvent  @relation(fields: [contributionId], references: [id], onDelete: Restrict)
  Organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

model ContributionProject {
  id             String       @id
  organizationId String
  name           String
  description    String?
  resourceType   String?
  resourceId     String?
  status         String       @default("active")
  createdByMembershipId String
  createdAt      DateTime     @default(now())
  archivedAt     DateTime?
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
}


model SchoolProblemList {
  id            String      @id
  organizationId String
  problemListId String
  addedBy       String
  addedByRole   String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, problemListId])
  @@index([addedBy])
  @@index([problemListId])
  @@index([organizationId])
}


model Submission {
  id                Int        @id @default(autoincrement())
  userId            String
  oj                String
  problemId         String
  language          String
  code              String
  codeLength        Int
  result            String     @default("queuing")
  timeUsed          Int?
  wallTimeUsed      Int?
  memoryUsed        Int?
  timeoutReason     String?
  metricSource      String?
  submitMethod      String
  ojAccountId       String?
  ojRemoteId        String?
  errorMessage      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now())
  problemInternalId String?
  cases             String?
  score             Int?
  subtasks          String?
  isGlobalVisible   Boolean    @default(true)
  sourceId          String?
  submitSource      String?
  judgeId           String?
  judgeStarted      DateTime?
  submitScope       String     @default("problem")
  workspaceScope    String     @default("campus")
  organizationId    String?
  trainingId        Int?
  trainingProblemId String?
  contestId         Int?
  contestProblemId  String?
  OjAccount         OjAccount? @relation(fields: [ojAccountId], references: [id])
  Training          Training?  @relation(fields: [trainingId], references: [id])
  Organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  User              User       @relation(fields: [userId], references: [id])

  @@index([contestId])
  @@index([createdAt])
  @@index([createdAt, result])
  @@index([isGlobalVisible])
  @@index([language])
  @@index([oj])
  @@index([problemId])
  @@index([result])
  @@index([result, judgeId])
  @@index([sourceId])
  @@index([submitScope, contestId])
  @@index([submitScope])
  @@index([workspaceScope])
  @@index([organizationId, workspaceScope, createdAt])
  @@index([workspaceScope, userId, createdAt])
  @@index([submitScope, trainingId])
  @@index([submitSource])
  @@index([trainingId])
  @@index([trainingProblemId])
  @@index([userId, contestId])
  @@index([userId])
  @@index([userId, oj, problemId])
  @@index([userId, trainingId])
  @@index([userId, trainingProblemId])
}


model Team {
  id                        String                      @id
  name                      String
  avatar                    String?
  description               String?
  announcement              String?
  organizationId            String?
  scope                     String                      @default("campus")
  isPublic                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now())
  Contest                   Contest[]
  Organization               Organization?               @relation(fields: [organizationId], references: [id])
  TeamJoinRequest           TeamJoinRequest[]
  TeamMember                TeamMember[]
  TeamMemberExternalAccount TeamMemberExternalAccount[]
  TeamMemberImportBatch     TeamMemberImportBatch[]
  TeamProblemList           TeamProblemList[]
  Training                  Training[]

  @@index([createdAt])
  @@index([isPublic])
  @@index([scope])
  @@index([scope, isPublic])
  @@index([organizationId])
}

model TeamJoinRequest {
  id          String    @id
  teamId      String
  userId      String
  status      String    @default("pending")
  message     String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  processedBy String?
  Team        Team      @relation(fields: [teamId], references: [id])
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamMember {
  id        String   @id
  teamId    String
  userId    String
  userType  String
  role      String
  status    String   @default("active")
  joinedAt  DateTime @default(now())
  invitedBy String?
  Team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, userType])
  @@index([status])
  @@index([teamId, role])
  @@index([teamId, status, role])
  @@index([userId, userType, status])
}

model TeamMemberExternalAccount {
  id               String   @id
  teamId           String
  studentProfileId String?
  studentNameSnapshot String?
  platform         String
  platformUsername String
  displayName      String?
  status           String   @default("pending")
  inviteId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  OrganizationStudentProfile OrganizationStudentProfile? @relation("ExternalAccountStudentProfile", fields: [studentProfileId], references: [id], onDelete: Restrict)
  Team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, platform, platformUsername])
  @@index([platform, platformUsername])
  @@index([studentProfileId])
}

model TeamMemberImportBatch {
  id                   String                 @id
  teamId               String?
  operatorId           String
  platform             String
  totalCount           Int
  successCount         Int                    @default(0)
  skipCount            Int                    @default(0)
  errorCount           Int                    @default(0)
  status               String                 @default("pending")
  rawInput             String?
  createdAt            DateTime               @default(now())
  completedAt          DateTime?
  Team                 Team?                  @relation(fields: [teamId], references: [id])
  TeamMemberImportItem TeamMemberImportItem[]

  @@index([operatorId])
  @@index([teamId])
}

model TeamMemberImportItem {
  id                    String                @id
  batchId               String
  lineNumber            Int
  rawUsername           String
  rawStudentName        String?
  parsedUsername        String?
  candidateDisplayName  String?
  matchType             String
  matchStatus           String                @default("pending")
  matchedStudentProfileId String?
  matchedStudentName    String?
  createdStudentProfileId String?
  action                String?
  userChoice            String?
  errorMessage          String?
  createdAt             DateTime              @default(now())
  processedAt           DateTime?
  TeamMemberImportBatch TeamMemberImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([matchType])
  @@index([matchedStudentProfileId])
  @@index([createdStudentProfileId])
}

model TeamOperationLog {
  id           String   @id
  teamId       String
  operatorId   String
  operatorType String
  action       String
  targetId     String?
  targetType   String?
  oldValue     String?
  newValue     String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([operatorId])
  @@index([teamId])
}

model TeamProblemList {
  id            String      @id
  teamId        String
  problemListId String
  addedBy       String
  addedByRole   String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  Team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, problemListId])
  @@index([addedBy])
  @@index([problemListId])
  @@index([teamId])
}

model TestdataFile {
  id         String   @id
  problemId  String
  filename   String
  size       Int
  md5        String?
  sha256     String?
  uploadedAt DateTime @default(now())
  Problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  InputForTestcase  ProblemTestcase[] @relation("ProblemTestcaseInput")
  OutputForTestcase ProblemTestcase[] @relation("ProblemTestcaseOutput")

  @@unique([problemId, filename])
  @@index([problemId])
}

model ProblemTestcase {
  id             String   @id
  problemId      String
  inputFileId    String
  outputFileId   String
  source         String   @default("official")
  hackerId       String?
  hackAttemptId  String?
  inputSha256    String?
  outputSha256   String?
  enabled        Boolean  @default(true)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  Problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  InputFile      TestdataFile @relation("ProblemTestcaseInput", fields: [inputFileId], references: [id], onDelete: Restrict)
  OutputFile     TestdataFile @relation("ProblemTestcaseOutput", fields: [outputFileId], references: [id], onDelete: Restrict)
  GroupLinks     ProblemTestcaseGroup[]

  @@unique([problemId, inputFileId, outputFileId])
  @@index([problemId, source, enabled])
  @@index([hackAttemptId])
}

model ProblemSubtask {
  id           String   @id
  problemId    String
  subtaskId    Int
  score        Int
  orderIndex   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Groups       ProblemTestGroup[]
  Dependencies ProblemSubtaskDependency[] @relation("SubtaskDependencySource")
  RequiredBy   ProblemSubtaskDependency[] @relation("SubtaskDependencyTarget")

  @@unique([problemId, subtaskId])
  @@index([problemId, orderIndex])
}

model ProblemSubtaskDependency {
  id          String @id
  subtaskId   String
  dependsOnId String
  Subtask     ProblemSubtask @relation("SubtaskDependencySource", fields: [subtaskId], references: [id], onDelete: Cascade)
  DependsOn   ProblemSubtask @relation("SubtaskDependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([subtaskId, dependsOnId])
  @@index([dependsOnId])
}

model ProblemTestGroup {
  id          String   @id
  problemId   String
  subtaskId   String
  key         String
  name        String
  kind        String
  score       Int      @default(0)
  aggregation String   @default("min")
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Subtask     ProblemSubtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  Testcases   ProblemTestcaseGroup[]

  @@unique([subtaskId, key])
  @@index([problemId, kind])
}

model ProblemTestcaseGroup {
  id         String @id
  testcaseId String
  groupId    String
  orderIndex Int    @default(0)
  score      Int?
  time       String?
  memory     String?
  Testcase   ProblemTestcase @relation(fields: [testcaseId], references: [id], onDelete: Cascade)
  Group      ProblemTestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([testcaseId, groupId])
  @@index([groupId, orderIndex])
}

model Training {
  id                        Int                         @id @default(autoincrement())
  teamId                    String?
  title                     String
  description               String?
  format                    String                      @default("ioi")
  startTime                 DateTime
  endTime                   DateTime
  status                    String                      @default("upcoming")
  createdBy                 String
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now())
  includeAdminInRanking     Boolean                     @default(false)
  problemIdVisible          Boolean                     @default(false)
  solutionVisible           Boolean                     @default(false)
  type                      String                      @default("training")
  scope                     String                      @default("campus")
  organizationId            String?
  sourceTrainingId          Int?
  ContestRecord             ContestRecord[]
  ContestUserProblemStatus  ContestUserProblemStatus[]
  Submission                Submission[]
  Organization               Organization?               @relation(fields: [organizationId], references: [id])
  Team                      Team?                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  TrainingParticipant       TrainingParticipant[]
  TrainingProblem           TrainingProblem[]
  TrainingUserProblemStatus TrainingUserProblemStatus[]

  @@index([organizationId])
  @@index([scope])
  @@index([scope, status])
  @@index([startTime])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
}

model TrainingAttachment {
  id                String          @id
  trainingProblemId String
  fileName          String
  fileUrl           String
  fileSize          Int
  uploadedBy        String
  uploadedAt        DateTime        @default(now())
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)

  @@index([trainingProblemId])
}

model TrainingParticipant {
  id         String   @id
  trainingId Int
  userId     String
  userType   String
  joinedAt   DateTime @default(now())
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, userType])
  @@index([trainingId])
  @@index([userId])
}

model TrainingProblem {
  id                        String                      @id
  trainingId                Int
  problemId                 String
  alias                     String?
  orderIndex                Int
  points                    Int?
  createdAt                 DateTime                    @default(now())
  dataVersion               String?
  snapshotCreatedAt         DateTime?
  statementSnapshot         String?
  titleSnapshot             String?
  statementsSnapshotJson    String?                     @db.Text
  timeLimitSnapshot         Int?
  memoryLimitSnapshot       Int?
  judgeConfigSnapshot       String?                     @db.Text
  testGraphRevisionSnapshot Int?
  allowedLanguagesSnapshot  String?
  sourcePlatformSnapshot    String?
  sourceProblemIdSnapshot   String?
  sourceUrlSnapshot         String?
  ContestUserProblemStatus  ContestUserProblemStatus[]
  TrainingAttachment        TrainingAttachment[]
  Problem                   Problem                     @relation(fields: [problemId], references: [id])
  Training                  Training                    @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  TrainingSolution          TrainingSolution?
  ContentSnapshot           TrainingProblemContentSnapshot[]
  StatementSet              TrainingProblemStatementSet[]
  TrainingUserProblemStatus TrainingUserProblemStatus[]

  @@unique([trainingId, alias])
  @@unique([trainingId, orderIndex])
  @@index([problemId])
  @@index([trainingId])
}

model TrainingProblemStatementSet {
  id                String   @id
  trainingProblemId String
  revision          Int
  selectedBy        String
  selectedAt        DateTime @default(now())
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
  Snapshot          TrainingProblemStatementSnapshot[]

  @@unique([trainingProblemId, revision])
  @@index([trainingProblemId, revision])
}

model TrainingProblemStatementSnapshot {
  id                     String   @id
  statementSetId         String
  sourceType             String
  sourceContentId        String?
  name                   String
  title                  String?
  language               String?
  format                 String
  content                String?  @db.Text
  snapshotFileId         String?
  fileName               String?
  authorUserId           String?
  authorUsernameSnapshot String?
  isDefault              Boolean  @default(false)
  orderIndex             Int
  StatementSet           TrainingProblemStatementSet @relation(fields: [statementSetId], references: [id], onDelete: Cascade)

  @@unique([statementSetId, orderIndex])
  @@index([statementSetId, isDefault])
  @@index([sourceContentId])
}

model TrainingProblemContentSnapshot {
  id                     String          @id
  trainingProblemId      String
  kind                   String
  revision               Int
  sourceType             String
  sourceContentId        String?
  sourceRevision         Int?
  format                 String
  language               String?
  title                  String?
  content                String?         @db.Text
  snapshotFileId         String?
  fileName               String?
  authorUserId           String?
  authorUsernameSnapshot String?
  selectedBy             String
  selectedAt             DateTime        @default(now())
  TrainingProblem        TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)

  @@unique([trainingProblemId, kind, revision])
  @@index([trainingProblemId, kind, revision])
  @@index([sourceContentId])
}

model TrainingSolution {
  id                String          @id
  trainingProblemId String          @unique
  content           String
  visible           Boolean         @default(false)
  createdBy         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now())
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
}

model TrainingUserProblemStatus {
  id                String          @id
  trainingId        Int
  userId            String
  trainingProblemId String
  bestScore         Int?
  bestResult        String?
  attemptCount      Int             @default(0)
  acAt              DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now())
  Training          Training        @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
  User              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, trainingProblemId])
  @@index([trainingId, userId])
  @@index([userId])
}

model User {
  id                        String                      @id
  username                  String                      @unique
  passwordHash              String
  // 平台角色仅表达平台级权限；校园身份由 OrganizationMembership 决定。
  role                      String                    @default("user")
  status                    String                      @default("active")
  avatar                    String?
  phone                     String?
  email                     String?
  bio                       String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now())
  PersonalProfile           PersonalProfile?
  Problem                   Problem[]                   @relation("ProblemOwner")
  ProblemHackAttempt        ProblemHackAttempt[]
  ContestUserProblemStatus  ContestUserProblemStatus[]
  Submission                Submission[]
  TeamJoinRequest           TeamJoinRequest[]
  TeamMember                TeamMember[]
  TrainingUserProblemStatus TrainingUserProblemStatus[]
  UserArchivedProblem       UserArchivedProblem[]
  UserPlatformBinding       UserPlatformBinding[]
  UserNotification          UserNotification[]
  UserProblemContent        UserProblemContent[]
  OrganizationMembership    OrganizationMembership[]
  CaritsAccount             CaritsAccount?            @relation("CaritsAccountUser")
  CaritsTransactions        CaritsTransaction[]       @relation("CaritsTransactionOperator")
  ContributionEvents        ContributionEvent[]       @relation("ContributionActor")

  @@index([createdAt])
  @@index([role])
  @@index([status])
}

model UserNotification {
  id         String   @id
  userId     String
  scope      String
  type       String
  title      String
  body       String
  href       String?
  sourceType String
  sourceId   String
  readAt     DateTime?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, sourceType, sourceId])
  @@index([userId, scope, readAt, createdAt])
  @@index([userId, scope, createdAt])
}

model UserArchivedProblem {
  id          String    @id
  userId      String
  platform    String
  problemId   String
  title       String?
  difficulty  String?
  tags        String?
  solvedAt    DateTime?
  sourceUrl   String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  ojRemoteId  String?
  result      String?
  submittedAt DateTime?
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, problemId])
  @@index([platform])
  @@index([userId])
  @@index([userId, platform])
}

model UserPlatformBinding {
  id               String    @id
  userId           String
  platform         String
  platformUsername String?
  bindingStatus    String    @default("unbound")
  bindingData      String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  platformConfig   String?
  platformUid      String?
  statusMessage    String?
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([platform])
  @@index([userId])
}

model UserStatusLog {
  id           String   @id
  operatorRole String
  oldStatus    String
  newStatus    String
  reason       String?
  createdAt    DateTime @default(now())
  operatorId   String
  targetId     String
}

model carits_sequence {
  id     Int @id @default(1)
  nextId Int @default(1000)
}
