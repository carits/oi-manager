model Assignment {
  id                     String                           @id @default(uuid())
  organizationId         String
  teamId                 String?
  title                  String
  description            String?                          @db.Text
  learningObjectives     String?                          @db.Text
  status                 AssignmentStatus                 @default(DRAFT)
  rosterMode             AssignmentRosterMode             @default(SNAPSHOT)
  gradingPolicy          AssignmentGradingPolicy          @default(BEST_BEFORE_DUE)
  gradingVersion         Int                              @default(2)
  baseScoreMax           Int                              @default(100)
  optionalScoringPolicy  AssignmentOptionalScoringPolicy  @default(NONE)
  optionalBestCount      Int?
  optionalBonusMax       Int                              @default(0)
  challengeScoringPolicy AssignmentChallengeScoringPolicy @default(NONE)
  challengeBonusMax      Int                              @default(0)
  latePolicy             AssignmentLatePolicy             @default(DISALLOW)
  correctionPolicy       AssignmentCorrectionPolicy       @default(NONE)
  solutionReleasePolicy  AssignmentSolutionReleasePolicy  @default(AFTER_RELEASE)
  latePenaltyPercent     Int?
  publishAt              DateTime?
  openAt                 DateTime
  dueAt                  DateTime
  closeAt                DateTime
  correctionDueAt        DateTime?
  createdByMembershipId  String
  statusRevision         Int                              @default(0)
  eventSeq               Int                              @default(0)
  publishedAt            DateTime?
  closedAt               DateTime?
  releasedAt             DateTime?
  archivedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  Organization           Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  Team                   Team?                            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  CreatorMembership      OrganizationMembership           @relation("AssignmentCreatorMembership", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  Problems               AssignmentProblem[]
  Recipients             AssignmentRecipient[]
