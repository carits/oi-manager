  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  Blocker   User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  Blocked   User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model DirectConversation {
  id                 String                     @id
  userLowId          String
  userHighId         String
  lastMessageSeq     Int                        @default(0)
  lastMessagePreview String?
  lastMessageAt      DateTime?
  lastActivityAt     DateTime                   @default(now())
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @default(now()) @updatedAt
  LowUser            User                       @relation("DirectConversationLowUser", fields: [userLowId], references: [id], onDelete: Restrict)
  HighUser           User                       @relation("DirectConversationHighUser", fields: [userHighId], references: [id], onDelete: Restrict)
