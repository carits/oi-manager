  LIVE
  JUDGING
  FINALIZING
  FINALIZED
  HELD
  FAILED
}

enum StandingSnapshotStatus {
  BUILDING
  FINALIZED
  SUPERSEDED
}

enum RatingBatchStatus {
  PENDING
  CALCULATING
  READY
  APPLIED
  SKIPPED
  STALE
  RECALCULATING
  SUPERSEDED
  FAILED
}

model AiUsageLog {
  id               String   @id
  userId           String
  problemId        String
  action           String
  sourceLang       String?
  targetLang       String?
  model            String?
  tokensUsed       Int      @default(0)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  requestId        String?
  status           String   @default("success")
  message          String?
  createdAt        DateTime @default(now())
  statementId      String?

  @@index([userId, createdAt])
  @@index([userId, problemId, action, createdAt])
  @@index([requestId])
}

model AiTokenPool {
  id              String   @id
  availableTokens BigInt   @default(0)
  reservedTokens  BigInt   @default(0)
  consumedTokens  BigInt   @default(0)
  version         Int      @default(0)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiTokenLedgerEntry {
  id             String   @id
  poolId         String
  type           String
  amount         BigInt
  availableAfter BigInt
  reservedAfter  BigInt
  consumedAfter  BigInt
  idempotencyKey String   @unique
  requestId      String?
  operatorUserId String?
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([poolId, createdAt])
  @@index([requestId])
}

model AiGenerationRequest {
  id               String    @id
  userId           String
  problemId        String
  statementId      String?
  action           String
  model            String
  status           String    @default("queued")
  parentRequestId  String?
  repairDepth      Int       @default(0)
  reservedTokens   Int       @default(0)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  promptHash       String
  response         Json?
  errorCode        String?
  errorMessage     String?   @db.Text
  compileStatus    String?
  compileMessage   String?   @db.Text
  programVersionId String?
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  @@index([userId, createdAt])
  @@index([problemId, createdAt])
  @@index([status, createdAt])
  @@index([parentRequestId])
}

model Contest {
  id                    String                     @id
  publicId              Int                        @unique @default(autoincrement())
  createdBy             String?
  organizationId        String?
  title                 String
  description           String?
  contestDate           DateTime
  startAt               DateTime?
  endAt                 DateTime?
  format                String?
  statusRevision        Int                        @default(0)
  status                String                     @default("upcoming")
  type                  String                     @default("mock")
  teamId                String?
  countRating           Boolean                    @default(false)
  scope                 String                     @default("public")
  problemIdVisible      Boolean                    @default(false)
  solutionVisible       Boolean                    @default(false)
  includeAdminInRanking Boolean                    @default(false)
  finalizationStatus    ContestFinalizationStatus  @default(LIVE)
  finalizedStandingId   String?                    @unique
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @default(now())
  Team                  Team?                      @relation(fields: [teamId], references: [id])
  Organization          Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ContestProblem        ContestProblem[]
  ContestParticipant    ContestParticipant[]
  ContestProblemScore   ContestProblemScore[]
  ContestResource       ContestResource[]
  ContestResult         ContestResult[]
  ContestRecords        ContestRecord[]            @relation("CanonicalContestRecords")
  ContestStatuses       ContestUserProblemStatus[] @relation("CanonicalContestStatuses")
  Submissions           Submission[]               @relation("CanonicalContestSubmissions")
  RatingConfig          ContestRatingConfig?       @relation("CanonicalContestRatingConfig")
  StandingSnapshots     ContestStandingSnapshot[]  @relation("CanonicalContestStandingSnapshots")
  RatingBatches         RatingBatch[]              @relation("CanonicalContestRatingBatches")
  RejudgeBatches        RejudgeBatch[]
  BlogReferences        BlogReference[]
  DataPurchases         DataPurchase[]
  DataEntitlements      DataEntitlement[]
  FinalizedStanding     ContestStandingSnapshot?   @relation("ContestFinalizedStanding", fields: [finalizedStandingId], references: [id], onDelete: SetNull)

  @@index([contestDate])
  @@index([scope])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
  @@index([organizationId, status])
  @@index([createdBy])
  @@index([finalizationStatus])
}

model ContestParticipant {
  id                      String                       @id
  contestId               String
  userId                  String
  userType                String
  joinedAt                DateTime                     @default(now())
  organizationIdSnapshot  String?
  ratingStatus            RatingParticipantStatus      @default(REGISTERED)
  ratingDisposition       RatingParticipantDisposition @default(NORMAL)
  ratingDispositionReason String?
  ratingDispositionBy     String?
  ratingDispositionAt     DateTime?
  firstSubmissionAt       DateTime?
  ratingLockedAt          DateTime?
  Contest                 Contest                      @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId, userType])
  @@index([userId])
}

model ContestProblem {
  id                     String                     @id
  contestId              String
  canonicalProblemId     String?
  testSetSlot            ProblemTestSetSlotKind     @default(STABLE)
  testSetGraphHash       String?
  testSetJudgeConfigHash String?
  testSetFencingToken    Int?
  testSetReaderId        String?                    @unique
  orderIndex             Int
  alias                  String?
  title                  String?
  description            String?
  ojName                 String?
  problemId              String?
  isCustom               Boolean                    @default(false)
  difficulty             String?
  points                 Int?
  statementType          String                     @default("none")
  statementMarkdown      String?
  solutionType           String                     @default("none")
  solutionMarkdown       String?
  solutionVisible        Boolean                    @default(false)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @default(now())
  Contest                Contest                    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  CanonicalProblem       Problem?                   @relation("ContestCanonicalProblem", fields: [canonicalProblemId], references: [id], onDelete: Restrict)
  TestSetReader          ProblemTestSetReader?      @relation("ContestProblemTestSetReader", fields: [testSetReaderId], references: [id], onDelete: SetNull)
  ContestProblemScore    ContestProblemScore[]
  ContestResource        ContestResource[]
  ContestStatuses        ContestUserProblemStatus[] @relation("CanonicalContestProblemStatuses")
  Submissions            Submission[]               @relation("CanonicalContestProblemSubmissions")

  @@unique([contestId, orderIndex])
  @@index([canonicalProblemId])
}

model ContestProblemScore {
  id                         String                     @id
  contestId                  String
  problemId                  String
  studentProfileId           String
  studentNameSnapshot        String
  usernameSnapshot           String
  score                      Float?
  note                       String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @default(now())
  Contest                    Contest                    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem             ContestProblem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  OrganizationStudentProfile OrganizationStudentProfile @relation("ContestProblemScoreStudentProfile", fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([contestId, problemId, studentProfileId])
  @@index([studentProfileId])
}

model ContestRecord {
  id                 String   @id
  canonicalContestId String?
  userId             String
  userType           String
  content            String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now())
  CanonicalContest   Contest? @relation("CanonicalContestRecords", fields: [canonicalContestId], references: [id], onDelete: Restrict)

  @@unique([canonicalContestId, userId, userType])
  @@index([canonicalContestId])
  @@index([updatedAt])
  @@index([userId])
}

model ContestResource {
  id               String          @id
  contestId        String
  contestProblemId String?
  fileName         String
  fileType         String
  fileFormat       String          @default("pdf")
  fileUrl          String
  visibleRoles     String          @default("all")
  uploadedBy       String
  uploadedAt       DateTime        @default(now())
  Contest          Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem   ContestProblem? @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
}

model ContestResult {
  id                         String                     @id
  contestId                  String
  studentProfileId           String
  studentNameSnapshot        String
  usernameSnapshot           String
  rank                       Int?
  score                      Float?
  ratingBefore               Int
  ratingAfter                Int
  ratingChange               Int
  note                       String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @default(now())
  Contest                    Contest                    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  OrganizationStudentProfile OrganizationStudentProfile @relation("ContestResultStudentProfile", fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([contestId, studentProfileId])
  @@index([createdAt])
  @@index([studentProfileId])
}

model ContestUserProblemStatus {
  id               String         @id
  contestId        String
  userId           String
  contestProblemId String
  bestScore        Int?
  bestResult       String?
  attemptCount     Int            @default(0)
  acAt             DateTime?
  frozenScore      Int?
  frozenResult     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now())
  Contest          Contest        @relation("CanonicalContestStatuses", fields: [contestId], references: [id], onDelete: Restrict)
  ContestProblem   ContestProblem @relation("CanonicalContestProblemStatuses", fields: [contestProblemId], references: [id], onDelete: Restrict)
  User             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId, contestProblemId])
  @@index([contestId, userId])
  @@index([userId])
}

model ContestRatingConfig {
  id                          String      @id
  contestId                   String      @unique
  scope                       RatingScope @default(NONE)
  track                       RatingTrack
  weightBasisPoints           Int         @default(10000)
  algorithmCode               String      @default("CARITS_MULTI_ELO")
  algorithmVersion            Int         @default(1)
  organizationMinParticipants Int         @default(5)
  globalMinParticipants       Int         @default(20)
  scoringRules                Json
  rulesHash                   String
  revision                    Int         @default(1)
  lockedAt                    DateTime?
  createdBy                   String
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  Contest                     Contest     @relation("CanonicalContestRatingConfig", fields: [contestId], references: [id], onDelete: Restrict)

  @@index([scope, track])
  @@index([lockedAt])
  @@map("TrainingRatingConfig")
}

model ContestStandingSnapshot {
  id                  String                 @id
  contestId           String
  revision            Int
  scoringMode         RatingTrack
  rulesHash           String
  status              StandingSnapshotStatus @default(BUILDING)
  inputHash           String
  createdBy           String
  createdAt           DateTime               @default(now())
  finalizedAt         DateTime?
  supersededAt        DateTime?
  Contest             Contest                @relation("CanonicalContestStandingSnapshots", fields: [contestId], references: [id], onDelete: Restrict)
  FinalizedForContest Contest?               @relation("ContestFinalizedStanding")
  Entries             ContestStandingEntry[]
  RatingBatches       RatingBatch[]
  BlogReferences      BlogReference[]

  @@unique([contestId, revision])
  @@index([contestId, status])
}

model ContestStandingEntry {
  id                     String                       @id
  snapshotId             String
  userId                 String
  organizationIdSnapshot String?
  rank                   Int
  ratingTieGroup         String
  totalScore             Decimal?                     @db.Decimal(14, 4)
  solvedCount            Int?
  penaltySeconds         Int?
  lastAcceptedAt         DateTime?
  fullScoreCount         Int?
  ratingEligible         Boolean                      @default(true)
  participantDisposition RatingParticipantDisposition @default(NORMAL)
  createdAt              DateTime                     @default(now())
  Snapshot               ContestStandingSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  User                   User                         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, userId])
  @@index([snapshotId, rank])
  @@index([userId, createdAt])
  @@index([organizationIdSnapshot])
}

model RatingPool {
  id               String             @id
  scopeType        RatingScope
  organizationId   String?
  track            RatingTrack
  baseRating       Int                @default(1500)
  scale            Int                @default(400)
  kFactor          Int                @default(96)
  algorithmCode    String             @default("CARITS_MULTI_ELO")
  algorithmVersion Int                @default(1)
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Organization     Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  Accounts         RatingAccount[]
  Batches          RatingBatch[]
  RebuildJobs      RatingRebuildJob[]

  @@unique([scopeType, organizationId, track])
  @@index([organizationId, track])
  @@index([scopeType, track, status])
}

model RatingAccount {
  id                String         @id
  poolId            String
  userId            String
  rating            Int            @default(1500)
  peakRating        Int            @default(1500)
  ratedContestCount Int            @default(0)
  provisional       Boolean        @default(true)
  lastRatedAt       DateTime?
  version           Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  Pool              RatingPool     @relation(fields: [poolId], references: [id], onDelete: Restrict)
  User              User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  Changes           RatingChange[]

  @@unique([poolId, userId])
  @@index([poolId, rating(sort: Desc)])
  @@index([userId, updatedAt])
}

model RatingBatch {
  id                 String                  @id
  contestId          String
  poolId             String
  standingSnapshotId String
  algorithmCode      String
  algorithmVersion   Int
  batchRevision      Int                     @default(1)
  fieldSize          Int
  status             RatingBatchStatus       @default(PENDING)
  inputHash          String
  sequenceAt         DateTime
  skipReason         String?
  errorMessage       String?
  createdAt          DateTime                @default(now())
  calculatedAt       DateTime?
  appliedAt          DateTime?
  supersededAt       DateTime?
  supersedesBatchId  String?
  Contest            Contest                 @relation("CanonicalContestRatingBatches", fields: [contestId], references: [id], onDelete: Restrict)
  Pool               RatingPool              @relation(fields: [poolId], references: [id], onDelete: Restrict)
  StandingSnapshot   ContestStandingSnapshot @relation(fields: [standingSnapshotId], references: [id], onDelete: Restrict)
  SupersedesBatch    RatingBatch?            @relation("RatingBatchSupersession", fields: [supersedesBatchId], references: [id], onDelete: SetNull)
  SupersededBy       RatingBatch[]           @relation("RatingBatchSupersession")
  Changes            RatingChange[]

  @@unique([poolId, standingSnapshotId, algorithmCode, algorithmVersion, batchRevision])
  @@index([contestId, status])
  @@index([poolId, sequenceAt])
}

model RatingChange {
  id                  String          @id
  batchId             String
  accountId           String
  userId              String
  ratingBefore        Int
  expectedPerformance Decimal         @db.Decimal(8, 7)
  actualPerformance   Decimal         @db.Decimal(8, 7)
  rank                Int
  fieldSize           Int
  rawDelta            Decimal         @db.Decimal(12, 6)
  appliedDelta        Int
  ratingAfter         Int
  createdAt           DateTime        @default(now())
  Batch               RatingBatch     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  Account             RatingAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  User                User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  BlogReferences      BlogReference[]

  @@unique([batchId, userId])
  @@index([userId, createdAt])
  @@index([accountId, createdAt])
}

model RatingRebuildJob {
  id            String     @id
  poolId        String
  fromContestId String
  status        String     @default("pending")
  requestedBy   String
  report        Json?
  createdAt     DateTime   @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  Pool          RatingPool @relation(fields: [poolId], references: [id], onDelete: Restrict)

  @@index([poolId, status])
}

model File {
  id           String    @id
  storageType  String    @default("local")
  disk         String    @default("default")
  relativePath String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  md5Hash      String?
  sha256Hash   String?
  accessLevel  String    @default("private")
  isPublic     Boolean   @default(false)
  ownerType    String
  ownerId      String
  category     String
  status       String    @default("active")
  deletedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@index([category])
  @@index([md5Hash])
  @@index([ownerType, ownerId])
  @@index([status, deletedAt])
  @@index([storageType, disk])
}

model LoginLog {
  id                  String   @id
  userId              String?
  username            String
  accountRoleSnapshot String?
  result              String
  failureReason       String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([result])
  @@index([username])
}

model Milestone {
  id                  String                 @id
  studentMembershipId String
  teacherMembershipId String
  studentNameSnapshot String
  teacherNameSnapshot String
  title               String
  description         String?
  milestoneDate       DateTime
  type                String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now())
  StudentMembership   OrganizationMembership @relation("MilestoneStudentMembership", fields: [studentMembershipId], references: [id], onDelete: Restrict)
