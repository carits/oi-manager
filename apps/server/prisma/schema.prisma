  createdBy        String
  createdAt        DateTime                    @default(now())
  revokedAt        DateTime?
  Assignment       Assignment                  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  Recipient        AssignmentRecipient         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([assignmentId, createdAt])
}

model AssignmentProblemProgress {
  id                      String                     @id @default(uuid())
  assignmentId            String
  assignmentProblemId     String
  recipientId             String
  learningStatus          AssignmentLearningStatus   @default(NOT_STARTED)
  timelinessStatus        AssignmentTimelinessStatus @default(ON_TIME)
  correctionStatus        AssignmentCorrectionStatus @default(NONE)
  attemptCount            Int                        @default(0)
  originalAttemptCount    Int                        @default(0)
  correctionAttemptCount  Int                        @default(0)
  bestScore               Int?
  bestVerdict             String?
  originalScore           Int?
  correctionScore         Int?
  finalScore              Int?
  firstSubmissionId       Int?
  bestSubmissionId        Int?
  latestSubmissionId      Int?
  targetMetAt             DateTime?
  completedAt             DateTime?
  manualCompletionVersion Int                        @default(0)
  manualCompletedAt       DateTime?
  manualCompletedByUserId String?
  manualCompletionReason  String?
