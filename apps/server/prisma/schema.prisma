  Group      ProblemTestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([testcaseId, groupId])
  @@index([groupId, orderIndex])
}

model ProblemTestSetRevision {
  id                              String                            @id
  problemId                       String
  revisionNumber                  Int
  parentRevisionId                String?
  mode                            String
  source                          String
  judgeConfig                     String                            @db.Text
  judgeConfigHash                 String
  graphHash                       String
  testdataPath                    String
  createdBy                       String?
  hackAttemptId                   String?
  createdAt                       DateTime                          @default(now())
  Problem                         Problem                           @relation("ProblemTestSetRevisions", fields: [problemId], references: [id], onDelete: Cascade)
  LatestForProblem                Problem[]                         @relation("ProblemLatestTestSetRevision")
  Parent                          ProblemTestSetRevision?           @relation("TestSetRevisionParent", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  Children                        ProblemTestSetRevision[]          @relation("TestSetRevisionParent")
  AcmCases                        ProblemTestSetRevisionCase[]
  Subtasks                        ProblemTestSetRevisionSubtask[]
  TrainingProblems                TrainingProblem[]
  TrainingSessionStageProblems   TrainingSessionStageProblem[]
  Submissions                     Submission[]
  HackAttemptsBasedOn             ProblemHackAttempt[]              @relation("HackBaseTestSetRevision")
  PromotedHackAttempts            ProblemHackAttempt[]              @relation("HackPromotedTestSetRevision")
  CandidateBases                  TestcaseCandidate[]               @relation("CandidateBaseTestSetRevision")
  PromotedCandidates              TestcaseCandidate[]               @relation("CandidatePromotedRevision")
  JudgeRuns                       JudgeRun[]
  ProblemTestSetRevisionGroup     ProblemTestSetRevisionGroup[]
  ProblemTestSetRevisionGroupCase ProblemTestSetRevisionGroupCase[]

  @@unique([problemId, revisionNumber])
  @@index([problemId, createdAt])
  @@index([parentRevisionId])
  @@index([judgeConfigHash])
}

model ProblemTestSetRevisionCase {
  id             String                 @id
  revisionId     String
  testcaseId     String?
  inputObjectId  String
  outputObjectId String
  inputName      String
  outputName     String
  orderIndex     Int
  score          Int?
  time           String?
  memory         String?
  source         String                 @default("official")
