generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  name      String
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  id        String   @id
  User      User     @relation(fields: [id], references: [id], onDelete: Cascade)
  School    School   @relation(fields: [schoolId], references: [id])
}

model AiUsageLog {
  id          String   @id
  userId      String
  problemId   String
  action      String
  sourceLang  String?
  targetLang  String?
  model       String?
  tokensUsed  Int      @default(0)
  status      String   @default("success")
  message     String?
  createdAt   DateTime @default(now())
  statementId String?

  @@index([userId, createdAt])
  @@index([userId, problemId, action, createdAt])
}

model Contest {
  id                  String                @id
  title               String
  description         String?
  contestDate         DateTime
  status              String                @default("upcoming")
  type                String                @default("mock")
  teamId              String?
  countRating         Boolean               @default(false)
  scope               String                @default("public")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  Team                Team?                 @relation(fields: [teamId], references: [id])
  ContestProblem      ContestProblem[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]
  ContestResult       ContestResult[]

  @@index([contestDate])
  @@index([scope])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
}

model ContestProblem {
  id                  String                @id
  contestId           String
  orderIndex          Int
  title               String?
  description         String?
  ojName              String?
  problemId           String?
  isCustom            Boolean               @default(false)
  difficulty          String?
  points              Int?
  statementType       String                @default("none")
  statementMarkdown   String?
  solutionType        String                @default("none")
  solutionMarkdown    String?
  solutionVisible     Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  Contest             Contest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]

  @@unique([contestId, orderIndex])
}

model ContestProblemScore {
  id             String         @id
  contestId      String
  problemId      String
  studentId      String
  score          Float?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
  Contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId, studentId])
}

model ContestRecord {
  id         String   @id
  trainingId Int
  userId     String
  userType   String
  content    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, userType])
  @@index([updatedAt])
  @@index([userId])
}

model ContestResource {
  id               String          @id
  contestId        String
  contestProblemId String?
  fileName         String
  fileType         String
  fileFormat       String          @default("pdf")
  fileUrl          String
  visibleRoles     String          @default("all")
  uploadedBy       String
  uploadedAt       DateTime        @default(now())
  Contest          Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem   ContestProblem? @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
}

model ContestResult {
  id           String   @id
  contestId    String
  studentId    String
  rank         Int?
  score        Float?
  ratingBefore Int
  ratingAfter  Int
  ratingChange Int
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  Contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  Student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, studentId])
  @@index([createdAt])
  @@index([studentId])
}

model ContestUserProblemStatus {
  id               String          @id
  contestId        Int
  userId           String
  contestProblemId String
  bestScore        Int?
  bestResult       String?
  attemptCount     Int             @default(0)
  acAt             DateTime?
  frozenScore      Int?
  frozenResult     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now())
  Training         Training        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  TrainingProblem  TrainingProblem @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
  User             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId, contestProblemId])
  @@index([contestId, userId])
  @@index([userId])
}

model File {
  id           String    @id
  storageType  String    @default("local")
  disk         String    @default("default")
  relativePath String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  md5Hash      String?
  sha256Hash   String?
  accessLevel  String    @default("private")
  isPublic     Boolean   @default(false)
  ownerType    String
  ownerId      String
  category     String
  status       String    @default("active")
  deletedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@index([category])
  @@index([md5Hash])
  @@index([ownerType, ownerId])
  @@index([status, deletedAt])
  @@index([storageType, disk])
}

model LoginLog {
  id            String   @id
  userId        String?
  username      String
  loginRole     String
  userRole      String?
  result        String
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([result])
  @@index([username])
}

model Milestone {
  id            String   @id
  studentId     String
  teacherId     String
  title         String
  description   String?
  milestoneDate DateTime
  type          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  Student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Teacher       Teacher  @relation(fields: [teacherId], references: [id])

  @@index([milestoneDate])
  @@index([studentId])
  @@index([teacherId])
}

model OjAccount {
  id                          String       @id
  platform                    String
  username                    String
  password                    String?
  passwordIV                  String?
  cookie                      String?
  cookieRaw                   String?
  status                      String       @default("unverified")
  lastVerifiedAt              DateTime?
  lastErrorMessage            String?
  loginMethod                 String       @default("cookie")
  addedBy                     String
  lastLoginAt                 DateTime?
  lastLoginFailureAt          DateTime?
  lastSubmitAt                DateTime?
  lastRateLimitAt             DateTime?
  consecutiveFailures         Int          @default(0)
  rateLimitCount              Int          @default(0)
  totalSubmissions            Int          @default(0)
  totalSubmissionErrors       Int          @default(0)
  enabled                     Boolean      @default(true)
  priority                    Int          @default(0)
  maxConsecutiveFailures      Int          @default(3)
  freezeDurationMinutes       Int          @default(30)
  submitMaxRetries            Int          @default(1)
  retryIntervalSeconds        Int          @default(10)
  minSubmitIntervalSeconds    Int          @default(30)
  minRequestIntervalSeconds   Int          @default(3)
  maxConcurrentSubmissions    Int          @default(1)
  maxConcurrentRequests       Int          @default(2)
  loginFailureCooldownMinutes Int          @default(15)
  cookieValidMinutes          Int          @default(3600)
  renewLoginThresholdMinutes  Int          @default(10)
  reverifyIntervalMinutes     Int          @default(30)
  autoVerifyIntervalMinutes   Int          @default(1440)
  firstPollDelaySeconds       Int          @default(5)
  pollIntervalSeconds         Int          @default(5)
  maxWaitDurationMinutes      Int          @default(10)
  rateLimitThreshold          Int          @default(2)
  banSuspicionCooldownHours   Int          @default(6)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @default(now())
  Submission                  Submission[]

  @@unique([platform, username])
  @@index([platform])
  @@index([status])
}

model OjFetchJob {
  id               String   @id
  platform         String
  problemId        String
  status           String   @default("pending")
  message          String?
  hasAttachment    Boolean  @default(false)
  attachmentStatus String?
  createdProblemId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@unique([platform, problemId])
  @@index([createdAt])
  @@index([status])
}

model OjPlatformConfig {
  id         String    @id
  platform   String    @unique
  cookies    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
}

model PasswordResetLog {
  id           String   @id
  operatorRole String
  resetMethod  String
  result       String
  message      String?
  createdAt    DateTime @default(now())
  operatorId   String
  targetId     String
}

model PrincipalTransferLog {
  id                    String   @id
  schoolId              String
  oldPrincipalTeacherId String?
  newPrincipalTeacherId String
  result                String
  message               String?
  createdAt             DateTime @default(now())
  operatorId            String
  School                School   @relation(fields: [schoolId], references: [id])
}

model Problem {
  id                String              @id
  platform          String
  problemId         String
  title             String
  description       String?
  statementType     String              @default("none")
  statementPdfUrl   String?
  solutionType      String              @default("none")
  solutionMarkdown  String?
  solutionPdfUrl    String?
  solutionVisible   Boolean             @default(false)
  difficulty        String?
  timeLimit         Int?
  memoryLimit       Int?
  judgeConfig       String?
  problemType       String              @default("default")
  visibility        String              @default("private")
  ownerType         String              @default("teacher")
  ownerId           String
  libraryScope      String              @default("platform")
  libraryKey        String              @default("platform")
  schoolId          String?
  sourceProblemId   String?
  status            String              @default("draft")
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now())
  allowedLanguages  String?
  ojBindings        String?
  ProblemAttachment ProblemAttachment[]
  ProblemListEntry  ProblemListEntry[]
  ProblemNote       ProblemNote[]
  ProblemStatement  ProblemStatement[]
  TestdataFile      TestdataFile[]
  TrainingProblem   TrainingProblem[]
  Owner             User                @relation("ProblemOwner", fields: [ownerId], references: [id])
  School            School?             @relation(fields: [schoolId], references: [id])
  SourceProblem     Problem?            @relation("ProblemCopies", fields: [sourceProblemId], references: [id], onDelete: SetNull)
  CopiedProblems    Problem[]           @relation("ProblemCopies")

  @@unique([libraryKey, platform, problemId])
  @@index([createdAt])
  @@index([libraryScope, status])
  @@index([ownerId, ownerType])
  @@index([schoolId, status])
  @@index([sourceProblemId])
  @@index([visibility])
  @@index([visibility, status])
}

model ProblemAttachment {
  id          String   @id
  problemId   String
  fileName    String
  fileSize    Int
  fileUrl     String
  description String?
  uploadedAt  DateTime @default(now())
  Problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model ProblemList {
  id                 String               @id
  title              String
  description        String?
  coverUrl           String?
  schoolId           String?
  ownerId            String
  ownerType          String               @default("teacher")
  scope              String               @default("campus")
  visibility         String               @default("private")
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  ProblemListSection ProblemListSection[]
  ProblemListShare   ProblemListShare[]
  SchoolProblemList  SchoolProblemList[]
  TeamProblemList    TeamProblemList[]

  @@index([createdAt])
  @@index([ownerId, ownerType])
  @@index([schoolId])
  @@index([scope])
  @@index([scope, ownerId])
  @@index([visibility])
}

model PersonalProfile {
  userId    String   @id
  rating    Int      @default(1200)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
}

model ProblemListEntry {
  id                 String             @id
  sectionId          String
  problemId          String
  sortOrder          Int                @default(0)
  alias              String?
  notes              String?
  ojName             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now())
  Problem            Problem            @relation(fields: [problemId], references: [id])
  ProblemListSection ProblemListSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, problemId])
  @@index([problemId])
  @@index([sectionId])
}

model ProblemListSection {
  id               String             @id
  problemListId    String
  title            String
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now())
  ProblemListEntry ProblemListEntry[]
  ProblemList      ProblemList        @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@index([problemListId])
}

model ProblemListShare {
  id            String      @id
  problemListId String
  targetType    String
  targetId      String
  permission    String      @default("view")
  sharedBy      String
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@unique([problemListId, targetType, targetId])
  @@index([sharedBy])
  @@index([targetType, targetId])
}

model ProblemNote {
  id        String   @id
  problemId String
  userId    String
  userType  String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId, userType])
  @@index([updatedAt])
  @@index([userId])
}

model ProblemStatement {
  id        String   @id
  problemId String
  type      String
  format    String
  language  String?
  content   String?
  fileUrl   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, type, format, language])
  @@index([problemId, type])
}

model School {
  id                                                String                 @id
  name                                              String
  announcement                                      String?
  region                                            String?
  schoolType                                        String?
  educationSystem                                   String?                @default("6-3-3")
  contactPerson                                     String?
  contactPhone                                      String?
  contactEmail                                      String?
  status                                            String                 @default("active")
  currentPrincipalTeacherId                         String
  createdAt                                         DateTime               @default(now())
  updatedAt                                         DateTime               @default(now())
  Admin                                             Admin[]
  PrincipalTransferLog                              PrincipalTransferLog[]
  Problem                                           Problem[]
  Teacher_School_currentPrincipalTeacherIdToTeacher Teacher                @relation("School_currentPrincipalTeacherIdToTeacher", fields: [currentPrincipalTeacherId], references: [id])
  SchoolProblemList                                 SchoolProblemList[]
  Student                                           Student[]
  Teacher_Teacher_schoolIdToSchool                  Teacher[]              @relation("Teacher_schoolIdToSchool")
  Team                                              Team[]
  Training                                          Training[]
  User                                              User[]
}

model SchoolProblemList {
  id            String      @id
  schoolId      String
  problemListId String
  addedBy       String
  addedByRole   String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  School        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, problemListId])
  @@index([addedBy])
  @@index([problemListId])
  @@index([schoolId])
}

model Student {
  id                        String                      @id
  name                      String
  gender                    String?
  schoolId                  String
  enrollmentYear            Int?
  targetContest             String?
  headTeacherId             String?
  tags                      String?
  notes                     String?
  avatar                    String?
  rating                    Int                         @default(1200)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now())
  ContestProblemScore       ContestProblemScore[]
  ContestResult             ContestResult[]
  Milestone                 Milestone[]
  Teacher                   Teacher?                    @relation(fields: [headTeacherId], references: [id])
  User                      User                        @relation(fields: [id], references: [id], onDelete: Cascade)
  School                    School                      @relation(fields: [schoolId], references: [id])
  TeamMemberExternalAccount TeamMemberExternalAccount[]

  @@index([enrollmentYear])
  @@index([headTeacherId])
  @@index([rating])
  @@index([schoolId, headTeacherId])
  @@index([schoolId])
}

model Submission {
  id                Int        @id @default(autoincrement())
  userId            String
  oj                String
  problemId         String
  language          String
  code              String
  codeLength        Int
  result            String     @default("queuing")
  timeUsed          Int?
  wallTimeUsed      Int?
  memoryUsed        Int?
  timeoutReason     String?
  metricSource      String?
  submitMethod      String
  ojAccountId       String?
  ojRemoteId        String?
  errorMessage      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now())
  problemInternalId String?
  cases             String?
  score             Int?
  subtasks          String?
  isGlobalVisible   Boolean    @default(true)
  sourceId          String?
  submitSource      String?
  judgeId           String?
  judgeStarted      DateTime?
  submitScope       String     @default("problem")
  workspaceScope    String     @default("campus")
  trainingId        Int?
  trainingProblemId String?
  contestId         Int?
  contestProblemId  String?
  OjAccount         OjAccount? @relation(fields: [ojAccountId], references: [id])
  Training          Training?  @relation(fields: [trainingId], references: [id])
  User              User       @relation(fields: [userId], references: [id])

  @@index([contestId])
  @@index([createdAt])
  @@index([createdAt, result])
  @@index([isGlobalVisible])
  @@index([language])
  @@index([oj])
  @@index([problemId])
  @@index([result])
  @@index([result, judgeId])
  @@index([sourceId])
  @@index([submitScope, contestId])
  @@index([submitScope])
  @@index([workspaceScope])
  @@index([workspaceScope, userId, createdAt])
  @@index([submitScope, trainingId])
  @@index([submitSource])
  @@index([trainingId])
  @@index([trainingProblemId])
  @@index([userId, contestId])
  @@index([userId])
  @@index([userId, oj, problemId])
  @@index([userId, trainingId])
  @@index([userId, trainingProblemId])
}

model Teacher {
  id                                               String      @id
  name                                             String
  email                                            String?
  phone                                            String?
  avatar                                           String?
  bio                                              String?
  title                                            String?
  status                                           String      @default("active")
  schoolId                                         String
  createdAt                                        DateTime    @default(now())
  updatedAt                                        DateTime    @default(now())
  Milestone                                        Milestone[]
  School_School_currentPrincipalTeacherIdToTeacher School[]    @relation("School_currentPrincipalTeacherIdToTeacher")
  Student                                          Student[]
  User                                             User        @relation(fields: [id], references: [id], onDelete: Cascade)
  School_Teacher_schoolIdToSchool                  School      @relation("Teacher_schoolIdToSchool", fields: [schoolId], references: [id])

  @@index([createdAt])
  @@index([schoolId])
  @@index([status])
}

model Team {
  id                        String                      @id
  name                      String
  avatar                    String?
  description               String?
  announcement              String?
  schoolId                  String?
  scope                     String                      @default("campus")
  isPublic                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now())
  Contest                   Contest[]
  School                    School?                     @relation(fields: [schoolId], references: [id])
  TeamJoinRequest           TeamJoinRequest[]
  TeamMember                TeamMember[]
  TeamMemberExternalAccount TeamMemberExternalAccount[]
  TeamMemberImportBatch     TeamMemberImportBatch[]
  TeamProblemList           TeamProblemList[]
  Training                  Training[]

  @@index([createdAt])
  @@index([isPublic])
  @@index([scope])
  @@index([scope, isPublic])
  @@index([schoolId])
  @@index([schoolId, scope, isPublic])
}

model TeamJoinRequest {
  id          String    @id
  teamId      String
  userId      String
  status      String    @default("pending")
  message     String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  processedBy String?
  Team        Team      @relation(fields: [teamId], references: [id])
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamMember {
  id        String   @id
  teamId    String
  userId    String
  userType  String
  role      String
  status    String   @default("active")
  joinedAt  DateTime @default(now())
  invitedBy String?
  Team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, userType])
  @@index([status])
  @@index([teamId, role])
  @@index([teamId, status, role])
  @@index([userId, userType, status])
}

model TeamMemberExternalAccount {
  id               String   @id
  teamId           String
  studentId        String?
  platform         String
  platformUsername String
  displayName      String?
  status           String   @default("pending")
  inviteId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  Student          Student? @relation(fields: [studentId], references: [id])
  Team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, platform, platformUsername])
  @@index([platform, platformUsername])
  @@index([studentId])
}

model TeamMemberImportBatch {
  id                   String                 @id
  teamId               String?
  operatorId           String
  platform             String
  totalCount           Int
  successCount         Int                    @default(0)
  skipCount            Int                    @default(0)
  errorCount           Int                    @default(0)
  status               String                 @default("pending")
  rawInput             String?
  createdAt            DateTime               @default(now())
  completedAt          DateTime?
  Team                 Team?                  @relation(fields: [teamId], references: [id])
  TeamMemberImportItem TeamMemberImportItem[]

  @@index([operatorId])
  @@index([teamId])
}

model TeamMemberImportItem {
  id                    String                @id
  batchId               String
  lineNumber            Int
  rawUsername           String
  rawStudentName        String?
  parsedUsername        String?
  candidateDisplayName  String?
  matchType             String
  matchStatus           String                @default("pending")
  matchedStudentId      String?
  matchedStudentName    String?
  createdStudentId      String?
  action                String?
  userChoice            String?
  errorMessage          String?
  createdAt             DateTime              @default(now())
  processedAt           DateTime?
  TeamMemberImportBatch TeamMemberImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([matchType])
}

model TeamOperationLog {
  id           String   @id
  teamId       String
  operatorId   String
  operatorType String
  action       String
  targetId     String?
  targetType   String?
  oldValue     String?
  newValue     String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([operatorId])
  @@index([teamId])
}

model TeamProblemList {
  id            String      @id
  teamId        String
  problemListId String
  addedBy       String
  addedByRole   String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  Team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, problemListId])
  @@index([addedBy])
  @@index([problemListId])
  @@index([teamId])
}

model TestdataFile {
  id         String   @id
  problemId  String
  filename   String
  size       Int
  md5        String?
  uploadedAt DateTime @default(now())
  Problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, filename])
  @@index([problemId])
}

model Training {
  id                        Int                         @id @default(autoincrement())
  teamId                    String?
  title                     String
  description               String?
  format                    String                      @default("ioi")
  startTime                 DateTime
  endTime                   DateTime
  status                    String                      @default("upcoming")
  createdBy                 String
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now())
  includeAdminInRanking     Boolean                     @default(false)
  problemIdVisible          Boolean                     @default(false)
  solutionVisible           Boolean                     @default(false)
  type                      String                      @default("training")
  scope                     String                      @default("campus")
  schoolId                  String?
  sourceTrainingId          Int?
  ContestRecord             ContestRecord[]
  ContestUserProblemStatus  ContestUserProblemStatus[]
  Submission                Submission[]
  School                    School?                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  Team                      Team?                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  TrainingParticipant       TrainingParticipant[]
  TrainingProblem           TrainingProblem[]
  TrainingUserProblemStatus TrainingUserProblemStatus[]

  @@index([schoolId])
  @@index([scope])
  @@index([scope, status])
  @@index([schoolId, status])
  @@index([startTime])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
}

model TrainingAttachment {
  id                String          @id
  trainingProblemId String
  fileName          String
  fileUrl           String
  fileSize          Int
  uploadedBy        String
  uploadedAt        DateTime        @default(now())
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)

  @@index([trainingProblemId])
}

model TrainingParticipant {
  id         String   @id
  trainingId Int
  userId     String
  userType   String
  joinedAt   DateTime @default(now())
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, userType])
  @@index([trainingId])
  @@index([userId])
}

model TrainingProblem {
  id                        String                      @id
  trainingId                Int
  problemId                 String
  alias                     String?
  orderIndex                Int
  points                    Int?
  createdAt                 DateTime                    @default(now())
  dataVersion               String?
  snapshotCreatedAt         DateTime?
  statementSnapshot         String?
  titleSnapshot             String?
  statementsSnapshotJson    String?                     @db.Text
  timeLimitSnapshot         Int?
  memoryLimitSnapshot       Int?
  judgeConfigSnapshot       String?                     @db.Text
  allowedLanguagesSnapshot  String?
  sourcePlatformSnapshot    String?
  sourceProblemIdSnapshot   String?
  sourceUrlSnapshot         String?
  ContestUserProblemStatus  ContestUserProblemStatus[]
  TrainingAttachment        TrainingAttachment[]
  Problem                   Problem                     @relation(fields: [problemId], references: [id])
  Training                  Training                    @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  TrainingSolution          TrainingSolution?
  TrainingUserProblemStatus TrainingUserProblemStatus[]

  @@unique([trainingId, alias])
  @@unique([trainingId, orderIndex])
  @@index([problemId])
  @@index([trainingId])
}

model TrainingSolution {
  id                String          @id
  trainingProblemId String          @unique
  content           String
  visible           Boolean         @default(false)
  createdBy         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now())
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
}

model TrainingUserProblemStatus {
  id                String          @id
  trainingId        Int
  userId            String
  trainingProblemId String
  bestScore         Int?
  bestResult        String?
  attemptCount      Int             @default(0)
  acAt              DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now())
  Training          Training        @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
  User              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, trainingProblemId])
  @@index([trainingId, userId])
  @@index([userId])
}

model User {
  id                        String                      @id
  username                  String                      @unique
  passwordHash              String
  role                      String
  schoolId                  String
  status                    String                      @default("active")
  avatar                    String?
  phone                     String?
  email                     String?
  bio                       String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now())
  Admin                     Admin?
  PersonalProfile           PersonalProfile?
  Problem                   Problem[]                   @relation("ProblemOwner")
  ContestUserProblemStatus  ContestUserProblemStatus[]
  Student                   Student?
  Submission                Submission[]
  TeamJoinRequest           TeamJoinRequest[]
  TeamMember                TeamMember[]
  Teacher                   Teacher?
  TrainingUserProblemStatus TrainingUserProblemStatus[]
  School                    School                      @relation(fields: [schoolId], references: [id])
  UserArchivedProblem       UserArchivedProblem[]
  UserPlatformBinding       UserPlatformBinding[]

  @@index([createdAt])
  @@index([role])
  @@index([schoolId])
  @@index([status])
}

model UserArchivedProblem {
  id          String    @id
  userId      String
  platform    String
  problemId   String
  title       String?
  difficulty  String?
  tags        String?
  solvedAt    DateTime?
  sourceUrl   String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  ojRemoteId  String?
  result      String?
  submittedAt DateTime?
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, problemId])
  @@index([platform])
  @@index([userId])
  @@index([userId, platform])
}

model UserPlatformBinding {
  id               String    @id
  userId           String
  platform         String
  platformUsername String?
  bindingStatus    String    @default("unbound")
  bindingData      String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  platformConfig   String?
  platformUid      String?
  statusMessage    String?
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([platform])
  @@index([userId])
}

model UserStatusLog {
  id           String   @id
  operatorRole String
  oldStatus    String
  newStatus    String
  reason       String?
  createdAt    DateTime @default(now())
  operatorId   String
  targetId     String
}

model carits_sequence {
  id     Int @id @default(1)
  nextId Int @default(1000)
}
