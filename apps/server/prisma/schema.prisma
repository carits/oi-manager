  AssignmentProblem   AssignmentProblem           @relation(fields: [assignmentProblemId], references: [id], onDelete: Cascade)
  Recipient           AssignmentRecipient         @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([assignmentId, status, dueAt])
  @@index([recipientId, status])
