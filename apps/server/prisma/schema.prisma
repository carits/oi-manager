  updatedAt                  DateTime                    @default(now())
  OrganizationStudentProfile OrganizationStudentProfile? @relation("ExternalAccountStudentProfile", fields: [studentProfileId], references: [id], onDelete: Restrict)
  Team                       Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, platform, platformUsername])
  @@index([platform, platformUsername])
  @@index([studentProfileId])
}

model TeamMemberImportBatch {
  id                   String                 @id
  teamId               String?
  organizationId       String?
  operatorId           String
  platform             String
  totalCount           Int
  successCount         Int                    @default(0)
  skipCount            Int                    @default(0)
  errorCount           Int                    @default(0)
  status               String                 @default("pending")
