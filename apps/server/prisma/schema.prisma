generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JudgeRunType {
  NORMAL
  REJUDGE
  HACK_REJUDGE
  MANUAL
  MIGRATION_VERIFY
}

enum JudgeRunStatus {
  QUEUED
  RUNNING
  FINALIZED
  CANCELLED
}

enum JudgeAttemptState {
  QUEUED
  CLAIMED
  COMPILING
  RUNNING
  FINALIZING
  SUCCEEDED
  USER_ERROR
  INFRA_ERROR
  CANCELLED
}

enum RejudgeBatchStatus {
  CREATED
  QUEUING
  COMPLETED
  FAILED
  CANCELLED
}

enum TestcaseCandidateStatus {
  VALIDATED
  PROMOTING
  PROMOTED
  REDUNDANT
  REJECTED
  FAILED
  STALE
}

model AiUsageLog {
  id          String   @id
  userId      String
  problemId   String
  action      String
  sourceLang  String?
  targetLang  String?
  model       String?
  tokensUsed  Int      @default(0)
  status      String   @default("success")
  message     String?
  createdAt   DateTime @default(now())
  statementId String?

  @@index([userId, createdAt])
  @@index([userId, problemId, action, createdAt])
}

model Contest {
  id                  String                @id
  title               String
  description         String?
  contestDate         DateTime
  status              String                @default("upcoming")
  type                String                @default("mock")
  teamId              String?
  countRating         Boolean               @default(false)
  scope               String                @default("public")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  Team                Team?                 @relation(fields: [teamId], references: [id])
  ContestProblem      ContestProblem[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]
  ContestResult       ContestResult[]

  @@index([contestDate])
  @@index([scope])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
}

model ContestProblem {
  id                  String                @id
  contestId           String
  orderIndex          Int
  title               String?
  description         String?
  ojName              String?
  problemId           String?
  isCustom            Boolean               @default(false)
  difficulty          String?
  points              Int?
  statementType       String                @default("none")
  statementMarkdown   String?
  solutionType        String                @default("none")
  solutionMarkdown    String?
  solutionVisible     Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  Contest             Contest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]

  @@unique([contestId, orderIndex])
}

model ContestProblemScore {
  id                         String                     @id
  contestId                  String
  problemId                  String
  studentProfileId           String
  studentNameSnapshot        String
  usernameSnapshot           String
  score                      Float?
  note                       String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @default(now())
  Contest                    Contest                    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem             ContestProblem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  OrganizationStudentProfile OrganizationStudentProfile @relation("ContestProblemScoreStudentProfile", fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([contestId, problemId, studentProfileId])
  @@index([studentProfileId])
}

model ContestRecord {
  id         String   @id
  trainingId Int
  userId     String
  userType   String
  content    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, userType])
  @@index([updatedAt])
  @@index([userId])
}

model ContestResource {
  id               String          @id
  contestId        String
  contestProblemId String?
  fileName         String
  fileType         String
  fileFormat       String          @default("pdf")
  fileUrl          String
  visibleRoles     String          @default("all")
  uploadedBy       String
  uploadedAt       DateTime        @default(now())
  Contest          Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem   ContestProblem? @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
}

model ContestResult {
  id                         String                     @id
  contestId                  String
  studentProfileId           String
  studentNameSnapshot        String
  usernameSnapshot           String
  rank                       Int?
  score                      Float?
  ratingBefore               Int
  ratingAfter                Int
  ratingChange               Int
  note                       String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @default(now())
  Contest                    Contest                    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  OrganizationStudentProfile OrganizationStudentProfile @relation("ContestResultStudentProfile", fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([contestId, studentProfileId])
  @@index([createdAt])
  @@index([studentProfileId])
}

model ContestUserProblemStatus {
  id               String          @id
  contestId        Int
  userId           String
  contestProblemId String
  bestScore        Int?
  bestResult       String?
  attemptCount     Int             @default(0)
  acAt             DateTime?
  frozenScore      Int?
  frozenResult     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now())
  Training         Training        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  TrainingProblem  TrainingProblem @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
  User             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId, contestProblemId])
  @@index([contestId, userId])
  @@index([userId])
}

model File {
  id           String    @id
  storageType  String    @default("local")
  disk         String    @default("default")
  relativePath String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  md5Hash      String?
  sha256Hash   String?
  accessLevel  String    @default("private")
  isPublic     Boolean   @default(false)
  ownerType    String
  ownerId      String
  category     String
  status       String    @default("active")
  deletedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@index([category])
  @@index([md5Hash])
  @@index([ownerType, ownerId])
  @@index([status, deletedAt])
  @@index([storageType, disk])
}

model LoginLog {
  id            String   @id
  userId        String?
  username      String
  loginRole     String
  userRole      String?
  result        String
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([result])
  @@index([username])
}

model Milestone {
  id                  String                 @id
  studentMembershipId String
  teacherMembershipId String
  studentNameSnapshot String
  teacherNameSnapshot String
  title               String
  description         String?
  milestoneDate       DateTime
  type                String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now())
  StudentMembership   OrganizationMembership @relation("MilestoneStudentMembership", fields: [studentMembershipId], references: [id], onDelete: Restrict)
  TeacherMembership   OrganizationMembership @relation("MilestoneTeacherMembership", fields: [teacherMembershipId], references: [id], onDelete: Restrict)

  @@index([milestoneDate])
  @@index([studentMembershipId])
  @@index([teacherMembershipId])
}

model OjAccount {
  id                          String       @id
  platform                    String
  username                    String
  password                    String?
  passwordIV                  String?
  cookie                      String?
  cookieRaw                   String?
  status                      String       @default("unverified")
  lastVerifiedAt              DateTime?
  lastErrorMessage            String?
  loginMethod                 String       @default("cookie")
  addedBy                     String
  lastLoginAt                 DateTime?
  lastLoginFailureAt          DateTime?
  lastSubmitAt                DateTime?
  lastRateLimitAt             DateTime?
  consecutiveFailures         Int          @default(0)
  rateLimitCount              Int          @default(0)
  totalSubmissions            Int          @default(0)
  totalSubmissionErrors       Int          @default(0)
  enabled                     Boolean      @default(true)
  priority                    Int          @default(0)
  maxConsecutiveFailures      Int          @default(3)
  freezeDurationMinutes       Int          @default(30)
  submitMaxRetries            Int          @default(1)
  retryIntervalSeconds        Int          @default(10)
  minSubmitIntervalSeconds    Int          @default(30)
  minRequestIntervalSeconds   Int          @default(3)
  maxConcurrentSubmissions    Int          @default(1)
  maxConcurrentRequests       Int          @default(2)
  loginFailureCooldownMinutes Int          @default(15)
  cookieValidMinutes          Int          @default(3600)
  renewLoginThresholdMinutes  Int          @default(10)
  reverifyIntervalMinutes     Int          @default(30)
  autoVerifyIntervalMinutes   Int          @default(1440)
  firstPollDelaySeconds       Int          @default(5)
  pollIntervalSeconds         Int          @default(5)
  maxWaitDurationMinutes      Int          @default(10)
  rateLimitThreshold          Int          @default(2)
  banSuspicionCooldownHours   Int          @default(6)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @default(now())
  Submission                  Submission[]

  @@unique([platform, username])
  @@index([platform])
  @@index([status])
}

model OjFetchJob {
  id               String   @id
  platform         String
  problemId        String
  status           String   @default("pending")
  message          String?
  hasAttachment    Boolean  @default(false)
  attachmentStatus String?
  createdProblemId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@unique([platform, problemId])
  @@index([createdAt])
  @@index([status])
}

model OjPlatformConfig {
  id         String    @id
  platform   String    @unique
  cookies    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
}

model PasswordResetLog {
  id           String   @id
  operatorRole String
  resetMethod  String
  result       String
  message      String?
  createdAt    DateTime @default(now())
  operatorId   String
  targetId     String
}

model PrincipalTransferLog {
  id                       String                  @id
  organizationId           String
  oldPrincipalMembershipId String?
  newPrincipalMembershipId String
  oldPrincipalNameSnapshot String?
  newPrincipalNameSnapshot String
  result                   String
  message                  String?
  createdAt                DateTime                @default(now())
  operatorId               String
  Organization             Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  OldPrincipalMembership   OrganizationMembership? @relation("FormerPrincipalMembership", fields: [oldPrincipalMembershipId], references: [id], onDelete: Restrict)
  NewPrincipalMembership   OrganizationMembership  @relation("NewPrincipalMembership", fields: [newPrincipalMembershipId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([oldPrincipalMembershipId])
  @@index([newPrincipalMembershipId])
}

model Problem {
  id                      String                   @id
  platform                String
  problemId               String
  title                   String
  description             String?
  statementType           String                   @default("none")
  statementPdfUrl         String?
  solutionType            String                   @default("none")
  solutionMarkdown        String?
  solutionPdfUrl          String?
  solutionVisible         Boolean                  @default(false)
  difficulty              String?
  timeLimit               Int?
  memoryLimit             Int?
  judgeConfig             String?
  problemType             String                   @default("default")
  visibility              String                   @default("private")
  ownerType               String                   @default("teacher")
  ownerId                 String
  libraryScope            String                   @default("platform")
  libraryKey              String                   @default("platform")
  organizationId          String?
  sourceProblemId         String?
  status                  String                   @default("draft")
  publishedAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now())
  testGraphRevision       Int                      @default(0)
  latestTestSetRevisionId String?
  allowedLanguages        String?
  ojBindings              String?
  ProblemAttachment       ProblemAttachment[]
  ProblemListEntry        ProblemListEntry[]
  ProblemNote             ProblemNote[]
  ProblemStatement        ProblemStatement[]
  UserProblemContent      UserProblemContent[]
  TestdataFile            TestdataFile[]
  ProblemChecker          ProblemChecker[]
  ProblemHackConfig       ProblemHackConfig?
  ProblemHackAttempt      ProblemHackAttempt[]
  TestcaseCandidate       TestcaseCandidate[]
  ProblemTestcase         ProblemTestcase[]
  ProblemSubtask          ProblemSubtask[]
  ProblemTestGroup        ProblemTestGroup[]
  TestdataObject          TestdataObject[]
  TestSetRevision         ProblemTestSetRevision[] @relation("ProblemTestSetRevisions")
  LatestTestSetRevision   ProblemTestSetRevision?  @relation("ProblemLatestTestSetRevision", fields: [latestTestSetRevisionId], references: [id], onDelete: SetNull)
  TrainingProblem         TrainingProblem[]
  Owner                   User                     @relation("ProblemOwner", fields: [ownerId], references: [id])
  Organization            Organization?            @relation(fields: [organizationId], references: [id])
  SourceProblem           Problem?                 @relation("ProblemCopies", fields: [sourceProblemId], references: [id], onDelete: SetNull)
  CopiedProblems          Problem[]                @relation("ProblemCopies")

  @@unique([libraryKey, platform, problemId])
  @@index([createdAt])
  @@index([libraryScope, status])
  @@index([ownerId, ownerType])
  @@index([organizationId, status])
  @@index([sourceProblemId])
  @@index([visibility])
  @@index([visibility, status])
  @@index([latestTestSetRevisionId])
}

model ProblemHackConfig {
  id                 String   @id
  problemId          String   @unique
  enabled            Boolean  @default(false)
  mode               String   @default("acm")
  standardSource     String   @db.Text
  standardLanguage   String   @default("cpp17")
  validatorSource    String   @db.Text
  validatorLanguage  String   @default("cpp17")
  classifierSource   String   @default("") @db.Text
  classifierLanguage String   @default("cpp17")
  revision           Int      @default(1)
  updatedBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  Problem            Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([updatedBy])
}

model ProblemHackAttempt {
  id                    String                  @id
  problemId             String
  userId                String
  status                String                  @default("queuing")
  inputMode             String
  inputData             String?                 @db.Text
  generatorSource       String?                 @db.Text
  generatorLanguage     String?
  hackSource            String                  @db.Text
  hackLanguage          String
  hackConfigRevision    Int
  judgeConfigHash       String
  baselineResult        String?
  baselineScore         Int?
  candidateResult       String?
  candidateScore        Int?
  scoreDelta            Int?
  affectedSubtaskIds    String?
  acceptedTestcaseId    String?
  testGraphRevision     Int                     @default(0)
  baseTestSetRevisionId String?
  candidateTestcaseId   String?
  promotedRevisionId    String?
  canonicalStatus       String?
  promotionRetries      Int                     @default(0)
  failureStage          String?
  message               String?                 @db.Text
  inputSha256           String?
  outputSha256          String?
  acceptedInputFile     String?
  acceptedOutputFile    String?
  judgeId               String?
  judgeStarted          DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  finishedAt            DateTime?
  Problem               Problem                 @relation(fields: [problemId], references: [id], onDelete: Cascade)
  User                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  BaseTestSetRevision   ProblemTestSetRevision? @relation("HackBaseTestSetRevision", fields: [baseTestSetRevisionId], references: [id], onDelete: SetNull)
  PromotedRevision      ProblemTestSetRevision? @relation("HackPromotedTestSetRevision", fields: [promotedRevisionId], references: [id], onDelete: SetNull)
  Candidate             TestcaseCandidate?

  @@index([problemId, status, createdAt])
  @@index([status, judgeId])
  @@index([userId, problemId, createdAt])
  @@index([baseTestSetRevisionId])
  @@index([promotedRevisionId])
}

model TestcaseCandidate {
  id                     String                  @id
  problemId              String
  hackAttemptId          String?                 @unique
  source                 String                  @default("hack")
  status                 TestcaseCandidateStatus @default(VALIDATED)
  baseTestSetRevisionId  String?
  inputObjectId          String?
  outputObjectId         String?
  inputSha256            String
  outputSha256           String
  inputSize              Int
  outputSize             Int
  inputFileName          String
  outputFileName         String
  affectedSubtaskIds     String?
  createdBy              String
  promotedTestcaseId     String?
  promotedRevisionId     String?
  message                String?                 @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  promotedAt             DateTime?
  Problem                Problem                 @relation(fields: [problemId], references: [id], onDelete: Cascade)
  HackAttempt            ProblemHackAttempt?     @relation(fields: [hackAttemptId], references: [id], onDelete: SetNull)
  BaseTestSetRevision    ProblemTestSetRevision? @relation("CandidateBaseTestSetRevision", fields: [baseTestSetRevisionId], references: [id], onDelete: SetNull)
  InputObject            TestdataObject?         @relation("CandidateInputObject", fields: [inputObjectId], references: [id], onDelete: Restrict)
  OutputObject           TestdataObject?         @relation("CandidateOutputObject", fields: [outputObjectId], references: [id], onDelete: Restrict)
  PromotedRevision       ProblemTestSetRevision? @relation("CandidatePromotedRevision", fields: [promotedRevisionId], references: [id], onDelete: SetNull)

  @@index([problemId, status, createdAt])
  @@index([baseTestSetRevisionId])
  @@index([inputObjectId])
  @@index([outputObjectId])
  @@index([promotedRevisionId])
}

model ProblemAttachment {
  id          String   @id
  problemId   String
  fileName    String
  fileSize    Int
  fileUrl     String
  description String?
  uploadedAt  DateTime @default(now())
  Problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model ProblemChecker {
  id         String   @id
  problemId  String
  fileName   String
  fileSize   Int
  fileUrl    String
  language   String?
  uploadedAt DateTime @default(now())
  Problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, fileName])
  @@index([problemId])
}

model ProblemList {
  id                 String               @id
  title              String
  description        String?
  coverUrl           String?
  organizationId     String?
  ownerId            String
  ownerType          String               @default("teacher")
  scope              String               @default("campus")
  visibility         String               @default("private")
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  ProblemListSection ProblemListSection[]
  ProblemListShare   ProblemListShare[]
  SchoolProblemList  SchoolProblemList[]
  TeamProblemList    TeamProblemList[]
  Organization       Organization?        @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
  @@index([ownerId, ownerType])
  @@index([organizationId])
  @@index([scope])
  @@index([scope, ownerId])
  @@index([visibility])
}

model PersonalProfile {
  userId    String   @id
  rating    Int      @default(1200)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
}

model ProblemListEntry {
  id                 String             @id
  sectionId          String
  problemId          String
  sortOrder          Int                @default(0)
  alias              String?
  notes              String?
  ojName             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now())
  Problem            Problem            @relation(fields: [problemId], references: [id])
  ProblemListSection ProblemListSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, problemId])
  @@index([problemId])
  @@index([sectionId])
}

model ProblemListSection {
  id               String             @id
  problemListId    String
  title            String
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now())
  ProblemListEntry ProblemListEntry[]
  ProblemList      ProblemList        @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@index([problemListId])
}

model ProblemListShare {
  id            String      @id
  problemListId String
  targetType    String
  targetId      String
  permission    String      @default("view")
  sharedBy      String
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@unique([problemListId, targetType, targetId])
  @@index([sharedBy])
  @@index([targetType, targetId])
}

model ProblemNote {
  id        String   @id
  problemId String
  userId    String
  userType  String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId, userType])
  @@index([updatedAt])
  @@index([userId])
}

model ProblemStatement {
  id        String   @id
  problemId String
  type      String
  format    String
  language  String?
  content   String?
  fileUrl   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, type, format, language])
  @@index([problemId, type])
}

model UserProblemContent {
  id                   String    @id
  problemId            String
  userId               String
  kind                 String
  name                 String?
  nameKey              String?
  title                String?
  format               String
  language             String?
  content              String?   @db.Text
  fileId               String?
  visibility           String    @default("private")
  sourceType           String    @default("blank")
  sourceId             String?
  sourceNameSnapshot   String?
  sourceAuthorSnapshot String?
  revision             Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  Problem              Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  User                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([problemId, kind, visibility, deletedAt])
  @@index([problemId, userId, kind, nameKey])
  @@index([userId, updatedAt])
}

model School {
  id                           String        @id
  name                         String
  shortName                    String?
  description                  String?
  announcement                 String?
  region                       String?
  schoolType                   String?
  schoolNature                 String?
  educationSystem              String?       @default("6-3-3")
  educationSystemDetail        Json?
  informaticsEnabled           Boolean       @default(false)
  informaticsStages            Json?
  informaticsContests          Json?
  informaticsTracks            Json?
  contactPerson                String?
  contactPhone                 String?
  contactEmail                 String?
  status                       String        @default("active")
  currentPrincipalMembershipId String?       @unique
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @default(now())
  organizationId               String?       @unique
  Organization                 Organization? @relation(fields: [organizationId], references: [id])
}

model Organization {
  id                       String                                @id
  name                     String
  type                     String                                @default("school")
  status                   String                                @default("active")
  description              String?
  createdAt                DateTime                              @default(now())
  updatedAt                DateTime                              @updatedAt
  School                   School?
  Membership               OrganizationMembership[]
  CaritsAccount            CaritsAccount?                        @relation("CaritsAccountOrganization")
  CaritsTransactions       CaritsTransaction[]                   @relation("CaritsTransactionOrganization")
  ContributionAttributions OrganizationContributionAttribution[]
  ContributionProjects     ContributionProject[]
  PrincipalTransferLog     PrincipalTransferLog[]
  Problem                  Problem[]
  ProblemList              ProblemList[]
  SchoolProblemList        SchoolProblemList[]
  Team                     Team[]
  Training                 Training[]
  Submission               Submission[]

  @@index([type, status])
}

model OrganizationMembership {
  id                       String                      @id
  organizationId           String
  userId                   String
  memberRole               String
  relationType             String
  status                   String                      @default("active")
  invitedBy                String?
  joinedAt                 DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  Organization             Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  User                     User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  StudentProfile           OrganizationStudentProfile?
  TeacherProfile           OrganizationTeacherProfile?
  StudentMilestones        Milestone[]                 @relation("MilestoneStudentMembership")
  TeacherMilestones        Milestone[]                 @relation("MilestoneTeacherMembership")
  FormerPrincipalTransfers PrincipalTransferLog[]      @relation("FormerPrincipalMembership")
  NewPrincipalTransfers    PrincipalTransferLog[]      @relation("NewPrincipalMembership")

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

model OrganizationStudentProfile {
  id                      String                      @id
  membershipId            String                      @unique
  name                    String
  gender                  String?
  enrollmentYear          Int?
  targetContest           String?
  headTeacherMembershipId String?
  tags                    String?
  notes                   String?
  avatar                  String?
  rating                  Int                         @default(1200)
  status                  String                      @default("active")
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  Membership              OrganizationMembership      @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  ContestProblemScores    ContestProblemScore[]       @relation("ContestProblemScoreStudentProfile")
