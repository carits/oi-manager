}

model ProblemTestSetRevisionGroup {
  id          String                            @id
  revisionId  String
  subtaskId   String
  key         String
  name        String
  kind        String
  score       Int                               @default(0)
  aggregation String                            @default("min")
  orderIndex  Int                               @default(0)
  Revision    ProblemTestSetRevision            @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  Subtask     ProblemTestSetRevisionSubtask     @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  Cases       ProblemTestSetRevisionGroupCase[]

  @@unique([subtaskId, key])
  @@index([revisionId, kind])
