generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JudgeRunType {
  NORMAL
  REJUDGE
  HACK_REJUDGE
  MANUAL
  MIGRATION_VERIFY
}

enum JudgeRunStatus {
  QUEUED
  RUNNING
  FINALIZED
  CANCELLED
}

enum JudgeAttemptState {
  QUEUED
  CLAIMED
  COMPILING
  RUNNING
  FINALIZING
  SUCCEEDED
  USER_ERROR
  INFRA_ERROR
  CANCELLED
}

enum RejudgeBatchStatus {
  CREATED
  QUEUING
  COMPLETED
  FAILED
  CANCELLED
}

enum TestcaseCandidateStatus {
  VALIDATED
  PROMOTING
  PROMOTED
  REDUNDANT
  REJECTED
  FAILED
  STALE
  UPLOADED
  ADMITTED
  VALIDATING
  EVALUATING_L1
  EVALUATING_L2
  EVALUATING_HOLDOUT
  ELIGIBLE
  ELIGIBLE_NOT_SELECTED
  WAITING_REPLACEMENT
  SELECTED
  EXPIRED
}

model AiUsageLog {
  id               String   @id
  userId           String
  problemId        String
  action           String
  sourceLang       String?
  targetLang       String?
  model            String?
  tokensUsed       Int      @default(0)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  requestId        String?
  status           String   @default("success")
  message          String?
  createdAt        DateTime @default(now())
  statementId      String?

  @@index([userId, createdAt])
  @@index([userId, problemId, action, createdAt])
  @@index([requestId])
}

model AiTokenPool {
  id              String   @id
  availableTokens BigInt   @default(0)
  reservedTokens  BigInt   @default(0)
  consumedTokens  BigInt   @default(0)
  version         Int      @default(0)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiTokenLedgerEntry {
  id             String   @id
  poolId         String
  type           String
  amount         BigInt
  availableAfter BigInt
  reservedAfter  BigInt
  consumedAfter  BigInt
  idempotencyKey String   @unique
  requestId      String?
  operatorUserId String?
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([poolId, createdAt])
  @@index([requestId])
}

model AiGenerationRequest {
  id               String    @id
  userId           String
  problemId        String
  statementId      String?
  action           String
  model            String
  status           String    @default("queued")
  parentRequestId  String?
  repairDepth      Int       @default(0)
  reservedTokens   Int       @default(0)
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  promptHash       String
  response         Json?
  errorCode        String?
  errorMessage     String?   @db.Text
  compileStatus    String?
  compileMessage   String?   @db.Text
  programVersionId String?
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  @@index([userId, createdAt])
  @@index([problemId, createdAt])
  @@index([status, createdAt])
  @@index([parentRequestId])
}

model Contest {
  id                  String                @id
  title               String
  description         String?
  contestDate         DateTime
  status              String                @default("upcoming")
  type                String                @default("mock")
  teamId              String?
  countRating         Boolean               @default(false)
  scope               String                @default("public")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  Team                Team?                 @relation(fields: [teamId], references: [id])
  ContestProblem      ContestProblem[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]
  ContestResult       ContestResult[]

  @@index([contestDate])
  @@index([scope])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
}

model ContestProblem {
  id                  String                @id
  contestId           String
  orderIndex          Int
  title               String?
  description         String?
  ojName              String?
  problemId           String?
  isCustom            Boolean               @default(false)
  difficulty          String?
  points              Int?
  statementType       String                @default("none")
  statementMarkdown   String?
  solutionType        String                @default("none")
  solutionMarkdown    String?
  solutionVisible     Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  Contest             Contest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]

  @@unique([contestId, orderIndex])
}

model ContestProblemScore {
  id                         String                     @id
  contestId                  String
  problemId                  String
  studentProfileId           String
  studentNameSnapshot        String
  usernameSnapshot           String
  score                      Float?
  note                       String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @default(now())
  Contest                    Contest                    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem             ContestProblem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  OrganizationStudentProfile OrganizationStudentProfile @relation("ContestProblemScoreStudentProfile", fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([contestId, problemId, studentProfileId])
  @@index([studentProfileId])
}

model ContestRecord {
  id         String   @id
  trainingId Int
  userId     String
  userType   String
  content    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, userType])
  @@index([updatedAt])
  @@index([userId])
}

model ContestResource {
  id               String          @id
  contestId        String
  contestProblemId String?
  fileName         String
  fileType         String
  fileFormat       String          @default("pdf")
  fileUrl          String
  visibleRoles     String          @default("all")
  uploadedBy       String
  uploadedAt       DateTime        @default(now())
  Contest          Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem   ContestProblem? @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
}

model ContestResult {
  id                         String                     @id
  contestId                  String
  studentProfileId           String
  studentNameSnapshot        String
  usernameSnapshot           String
  rank                       Int?
  score                      Float?
  ratingBefore               Int
  ratingAfter                Int
  ratingChange               Int
  note                       String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @default(now())
  Contest                    Contest                    @relation(fields: [contestId], references: [id], onDelete: Cascade)
  OrganizationStudentProfile OrganizationStudentProfile @relation("ContestResultStudentProfile", fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([contestId, studentProfileId])
  @@index([createdAt])
  @@index([studentProfileId])
}

model ContestUserProblemStatus {
  id               String          @id
  contestId        Int
  userId           String
  contestProblemId String
  bestScore        Int?
  bestResult       String?
  attemptCount     Int             @default(0)
  acAt             DateTime?
  frozenScore      Int?
  frozenResult     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now())
  Training         Training        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  TrainingProblem  TrainingProblem @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
  User             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId, contestProblemId])
  @@index([contestId, userId])
  @@index([userId])
}

model File {
  id           String    @id
  storageType  String    @default("local")
  disk         String    @default("default")
  relativePath String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  md5Hash      String?
  sha256Hash   String?
  accessLevel  String    @default("private")
  isPublic     Boolean   @default(false)
  ownerType    String
  ownerId      String
  category     String
  status       String    @default("active")
  deletedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now())

  @@index([category])
  @@index([md5Hash])
  @@index([ownerType, ownerId])
  @@index([status, deletedAt])
  @@index([storageType, disk])
}

model LoginLog {
  id            String   @id
  userId        String?
  username      String
  loginRole     String
  userRole      String?
  result        String
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([result])
  @@index([username])
}

model Milestone {
  id                  String                 @id
  studentMembershipId String
  teacherMembershipId String
  studentNameSnapshot String
  teacherNameSnapshot String
  title               String
  description         String?
  milestoneDate       DateTime
  type                String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @default(now())
  StudentMembership   OrganizationMembership @relation("MilestoneStudentMembership", fields: [studentMembershipId], references: [id], onDelete: Restrict)
  TeacherMembership   OrganizationMembership @relation("MilestoneTeacherMembership", fields: [teacherMembershipId], references: [id], onDelete: Restrict)

  @@index([milestoneDate])
  @@index([studentMembershipId])
  @@index([teacherMembershipId])
}

model OjAccount {
  id                          String       @id
  platform                    String
  username                    String
  password                    String?
  passwordIV                  String?
  cookie                      String?
  cookieRaw                   String?
  status                      String       @default("unverified")
  lastVerifiedAt              DateTime?
  lastErrorMessage            String?
  loginMethod                 String       @default("cookie")
  addedBy                     String
  lastLoginAt                 DateTime?
  lastLoginFailureAt          DateTime?
  lastSubmitAt                DateTime?
  lastRateLimitAt             DateTime?
  consecutiveFailures         Int          @default(0)
  rateLimitCount              Int          @default(0)
  totalSubmissions            Int          @default(0)
  totalSubmissionErrors       Int          @default(0)
  enabled                     Boolean      @default(true)
  priority                    Int          @default(0)
  maxConsecutiveFailures      Int          @default(3)
  freezeDurationMinutes       Int          @default(30)
  submitMaxRetries            Int          @default(1)
  retryIntervalSeconds        Int          @default(10)
  minSubmitIntervalSeconds    Int          @default(30)
  minRequestIntervalSeconds   Int          @default(3)
  maxConcurrentSubmissions    Int          @default(1)
  maxConcurrentRequests       Int          @default(2)
  loginFailureCooldownMinutes Int          @default(15)
  cookieValidMinutes          Int          @default(3600)
  renewLoginThresholdMinutes  Int          @default(10)
  reverifyIntervalMinutes     Int          @default(30)
  autoVerifyIntervalMinutes   Int          @default(1440)
  firstPollDelaySeconds       Int          @default(5)
  pollIntervalSeconds         Int          @default(5)
  maxWaitDurationMinutes      Int          @default(10)
  rateLimitThreshold          Int          @default(2)
  banSuspicionCooldownHours   Int          @default(6)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @default(now())
  Submission                  Submission[]

  @@unique([platform, username])
  @@index([platform])
  @@index([status])
}

model OjFetchJob {
  id               String   @id
  platform         String
  problemId        String
  status           String   @default("pending")
  message          String?
  hasAttachment    Boolean  @default(false)
  attachmentStatus String?
  createdProblemId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@unique([platform, problemId])
  @@index([createdAt])
  @@index([status])
}

model OjPlatformConfig {
  id         String    @id
  platform   String    @unique
  cookies    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now())
}

model PasswordResetLog {
  id           String   @id
  operatorRole String
  resetMethod  String
  result       String
  message      String?
  createdAt    DateTime @default(now())
  operatorId   String
  targetId     String
}

model PrincipalTransferLog {
  id                       String                  @id
  organizationId           String
  oldPrincipalMembershipId String?
  newPrincipalMembershipId String
  oldPrincipalNameSnapshot String?
  newPrincipalNameSnapshot String
  result                   String
  message                  String?
  createdAt                DateTime                @default(now())
  operatorId               String
  Organization             Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  OldPrincipalMembership   OrganizationMembership? @relation("FormerPrincipalMembership", fields: [oldPrincipalMembershipId], references: [id], onDelete: Restrict)
  NewPrincipalMembership   OrganizationMembership  @relation("NewPrincipalMembership", fields: [newPrincipalMembershipId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([oldPrincipalMembershipId])
  @@index([newPrincipalMembershipId])
}

model Problem {
  id                                 String                               @id
  platform                           String
  problemId                          String
  title                              String
  description                        String?
  statementType                      String                               @default("none")
  statementPdfUrl                    String?
  solutionType                       String                               @default("none")
  solutionMarkdown                   String?
  solutionPdfUrl                     String?
  solutionVisible                    Boolean                              @default(false)
  difficulty                         String?
  timeLimit                          Int?
  memoryLimit                        Int?
  judgeConfig                        String?
  problemType                        String                               @default("default")
  visibility                         String                               @default("private")
  ownerType                          String                               @default("teacher")
  ownerId                            String
  libraryScope                       String                               @default("platform")
  libraryKey                         String                               @default("platform")
  organizationId                     String?
  sourceProblemId                    String?
  status                             String                               @default("draft")
  publishedAt                        DateTime?
  createdAt                          DateTime                             @default(now())
  updatedAt                          DateTime                             @default(now())
  testGraphRevision                  Int                                  @default(0)
  latestTestSetRevisionId            String?
  allowedLanguages                   String?
  ojBindings                         String?
  ProblemAttachment                  ProblemAttachment[]
  ProblemListEntry                   ProblemListEntry[]
  ProblemNote                        ProblemNote[]
  ProblemStatement                   ProblemStatement[]
  UserProblemContent                 UserProblemContent[]
  TestdataFile                       TestdataFile[]
  ProblemChecker                     ProblemChecker[]
  ProblemHackConfig                  ProblemHackConfig?
  ProblemHackAttempt                 ProblemHackAttempt[]
  ProblemJudgeProgram                ProblemJudgeProgram[]
  ProblemJudgeProgramDraft           ProblemJudgeProgramDraft[]
  ProblemJudgeProgramFixtureSet      ProblemJudgeProgramFixtureSet[]
  ProblemJudgeProgramVerificationJob ProblemJudgeProgramVerificationJob[]
  ProblemJudgeProgramAuditLog        ProblemJudgeProgramAuditLog[]
  ProblemDataGenerationJob           ProblemDataGenerationJob[]
  TestcaseCandidate                  TestcaseCandidate[]
  ProblemTestcase                    ProblemTestcase[]
  ProblemSubtask                     ProblemSubtask[]
  ProblemTestGroup                   ProblemTestGroup[]
  TestdataObject                     TestdataObject[]
  TestSetRevision                    ProblemTestSetRevision[]             @relation("ProblemTestSetRevisions")
  LatestTestSetRevision              ProblemTestSetRevision?              @relation("ProblemLatestTestSetRevision", fields: [latestTestSetRevisionId], references: [id], onDelete: SetNull)
  TrainingProblem                    TrainingProblem[]
  TrainingSessionStageProblem        TrainingSessionStageProblem[]
  Owner                              User                                 @relation("ProblemOwner", fields: [ownerId], references: [id])
  Organization                       Organization?                        @relation(fields: [organizationId], references: [id])
  SourceProblem                      Problem?                             @relation("ProblemCopies", fields: [sourceProblemId], references: [id], onDelete: SetNull)
  CopiedProblems                     Problem[]                            @relation("ProblemCopies")

  @@unique([libraryKey, platform, problemId])
  @@index([createdAt])
  @@index([libraryScope, status])
  @@index([ownerId, ownerType])
  @@index([organizationId, status])
  @@index([sourceProblemId])
  @@index([visibility])
  @@index([visibility, status])
  @@index([latestTestSetRevisionId])
}

model ProblemHackConfig {
  id                         String   @id
  problemId                  String   @unique
  enabled                    Boolean  @default(false)
  mode                       String   @default("acm")
  standardSource             String   @db.Text
  standardLanguage           String   @default("cpp17")
  validatorSource            String   @db.Text
  validatorLanguage          String   @default("cpp17")
  classifierSource           String   @default("") @db.Text
  classifierLanguage         String   @default("cpp17")
  standardProgramVersionId   String?
  validatorProgramVersionId  String?
  classifierProgramVersionId String?
  revision                   Int      @default(1)
  updatedBy                  String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  Problem                    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([updatedBy])
}

model ProblemJudgeProgram {
  id               String                               @id
  problemId        String
  kind             String
  name             String
  language         String
  currentVersionId String?
  status           String                               @default("active")
  createdBy        String
  createdAt        DateTime                             @default(now())
  updatedAt        DateTime                             @updatedAt
  Problem          Problem                              @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Versions         ProblemJudgeProgramVersion[]
  Drafts           ProblemJudgeProgramDraft[]
  FixtureSets      ProblemJudgeProgramFixtureSet[]
  VerificationJobs ProblemJudgeProgramVerificationJob[]
  AuditLogs        ProblemJudgeProgramAuditLog[]

  @@unique([problemId, kind, name])
  @@index([problemId, kind, status])
  @@index([currentVersionId])
}

model ProblemJudgeProgramVersion {
  id               String                               @id
  programId        String
  problemId        String
  versionNumber    Int
  language         String
  source           String                               @db.Text
  sourceSha256     String
  origin           String                               @default("manual")
  aiRequestId      String?
  compileStatus    String
  compileMessage   String?                              @db.Text
  protocol         String                               @default("legacy")
  protocolVersion  Int                                  @default(1)
  templateId       String?
  templateVersion  Int?
  lifecycleStatus  String                               @default("compiled")
  runtimeMetadata  Json?
  protocolConfig   Json?
  preflightReport  Json?
  fixtureSetId     String?
  verifiedAt       DateTime?
  activatedAt      DateTime?
  createdBy        String
  createdAt        DateTime                             @default(now())
  Program          ProblemJudgeProgram                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  FixtureSet       ProblemJudgeProgramFixtureSet?       @relation("ProgramVersionFixtureSet", fields: [fixtureSetId], references: [id], onDelete: SetNull)
  VerificationJobs ProblemJudgeProgramVerificationJob[]
  AuditLogs        ProblemJudgeProgramAuditLog[]

  @@unique([programId, versionNumber])
  @@index([problemId, createdAt])
  @@index([problemId, lifecycleStatus, createdAt])
  @@index([fixtureSetId])
  @@index([aiRequestId])
}

model ProblemJudgeProgramDraft {
  id              String               @id
  problemId       String
  programId       String?
  userId          String
  kind            String
  name            String
  language        String
  protocol        String
  templateId      String?
  templateVersion Int?
  source          String               @db.Text
  protocolConfig  Json?
  fixtures        Json
  revision        Int                  @default(1)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  Problem         Problem              @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Program         ProblemJudgeProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId, kind])
  @@index([programId])
  @@index([userId, updatedAt])
}

model ProblemJudgeProgramFixtureSet {
  id               String                               @id
  problemId        String
  programId        String
  revision         Int
  fixtures         Json
  fixtureHash      String
  createdBy        String
  createdAt        DateTime                             @default(now())
  Problem          Problem                              @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Program          ProblemJudgeProgram                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  Versions         ProblemJudgeProgramVersion[]         @relation("ProgramVersionFixtureSet")
  VerificationJobs ProblemJudgeProgramVerificationJob[]

  @@unique([programId, revision])
  @@index([problemId, createdAt])
  @@index([fixtureHash])
}

model ProblemJudgeProgramVerificationJob {
  id             String                        @id
  problemId      String
  programId      String
  versionId      String
  fixtureSetId   String
  mode           String
  status         String                        @default("queued")
  judgeId        String?
  fencingToken   String?                       @unique
  leaseExpiresAt DateTime?
  attemptCount   Int                           @default(0)
  report         Json?
  errorCode      String?
  errorMessage   String?                       @db.Text
  createdBy      String
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  Problem        Problem                       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Program        ProblemJudgeProgram           @relation(fields: [programId], references: [id], onDelete: Cascade)
  Version        ProblemJudgeProgramVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  FixtureSet     ProblemJudgeProgramFixtureSet @relation(fields: [fixtureSetId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([problemId, createdAt])
  @@index([programId, versionId])
  @@index([judgeId, status])
}

model ProblemJudgeProgramAuditLog {
  id          String                      @id
  problemId   String
  programId   String
  versionId   String?
  actorUserId String
  action      String
  metadata    Json?
  createdAt   DateTime                    @default(now())
  Problem     Problem                     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Program     ProblemJudgeProgram         @relation(fields: [programId], references: [id], onDelete: Cascade)
  Version     ProblemJudgeProgramVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([problemId, createdAt])
  @@index([programId, createdAt])
  @@index([versionId])
  @@index([actorUserId, createdAt])
}

model ProblemDataGenerationJob {
  id                       String                      @id
  problemId                String
  createdBy                String
  status                   String                      @default("queued")
  baseTestSetRevisionId    String?
  expectedLatestRevisionId String?
  generatorVersionId       String?
  standardVersionId        String
  validatorVersionId       String
  config                   Json
  judgeId                  String?
  fencingToken             String?                     @unique
  leaseExpiresAt           DateTime?
  startedAt                DateTime?
  finishedAt               DateTime?
  promotedRevisionId       String?
  errorCode                String?
  errorMessage             String?                     @db.Text
  contribution             Boolean                     @default(false)
  targetRole               String                      @default("official")
  reservedCredits          Int                         @default(0)
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  Problem                  Problem                     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Cases                    ProblemDataGenerationCase[]

  @@index([problemId, createdAt])
  @@index([status, createdAt])
  @@index([judgeId, status])
}

model ProblemDataGenerationCase {
  id                 String                   @id
  jobId              String
  problemId          String
  orderIndex         Int
  name               String
  args               Json
  seed               String?
  status             String                   @default("queued")
  failureStage       String?
  message            String?                  @db.Text
  inputObjectId      String?
  outputObjectId     String?
  inputSha256        String?
  outputSha256       String?
  inputSize          Int?
  outputSize         Int?
  inputPreview       String?                  @db.Text
  outputPreview      String?                  @db.Text
  generatorTimeMs    Int?
  validatorTimeMs    Int?
  standardTimeMs     Int?
  promotedTestcaseId String?
  candidateId        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  Job                ProblemDataGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, orderIndex])
  @@index([problemId, status])
  @@index([inputSha256])
  @@index([candidateId])
}

model ProblemHackAttempt {
  id                    String                  @id
  problemId             String
  userId                String
  status                String                  @default("queuing")
  inputMode             String
  inputData             String?                 @db.Text
  generatorSource       String?                 @db.Text
  generatorLanguage     String?
  generatorProtocol     String?
  hackSource            String                  @db.Text
  hackLanguage          String
  inputFilename         String?
  outputFilename        String?
  hackConfigRevision    Int
  judgeConfigHash       String
  baselineResult        String?
  baselineScore         Int?
  candidateResult       String?
  candidateScore        Int?
  scoreDelta            Int?
  affectedSubtaskIds    String?
  acceptedTestcaseId    String?
  testGraphRevision     Int                     @default(0)
  baseTestSetRevisionId String?
  candidateTestcaseId   String?
  promotedRevisionId    String?
  canonicalStatus       String?
  promotionRetries      Int                     @default(0)
  failureStage          String?
  message               String?                 @db.Text
  inputSha256           String?
  outputSha256          String?
  acceptedInputFile     String?
  acceptedOutputFile    String?
  judgeId               String?
  judgeStarted          DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  finishedAt            DateTime?
  Problem               Problem                 @relation(fields: [problemId], references: [id], onDelete: Cascade)
  User                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  BaseTestSetRevision   ProblemTestSetRevision? @relation("HackBaseTestSetRevision", fields: [baseTestSetRevisionId], references: [id], onDelete: SetNull)
  PromotedRevision      ProblemTestSetRevision? @relation("HackPromotedTestSetRevision", fields: [promotedRevisionId], references: [id], onDelete: SetNull)
  Candidate             TestcaseCandidate?

  @@index([problemId, status, createdAt])
