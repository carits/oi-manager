  score             Int?
  cases             String?
  subtasks          String?
  errorMessage      String?
  timeUsed          Int?
  wallTimeUsed      Int?
  memoryUsed        Int?
  timeoutReason     String?
  metricSource      String?
  queueLatencyMs    Int?
  dispatchLatencyMs Int?
  compileLatencyMs  Int?
  runLatencyMs      Int?
  persistLatencyMs  Int?
  totalLatencyMs    Int?
  createdAt         DateTime          @default(now())
  claimedAt         DateTime?
  startedAt         DateTime?
  finalizedAt       DateTime?
  updatedAt         DateTime          @updatedAt
