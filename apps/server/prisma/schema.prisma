generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt
  User      User     @relation(fields: [userId], references: [id])
}

model Contest {
  id                  String                @id @default(uuid())
  title               String
  description         String?
  contestDate         DateTime
  status              String                @default("upcoming")
  type                String                @default("mock")
  teamId              String?
  countRating         Boolean               @default(false)
  scope               String                @default("public")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime  @updatedAt
  Team                Team?                 @relation(fields: [teamId], references: [id])
  ContestProblem      ContestProblem[]
  ContestProblemNote  ContestProblemNote[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]
  ContestResult       ContestResult[]

  @@index([teamId])
  @@index([status])
  @@index([scope])
  @@index([contestDate])
  @@index([teamId, status])
}

model ContestProblem {
  id                  String                @id @default(uuid())
  contestId           String
  orderIndex          Int
  title               String?
  description         String?
  ojName              String?
  problemId           String?
  isCustom            Boolean               @default(false)
  difficulty          String?
  points              Int?
  statementType       String                @default("none")
  statementMarkdown   String?
  solutionType        String                @default("none")
  solutionMarkdown    String?
  solutionVisible     Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime  @updatedAt
  Contest             Contest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblemNote  ContestProblemNote[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]

  @@unique([contestId, orderIndex])
}

model ContestProblemNote {
  id             String         @id @default(uuid())
  contestId      String
  problemId      String
  studentId      String
  content        String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime  @updatedAt
  Contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId, studentId])
  @@index([studentId])
  @@index([updatedAt])
}

model ContestProblemScore {
  id             String         @id @default(uuid())
  contestId      String
  problemId      String
  studentId      String
  score          Float?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime  @updatedAt
  Contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId, studentId])
}

model ContestResource {
  id               String          @id @default(uuid())
  contestId        String
  contestProblemId String?
  fileName         String
  fileType         String
  fileFormat       String          @default("pdf")
  fileUrl          String
  visibleRoles     String          @default("all")
  uploadedBy       String
  uploadedAt       DateTime        @default(now())
  Contest          Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem   ContestProblem? @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
}

model ContestResult {
  id           String   @id @default(uuid())
  contestId    String
  studentId    String
  rank         Int?
  score        Float?
  ratingBefore Int
  ratingAfter  Int
  ratingChange Int
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime  @updatedAt
  Contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  Student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, studentId])
  @@index([studentId])
  @@index([createdAt])
}

model File {
  id           String    @id @default(uuid())
  storageType  String    @default("local")
  disk         String    @default("default")
  relativePath String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  md5Hash      String?
  sha256Hash   String?
  accessLevel  String    @default("private")
  isPublic     Boolean   @default(false)
  ownerType    String
  ownerId      String
  category     String
  status       String    @default("active")
  deletedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category])
  @@index([status, deletedAt])
  @@index([md5Hash])
  @@index([ownerType, ownerId])
  @@index([storageType, disk])
}

model LoginLog {
  id            String   @id @default(uuid())
  userId        String?
  username      String
  loginRole     String
  userRole      String?
  result        String
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([username])
  @@index([result])
  @@index([createdAt])
}

model Milestone {
  id            String   @id @default(uuid())
  studentId     String
  teacherId     String
  title         String
  description   String?
  milestoneDate DateTime
  type          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime  @updatedAt
  Student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Teacher       Teacher  @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([teacherId])
  @@index([milestoneDate])
}

model OjFetchJob {
  id               String   @id @default(uuid())
  platform         String
  problemId        String
  status           String   @default("pending")
  message          String?
  hasAttachment    Boolean  @default(false)
  attachmentStatus String?
  createdProblemId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([platform, problemId])
  @@index([status])
  @@index([createdAt])
}

model OjPlatformConfig {
  id         String    @id @default(uuid())
  platform   String    @unique
  cookies    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PasswordResetLog {
  id             String   @id @default(uuid())
  targetUserId   String
  operatorUserId String
  operatorRole   String
  resetMethod    String
  result         String
  message        String?
  createdAt      DateTime @default(now())
}

model PrincipalTransferLog {
  id                    String   @id @default(uuid())
  schoolId              String
  oldPrincipalTeacherId String?
  newPrincipalTeacherId String
  operatorUserId        String
  result                String
  message               String?
  createdAt             DateTime @default(now())
  School                School   @relation(fields: [schoolId], references: [id])
}

model Problem {
  id                String              @id @default(uuid())
  platform          String              // 主平台标识（universaloj, qoj, luogu, carits 等）
  problemId         String              // 原始题号（60, P1001, P000001 等，不拼接）
  title             String
  description       String?
  statementType     String              @default("none")
  statementPdfUrl   String?
  solutionType      String              @default("none")
  solutionMarkdown  String?
  solutionPdfUrl    String?
  solutionVisible   Boolean             @default(false)
  difficulty        String?
  timeLimit         Int?
  memoryLimit       Int?
  judgeConfig       String?
  visibility        String              @default("private")
  ownerType         String              @default("teacher")
  ownerId           String
  status            String              @default("draft")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime  @updatedAt
  ojBindings        String?
  ProblemAttachment ProblemAttachment[]
  ProblemListEntry  ProblemListEntry[]
  ProblemNote       ProblemNote[]
  ProblemStatement  ProblemStatement[]

  @@unique([platform, problemId])
  @@index([visibility])
  @@index([ownerId, ownerType])
  @@index([visibility, status])
  @@index([createdAt])
}

model ProblemAttachment {
  id          String   @id @default(uuid())
  problemId   String
  fileName    String
  fileSize    Int
  fileUrl     String
  description String?
  uploadedAt  DateTime @default(now())
  Problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model ProblemNote {
  id        String   @id @default(uuid())
  problemId String
  userId    String
  userType  String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId, userType])
  @@index([userId])
  @@index([updatedAt])
}

model ProblemStatement {
  id        String   @id @default(uuid())
  problemId String
  type      String
  format    String
  language  String?
  content   String?
  fileUrl   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, type, format, language])
  @@index([problemId, type])
}

model School {
  id                        String                 @id @default(uuid())
  name                      String
  announcement              String?
  region                    String?
  schoolType                String?
  educationSystem           String?                @default("6-3-3")
  contactPerson             String?
  contactPhone              String?
  contactEmail              String?
  status                    String                 @default("active")
  currentPrincipalTeacherId String
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime  @updatedAt
  PrincipalTransferLog      PrincipalTransferLog[]
  SchoolProblemLists        SchoolProblemList[]
  Student                   Student[]
  Teacher                   Teacher[]
  Team                      Team[]
}

model Student {
  id                        String                      @id @default(uuid())
  userId                    String                      @unique
  name                      String
  gender                    String?
  schoolId                  String
  enrollmentYear            Int?
  targetContest             String?
  headTeacherId             String?
  tags                      String?
  notes                     String?
  avatar                    String?
  rating                    Int                         @default(1200)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime  @updatedAt
  ContestProblemNote        ContestProblemNote[]
  ContestProblemScore       ContestProblemScore[]
  ContestResult             ContestResult[]
  Milestone                 Milestone[]
  TeamJoinRequest           TeamJoinRequest[]
  TeamMemberExternalAccount TeamMemberExternalAccount[]
  User                      User                        @relation(fields: [userId], references: [id])
  School                    School                      @relation(fields: [schoolId], references: [id])
  Teacher                   Teacher?                    @relation(fields: [headTeacherId], references: [id])

  @@index([schoolId])
  @@index([headTeacherId])
  @@index([rating])
  @@index([schoolId, headTeacherId])
  @@index([enrollmentYear])
}

model Teacher {
  id        String      @id @default(uuid())
  userId    String      @unique
  name      String
  email     String?
  phone     String?
  avatar    String?
  bio       String?
  title     String?
  status    String      @default("active")
  schoolId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime  @updatedAt
  Milestone Milestone[]
  Student   Student[]
  User      User        @relation(fields: [userId], references: [id])
  School    School?     @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([status])
  @@index([createdAt])
}

model Team {
  id                       String                       @id
  name                     String
  avatar                   String?
  description              String?
  announcement             String?
  schoolId                 String
  isPublic                 Boolean                      @default(true)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime  @updatedAt
  Contest                  Contest[]
  School                   School                       @relation(fields: [schoolId], references: [id])
  TeamJoinRequest          TeamJoinRequest[]
  TeamMember               TeamMember[]
  TeamMemberExternalAccount TeamMemberExternalAccount[]
  TeamMemberImportBatch    TeamMemberImportBatch[]
  TeamProblemLists         TeamProblemList[]

  @@index([schoolId])
  @@index([isPublic])
  @@index([schoolId, isPublic])
  @@index([createdAt])
}

model TeamJoinRequest {
  id          String    @id @default(uuid())
  teamId      String
  studentId   String
  status      String    @default("pending")
  message     String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  processedBy String?
  Student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Team        Team      @relation(fields: [teamId], references: [id])

  @@unique([teamId, studentId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  userType  String
  role      String
  status    String   @default("active")
  joinedAt  DateTime @default(now())
  invitedBy String?
  Team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, userType])
  @@index([teamId, status, role])
  @@index([userId, userType, status])
  @@index([teamId, role])
  @@index([status])
}

model TeamOperationLog {
  id           String   @id @default(uuid())
  teamId       String
  operatorId   String
  operatorType String
  action       String
  targetId     String?
  targetType   String?
  oldValue     String?
  newValue     String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([teamId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
}

model User {
  id               String                @id @default(uuid())
  username         String                @unique
  passwordHash     String
  role             String
  status           String                @default("active")
  avatar           String?
  phone            String?
  email            String?
  bio              String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime  @updatedAt
  Admin            Admin?
  Student          Student?
  Teacher          Teacher?
  PlatformBindings UserPlatformBinding[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model UserPlatformBinding {
  id               String    @id @default(uuid())
  userId           String
  platform         String
  platformUsername String?
  bindingStatus    String    @default("unbound")
  bindingData      String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  platformConfig   String?
  platformUid      String?
  statusMessage    String?
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
}

model UserStatusLog {
  id             String   @id @default(uuid())
  targetUserId   String
  operatorUserId String
  operatorRole   String
  oldStatus      String
  newStatus      String
  reason         String?
  createdAt      DateTime @default(now())
}

// ========== 团队导入相关模型 ==========

model TeamMemberExternalAccount {
  id               String   @id @default(uuid())
  teamId           String
  studentId        String?  // 可为空，未匹配到学生时
  platform         String   // vjudge | luogu | codeforces | atcoder
  platformUsername String   // 平台用户名
  displayName      String?  // 候选显示名（从姓名或用户名提取）
  status           String   @default("pending") // pending | invited | active | conflict
  inviteId         String?  // 关联的邀请ID（如果发送了邀请）
  createdAt        DateTime @default(now())
  updatedAt        DateTime  @updatedAt

  Team    Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  Student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@unique([teamId, platform, platformUsername]) // 同团队同平台同用户名唯一
  @@index([studentId])
  @@index([platform, platformUsername])
}

model TeamMemberImportBatch {
  id           String     @id @default(uuid())
  teamId       String?    // 可为空，不创建团队时为 null
  operatorId   String     // 操作人（教师ID）
  platform     String     // vjudge | luogu
  totalCount   Int        // 总条数
  successCount Int        @default(0)
  skipCount    Int        @default(0)
  errorCount   Int        @default(0)
  status       String     @default("pending") // pending | previewing | processing | completed | failed
  rawInput     String?    // 原始输入数据（JSON）
  createdAt    DateTime   @default(now())
  completedAt  DateTime?
  Items        TeamMemberImportItem[]

  Team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([operatorId])
}

model TeamMemberImportItem {
  id                   String    @id @default(uuid())
  batchId              String
  lineNumber           Int       // 原始行号
  rawUsername          String    // 原始平台用户名
  rawStudentName       String?   // 原始学生姓名
  parsedUsername       String?   // 清洗后的用户名
  candidateDisplayName String?   // 候选显示名

  matchType            String    // new_member | existing_member | same_name | conflict | invalid
  matchStatus          String    @default("pending") // pending | pending_confirm | invited | created | skipped | error
  matchedStudentId     String?   // 匹配到的学生ID
  matchedStudentName   String?   // 匹配到的学生姓名
  createdStudentId     String?   // 新创建的学生ID
  action               String?   // invite | create_and_invite | link_only | skip | manual_required
  userChoice           String?   // 用户选择: confirm | skip
  errorMessage         String?

  createdAt            DateTime  @default(now())
  processedAt          DateTime?

  Batch TeamMemberImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([matchType])
}

model AiUsageLog {
  id          String   @id @default(uuid())
  userId      String
  problemId   String
  action      String   // translate | format
  sourceLang  String?  // zh | en
  targetLang  String?  // zh | en
  model       String?  // deepseek-chat
  tokensUsed  Int      @default(0)
  status      String   @default("success") // success | failed | rate_limited
  message     String?
  createdAt   DateTime @default(now())

  @@index([userId, problemId, action, createdAt])
  @@index([userId, createdAt])
}

// ========== 题单管理（飞书文档式权限） ==========

/// 题单（文件夹/wiki 空间）
model ProblemList {
  id          String   @id
  title       String
  description String?
  coverUrl    String?
  schoolId    String?
  ownerId     String   // 创建者 userId（教师和学生均可创建）
  ownerType   String   @default("teacher") // teacher | student
  visibility  String   @default("private") // private | school
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Sections    ProblemListSection[]
  Shares      ProblemListShare[]
  SchoolProblemLists SchoolProblemList[]
  TeamProblemLists   TeamProblemList[]

  @@index([ownerId, ownerType])
  @@index([schoolId])
  @@index([visibility])
  @@index([createdAt])
}

/// 题单中的章节（二级标题，纯视觉分组）
model ProblemListSection {
  id             String   @id @default(uuid())
  problemListId  String
  title          String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ProblemList    ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  Entries        ProblemListEntry[]

  @@index([problemListId])
}

/// 题单中的题目条目（挂在章节下：题单 → 章节 → 题目）
model ProblemListEntry {
  id             String   @id @default(uuid())
  sectionId      String
  problemId      String   // 关联 Problem.id
  sortOrder      Int      @default(0)
  alias          String?  // 别名 A/B/C...（手动填写）
  notes          String?  // 备注（可为空）
  ojName         String?  // OJ 平台标识（carits, luogu, codeforces 等）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Section        ProblemListSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  Problem        Problem            @relation(fields: [problemId], references: [id])

  @@unique([sectionId, problemId])
  @@index([sectionId])
  @@index([problemId])
}

/// 题单级分享
model ProblemListShare {
  id             String   @id @default(uuid())
  problemListId  String
  targetType     String   // school | team | teacher | student
  targetId       String
  permission     String   @default("view") // view | edit | admin
  sharedBy       String   // 分享人 userId
  createdAt      DateTime @default(now())

  ProblemList    ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@unique([problemListId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([sharedBy])
}

// ========== 学校题单 & 团队题单（收录/推荐） ==========

/// 学校题单（学校收录的题单）
model SchoolProblemList {
  id            String   @id @default(uuid())
  schoolId      String
  problemListId String   // 关联的个人题单
  addedBy       String   // 添加者 userId
  addedByRole   String   // 添加者角色: principal | teacher
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  School        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@unique([schoolId, problemListId])
  @@index([schoolId])
  @@index([problemListId])
  @@index([addedBy])
}

/// 团队题单（团队收录的题单）
model TeamProblemList {
  id            String   @id @default(uuid())
  teamId        String
  problemListId String   // 关联的个人题单
  addedBy       String   // 添加者 userId
  addedByRole   String   // 添加者角色: owner | admin | teacher
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  Team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@unique([teamId, problemListId])
  @@index([teamId])
  @@index([problemListId])
  @@index([addedBy])
}
