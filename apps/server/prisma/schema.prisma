  updatedAt   DateTime  @default(now()) @updatedAt
  LowUser     User      @relation("FriendshipLowUser", fields: [userLowId], references: [id], onDelete: Restrict)
  HighUser    User      @relation("FriendshipHighUser", fields: [userHighId], references: [id], onDelete: Restrict)
  RemovedBy   User?     @relation("FriendshipRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([userLowId, userHighId])
  @@index([userLowId, status])
  @@index([userHighId, status])
}

model UserBlock {
