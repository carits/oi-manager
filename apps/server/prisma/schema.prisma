  Messages           DirectMessage[]
  Reports            ChatReport[]

  @@unique([userLowId, userHighId])
  @@index([lastMessageAt])
  @@index([lastActivityAt, id])
}

model DirectConversationMember {
  id                String             @id
  conversationId    String
  userId            String
  lastReadSeq       Int                @default(0)
  unreadCount       Int                @default(0)
  archivedAt        DateTime?
  mutedUntil        DateTime?
  clearedThroughSeq Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  Conversation      DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User              User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId, archivedAt, updatedAt])
