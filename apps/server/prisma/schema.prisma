model ProblemTestSetRevisionGroupCase {
  id             String                      @id
  revisionId     String
  groupId        String
  testcaseId     String?
  inputObjectId  String
  outputObjectId String
  inputName      String
  outputName     String
  orderIndex     Int                         @default(0)
  score          Int?
  time           String?
  memory         String?
  source         String                      @default("official")
  Revision       ProblemTestSetRevision      @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  Group          ProblemTestSetRevisionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  Testcase       ProblemTestcase?            @relation(fields: [testcaseId], references: [id], onDelete: SetNull)
  InputObject    TestdataObject              @relation("RevisionGroupCaseInputObject", fields: [inputObjectId], references: [id], onDelete: Restrict)
  OutputObject   TestdataObject              @relation("RevisionGroupCaseOutputObject", fields: [outputObjectId], references: [id], onDelete: Restrict)

  @@unique([groupId, testcaseId])
  @@index([revisionId])
  @@index([groupId, orderIndex])
  @@index([testcaseId])
