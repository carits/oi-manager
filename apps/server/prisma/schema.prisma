  @@index([operatorId])
  @@index([organizationId])
  @@index([teamId])
}

model TeamMemberImportItem {
  id                      String                @id
  batchId                 String
  lineNumber              Int
  rawUsername             String
  rawStudentName          String?
  parsedUsername          String?
  candidateDisplayName    String?
