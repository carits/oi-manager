  @@unique([userLowId, userHighId])
  @@index([lastMessageAt])
  @@index([lastActivityAt, id])
}

model DirectConversationMember {
  id                String             @id
  conversationId    String
  userId            String
  lastReadSeq       Int                @default(0)
  unreadCount       Int                @default(0)
  archivedAt        DateTime?
  mutedUntil        DateTime?
  clearedThroughSeq Int                @default(0)
