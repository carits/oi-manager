generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id])
}

model Contest {
  id                  String                @id @default(uuid())
  title               String
  description         String?
  contestDate         DateTime
  status              String                @default("upcoming")
  type                String                @default("mock")
  teamId              String?
  countRating         Boolean               @default(false)
  scope               String                @default("public")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Team                Team?                 @relation(fields: [teamId], references: [id])
  ContestProblem      ContestProblem[]
  ContestProblemNote  ContestProblemNote[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]
  ContestResult       ContestResult[]

  @@index([teamId])
  @@index([status])
  @@index([scope])
  @@index([contestDate])
  @@index([teamId, status])
}

model ContestProblem {
  id                  String                @id @default(uuid())
  contestId           String
  orderIndex          Int
  title               String?
  description         String?
  ojName              String?
  problemId           String?
  isCustom            Boolean               @default(false)
  difficulty          String?
  points              Int?
  statementType       String                @default("none")
  statementMarkdown   String?
  solutionType        String                @default("none")
  solutionMarkdown    String?
  solutionVisible     Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Contest             Contest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblemNote  ContestProblemNote[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]

  @@unique([contestId, orderIndex])
}

model ContestProblemNote {
  id             String         @id @default(uuid())
  contestId      String
  problemId      String
  studentId      String
  content        String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  Student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ContestProblem ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId, studentId])
  @@index([studentId])
  @@index([updatedAt])
}

model ContestProblemScore {
  id             String         @id @default(uuid())
  contestId      String
  problemId      String
  studentId      String
  score          Float?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  Student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ContestProblem ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId, studentId])
}

model ContestResource {
  id               String          @id @default(uuid())
  contestId        String
  contestProblemId String?
  fileName         String
  fileType         String
  fileFormat       String          @default("pdf")
  fileUrl          String
  visibleRoles     String          @default("all")
  uploadedBy       String
  uploadedAt       DateTime        @default(now())
  ContestProblem   ContestProblem? @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
  Contest          Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
}

model ContestResult {
  id           String   @id @default(uuid())
  contestId    String
  studentId    String
  rank         Int?
  score        Float?
  ratingBefore Int
  ratingAfter  Int
  ratingChange Int
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, studentId])
  @@index([studentId])
  @@index([createdAt])
}

model File {
  id           String    @id @default(uuid())
  storageType  String    @default("local")
  disk         String    @default("default")
  relativePath String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  md5Hash      String?
  sha256Hash   String?
  accessLevel  String    @default("private")
  isPublic     Boolean   @default(false)
  ownerType    String
  ownerId      String
  category     String
  status       String    @default("active")
  deletedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category])
  @@index([status, deletedAt])
  @@index([md5Hash])
  @@index([ownerType, ownerId])
  @@index([storageType, disk])
}

model LoginLog {
  id            String   @id @default(uuid())
  userId        String?
  username      String
  loginRole     String
  userRole      String?
  result        String
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([username])
  @@index([result])
  @@index([createdAt])
}

model Milestone {
  id            String   @id @default(uuid())
  studentId     String
  teacherId     String
  title         String
  description   String?
  milestoneDate DateTime
  type          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Teacher       Teacher  @relation(fields: [teacherId], references: [id])
  Student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
  @@index([milestoneDate])
}

model OjFetchJob {
  id               String   @id @default(uuid())
  platform         String
  problemId        String
  status           String   @default("pending")
  message          String?
  hasAttachment    Boolean  @default(false)
  attachmentStatus String?
  createdProblemId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([platform, problemId])
  @@index([status])
  @@index([createdAt])
}

model OjPlatformConfig {
  id         String    @id @default(uuid())
  platform   String    @unique
  cookies    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PasswordResetLog {
  id             String   @id @default(uuid())
  targetUserId   String
  operatorUserId String
  operatorRole   String
  resetMethod    String
  result         String
  message        String?
  createdAt      DateTime @default(now())
}

model PrincipalTransferLog {
  id                    String   @id @default(uuid())
  schoolId              String
  oldPrincipalTeacherId String?
  newPrincipalTeacherId String
  operatorUserId        String
  result                String
  message               String?
  createdAt             DateTime @default(now())
  School                School   @relation(fields: [schoolId], references: [id])
}

model Problem {
  id                String              @id @default(uuid())
  platform          String
  problemId         String
  title             String
  description       String?
  statementType     String              @default("none")
  statementPdfUrl   String?
  solutionType      String              @default("none")
  solutionMarkdown  String?
  solutionPdfUrl    String?
  solutionVisible   Boolean             @default(false)
  difficulty        String?
  timeLimit         Int?
  memoryLimit       Int?
  judgeConfig       String?
  problemType       String              @default("default")
  visibility        String              @default("private")
  ownerType         String              @default("teacher")
  ownerId           String
  status            String              @default("draft")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  allowedLanguages  String?
  ojBindings        String?
  ProblemAttachment ProblemAttachment[]
  ProblemListEntry  ProblemListEntry[]
  ProblemNote       ProblemNote[]
  ProblemStatement  ProblemStatement[]
  TestdataFiles     TestdataFile[]

  @@unique([platform, problemId])
  @@index([visibility])
  @@index([ownerId, ownerType])
  @@index([visibility, status])
  @@index([createdAt])
}

model ProblemAttachment {
  id          String   @id @default(uuid())
  problemId   String
  fileName    String
  fileSize    Int
  fileUrl     String
  description String?
  uploadedAt  DateTime @default(now())
  Problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model ProblemNote {
  id        String   @id @default(uuid())
  problemId String
  userId    String
  userType  String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId, userType])
  @@index([userId])
  @@index([updatedAt])
}

model ProblemStatement {
  id        String   @id @default(uuid())
  problemId String
  type      String
  format    String
  language  String?
  content   String?
  fileUrl   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, type, format, language])
  @@index([problemId, type])
}

model School {
  id                        String                 @id @default(uuid())
  name                      String
  announcement              String?
  region                    String?
  schoolType                String?
  educationSystem           String?                @default("6-3-3")
  contactPerson             String?
  contactPhone              String?
  contactEmail              String?
  status                    String                 @default("active")
  currentPrincipalTeacherId String
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  PrincipalTransferLog      PrincipalTransferLog[]
  SchoolProblemLists        SchoolProblemList[]
  Student                   Student[]
  Teacher                   Teacher[]
  Team                      Team[]
}

model Student {
  id                        String                      @id @default(uuid())
  userId                    String                      @unique
  name                      String
  gender                    String?
  schoolId                  String
  enrollmentYear            Int?
  targetContest             String?
  headTeacherId             String?
  tags                      String?
  notes                     String?
  avatar                    String?
  rating                    Int                         @default(1200)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  ContestProblemNote        ContestProblemNote[]
  ContestProblemScore       ContestProblemScore[]
  ContestResult             ContestResult[]
  Milestone                 Milestone[]
  Teacher                   Teacher?                    @relation(fields: [headTeacherId], references: [id])
  School                    School                      @relation(fields: [schoolId], references: [id])
  User                      User                        @relation(fields: [userId], references: [id])
  TeamJoinRequest           TeamJoinRequest[]
  TeamMemberExternalAccount TeamMemberExternalAccount[]

  @@index([schoolId])
  @@index([headTeacherId])
  @@index([rating])
  @@index([schoolId, headTeacherId])
  @@index([enrollmentYear])
}

model Teacher {
  id        String      @id @default(uuid())
  userId    String      @unique
  name      String
  email     String?
  phone     String?
  avatar    String?
  bio       String?
  title     String?
  status    String      @default("active")
  schoolId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  Milestone Milestone[]
  Student   Student[]
  School    School?     @relation(fields: [schoolId], references: [id])
  User      User        @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([status])
  @@index([createdAt])
}

model Team {
  id                        String                      @id
  name                      String
  avatar                    String?
  description               String?
  announcement              String?
  schoolId                  String
  isPublic                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  Contest                   Contest[]
  School                    School                      @relation(fields: [schoolId], references: [id])
  TeamJoinRequest           TeamJoinRequest[]
  TeamMember                TeamMember[]
  TeamMemberExternalAccount TeamMemberExternalAccount[]
  TeamMemberImportBatch     TeamMemberImportBatch[]
  TeamProblemLists          TeamProblemList[]

  @@index([schoolId])
  @@index([isPublic])
  @@index([schoolId, isPublic])
  @@index([createdAt])
}

model TeamJoinRequest {
  id          String    @id @default(uuid())
  teamId      String
  studentId   String
  status      String    @default("pending")
  message     String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  processedBy String?
  Team        Team      @relation(fields: [teamId], references: [id])
  Student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teamId, studentId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  userType  String
  role      String
  status    String   @default("active")
  joinedAt  DateTime @default(now())
  invitedBy String?
  Team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, userType])
  @@index([teamId, status, role])
  @@index([userId, userType, status])
  @@index([teamId, role])
  @@index([status])
}

model TeamOperationLog {
  id           String   @id @default(uuid())
  teamId       String
  operatorId   String
  operatorType String
  action       String
  targetId     String?
  targetType   String?
  oldValue     String?
  newValue     String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([teamId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
}

model User {
  id               String                @id @default(uuid())
  username         String                @unique
  passwordHash     String
  role             String
  status           String                @default("active")
  avatar           String?
  phone            String?
  email            String?
  bio              String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  Admin            Admin?
  Student          Student?
  Submissions      Submission[]
  Teacher          Teacher?
  PlatformBindings UserPlatformBinding[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model UserPlatformBinding {
  id               String    @id @default(uuid())
  userId           String
  platform         String
  platformUsername String?
  bindingStatus    String    @default("unbound")
  bindingData      String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  platformConfig   String?
  platformUid      String?
  statusMessage    String?
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
}

model UserStatusLog {
  id             String   @id @default(uuid())
  targetUserId   String
  operatorUserId String
  operatorRole   String
  oldStatus      String
  newStatus      String
  reason         String?
  createdAt      DateTime @default(now())
}

model TeamMemberExternalAccount {
  id               String   @id @default(uuid())
  teamId           String
  studentId        String?
  platform         String
  platformUsername String
  displayName      String?
  status           String   @default("pending")
  inviteId         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  Student          Student? @relation(fields: [studentId], references: [id])
  Team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, platform, platformUsername])
  @@index([studentId])
  @@index([platform, platformUsername])
}

model TeamMemberImportBatch {
  id           String                 @id @default(uuid())
  teamId       String?
  operatorId   String
  platform     String
  totalCount   Int
  successCount Int                    @default(0)
  skipCount    Int                    @default(0)
  errorCount   Int                    @default(0)
  status       String                 @default("pending")
  rawInput     String?
  createdAt    DateTime               @default(now())
  completedAt  DateTime?
  Team         Team?                  @relation(fields: [teamId], references: [id])
  Items        TeamMemberImportItem[]

  @@index([teamId])
  @@index([operatorId])
}

model TeamMemberImportItem {
  id                   String                @id @default(uuid())
  batchId              String
  lineNumber           Int
  rawUsername          String
  rawStudentName       String?
  parsedUsername       String?
  candidateDisplayName String?
  matchType            String
  matchStatus          String                @default("pending")
  matchedStudentId     String?
  matchedStudentName   String?
  createdStudentId     String?
  action               String?
  userChoice           String?
  errorMessage         String?
  createdAt            DateTime              @default(now())
  processedAt          DateTime?
  Batch                TeamMemberImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([matchType])
}

model AiUsageLog {
  id          String   @id @default(uuid())
  userId      String
  problemId   String
  action      String
  sourceLang  String?
  targetLang  String?
  model       String?
  tokensUsed  Int      @default(0)
  status      String   @default("success")
  message     String?
  createdAt   DateTime @default(now())
  statementId String?

  @@index([userId, problemId, action, createdAt])
  @@index([userId, createdAt])
}

/// 题单（文件夹/wiki 空间）
model ProblemList {
  id                 String               @id
  title              String
  description        String?
  coverUrl           String?
  schoolId           String?
  ownerId            String
  ownerType          String               @default("teacher")
  visibility         String               @default("private")
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  Sections           ProblemListSection[]
  Shares             ProblemListShare[]
  SchoolProblemLists SchoolProblemList[]
  TeamProblemLists   TeamProblemList[]

  @@index([ownerId, ownerType])
  @@index([schoolId])
  @@index([visibility])
  @@index([createdAt])
}

/// 题单中的章节（二级标题，纯视觉分组）
model ProblemListSection {
  id            String             @id @default(uuid())
  problemListId String
  title         String
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  Entries       ProblemListEntry[]
  ProblemList   ProblemList        @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@index([problemListId])
}

/// 题单中的题目条目（挂在章节下：题单 → 章节 → 题目）
model ProblemListEntry {
  id        String             @id @default(uuid())
  sectionId String
  problemId String
  sortOrder Int                @default(0)
  alias     String?
  notes     String?
  ojName    String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  Problem   Problem            @relation(fields: [problemId], references: [id])
  Section   ProblemListSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, problemId])
  @@index([sectionId])
  @@index([problemId])
}

/// 题单级分享
model ProblemListShare {
  id            String      @id @default(uuid())
  problemListId String
  targetType    String
  targetId      String
  permission    String      @default("view")
  sharedBy      String
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@unique([problemListId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([sharedBy])
}

/// 学校题单（学校收录的题单）
model SchoolProblemList {
  id            String      @id @default(uuid())
  schoolId      String
  problemListId String
  addedBy       String
  addedByRole   String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  School        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, problemListId])
  @@index([schoolId])
  @@index([problemListId])
  @@index([addedBy])
}

/// 团队题单（团队收录的题单）
model TeamProblemList {
  id            String      @id @default(uuid())
  teamId        String
  problemListId String
  addedBy       String
  addedByRole   String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  Team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, problemListId])
  @@index([teamId])
  @@index([problemListId])
  @@index([addedBy])
}

model OjAccount {
  id                          String       @id @default(uuid())
  platform                    String
  username                    String
  password                    String?
  passwordIV                  String?
  cookie                      String?
  cookieRaw                   String?
  status                      String       @default("unverified")
  lastVerifiedAt              DateTime?
  lastErrorMessage            String?
  loginMethod                 String       @default("cookie")
  addedBy                     String
  lastLoginAt                 DateTime?
  lastLoginFailureAt          DateTime?
  lastSubmitAt                DateTime?
  lastRateLimitAt             DateTime?
  consecutiveFailures         Int          @default(0)
  rateLimitCount              Int          @default(0)
  totalSubmissions            Int          @default(0)
  totalSubmissionErrors       Int          @default(0)
  enabled                     Boolean      @default(true)
  priority                    Int          @default(0)
  maxConsecutiveFailures      Int          @default(3)
  freezeDurationMinutes       Int          @default(30)
  submitMaxRetries            Int          @default(1)
  retryIntervalSeconds        Int          @default(10)
  minSubmitIntervalSeconds    Int          @default(30)
  minRequestIntervalSeconds   Int          @default(3)
  maxConcurrentSubmissions    Int          @default(1)
  maxConcurrentRequests       Int          @default(2)
  loginFailureCooldownMinutes Int          @default(15)
  cookieValidMinutes          Int          @default(3600)
  renewLoginThresholdMinutes  Int          @default(10)
  reverifyIntervalMinutes     Int          @default(30)
  autoVerifyIntervalMinutes   Int          @default(1440)
  firstPollDelaySeconds       Int          @default(5)
  pollIntervalSeconds         Int          @default(5)
  maxWaitDurationMinutes      Int          @default(10)
  rateLimitThreshold          Int          @default(2)
  banSuspicionCooldownHours   Int          @default(6)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  Submissions                 Submission[]

  @@unique([platform, username])
  @@index([platform])
  @@index([status])
}

/// 评测记录
model Submission {
  id                Int        @id @default(autoincrement())
  userId            String
  oj                String
  problemId         String
  language          String
  code              String
  codeLength        Int
  result            String     @default("queuing")
  timeUsed          Int?
  memoryUsed        Int?
  score             Int?
  cases             String?
  subtasks          String?
  submitMethod      String
  ojAccountId       String?
  ojRemoteId        String?
  errorMessage      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  problemInternalId String?
  OjAccount         OjAccount? @relation(fields: [ojAccountId], references: [id])
  User              User       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([oj])
  @@index([problemId])
  @@index([result])
  @@index([language])
  @@index([createdAt])
}

/// 测试数据文件
model TestdataFile {
  id         String   @id @default(uuid())
  problemId  String
  filename   String
  size       Int
  md5        String?
  uploadedAt DateTime @default(now())
  Problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, filename])
  @@index([problemId])
}
