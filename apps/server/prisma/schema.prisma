  updatedAt                   DateTime @default(now()) @updatedAt
  User                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FriendRequest {
  id          String    @id
  requesterId String
  addresseeId String
  message     String?   @db.VarChar(500)
  status      String    @default("pending")
  respondedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  Requester   User      @relation("FriendRequestSender", fields: [requesterId], references: [id], onDelete: Restrict)
  Addressee   User      @relation("FriendRequestReceiver", fields: [addresseeId], references: [id], onDelete: Restrict)

  @@index([requesterId, status, createdAt])
  @@index([addresseeId, status, createdAt])
  @@index([expiresAt, status])
}

model Friendship {
  id          String    @id
  userLowId   String
  userHighId  String
  status      String    @default("active")
  acceptedAt  DateTime  @default(now())
  removedAt   DateTime?
  removedById String?
