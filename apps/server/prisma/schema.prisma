  Sender          User               @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  Sticker         ChatSticker?       @relation(fields: [stickerId], references: [id], onDelete: Restrict)
  Reports         ChatReport[]

  @@unique([conversationId, seq])
  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([senderUserId, createdAt])
  @@index([stickerId])
}

model ChatStickerPack {
  id               String              @id
  key              String
  name             String
  version          Int
  status           String              @default("staged")
  sortOrder        Int                 @default(0)
  createdByUserId  String
  publishedAt      DateTime?
  retiredAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt
  CreatedBy        User                @relation("ChatStickerPackCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  Stickers         ChatSticker[]
  PublishedImports ChatStickerImport[] @relation("ChatStickerImportPublishedPack")

  @@unique([key, version])
  @@index([status, sortOrder, createdAt])
}

model ChatSticker {
  id           String          @id
  packId       String
  key          String
  label        String
  assetBlobId  String
  posterBlobId String
  mimeType     String
  width        Int
  height       Int
  frameCount   Int             @default(1)
  durationMs   Int             @default(0)
  sha256       String
  sortOrder    Int             @default(0)
  status       String          @default("active")
  createdAt    DateTime        @default(now())
  Pack         ChatStickerPack @relation(fields: [packId], references: [id], onDelete: Restrict)
  AssetBlob    BlobObject      @relation("ChatStickerAsset", fields: [assetBlobId], references: [id], onDelete: Restrict)
  PosterBlob   BlobObject      @relation("ChatStickerPoster", fields: [posterBlobId], references: [id], onDelete: Restrict)
  Messages     DirectMessage[]

  @@unique([packId, key])
  @@index([packId, status, sortOrder])
  @@index([assetBlobId])
  @@index([posterBlobId])
}

model ChatStickerImport {
  id               String           @id
  uploadedByUserId String
  status           String           @default("staged")
  reportHash       String
  manifest         Json
  report           Json
  publishedPackId  String?
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  UploadedBy       User             @relation("ChatStickerImportUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  PublishedPack    ChatStickerPack? @relation("ChatStickerImportPublishedPack", fields: [publishedPackId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([expiresAt])
}

model ChatUserEvent {
  id             BigInt   @id @default(autoincrement())
  userId         String
  eventType      String
  conversationId String?
  messageId      String?
  payload        Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([expiresAt])
}

model ChatReport {
  id                 String             @id
  conversationId     String
  messageId          String?
  reporterUserId     String
  targetUserId       String
  reason             String
  details            String?            @db.Text
  evidenceSnapshot   Json
  status             String             @default("pending")
  reviewedByUserId   String?
  reviewedAt         DateTime?
  resolutionNote     String?            @db.Text
  evidenceHoldUntil  DateTime?
  evidenceReleasedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  Conversation       DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  Message            DirectMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  Reporter           User               @relation("ChatReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  Target             User               @relation("ChatReportTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  ReviewedBy         User?              @relation("ChatReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([messageId, reporterUserId, status])
}

model ChatMaintenanceCursor {
  name      String   @id
  cursor    String?
  updatedAt DateTime @default(now()) @updatedAt
}

model UserNotification {
  id             String    @id
  userId         String
  scope          String
  contextType    String    @default("account")
  contextKey     String    @default("account")
  organizationId String?
  type           String
  title          String
  body           String
  href           String?
  sourceType     String
  sourceId       String
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contextKey, type, sourceType, sourceId])
  @@index([userId, scope, readAt, createdAt])
  @@index([userId, scope, createdAt])
  @@index([userId, contextKey, readAt, createdAt])
}

model UserPlatformBinding {
  id               String    @id
  userId           String
  platform         String
  platformUsername String?
  bindingStatus    String    @default("unbound")
  bindingData      String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  platformConfig   String?
  platformUid      String?
  statusMessage    String?
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([platform])
  @@index([userId])
}

model UserStatusLog {
  id           String   @id
  operatorRole String
  oldStatus    String
  newStatus    String
  reason       String?
  createdAt    DateTime @default(now())
  operatorId   String
  targetId     String
}

model carits_sequence {
  id     Int @id @default(1)
  nextId Int @default(1000)
}

model BlogPost {
  id               String            @id
  authorUserId     String
  organizationId   String?
  type             BlogPostType      @default(ARTICLE)
  slug             String
  status           BlogPostStatus    @default(DRAFT)
  visibility       BlogVisibility    @default(PRIVATE)
  currentVersionId String?           @unique
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  Author           User              @relation("BlogPostAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  Organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  CurrentVersion   BlogPostVersion?  @relation("BlogPostCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  Versions         BlogPostVersion[] @relation("BlogPostVersions")
  Draft            BlogPostDraft?
  SeriesEntries    BlogSeriesEntry[]
  Tags             BlogPostTag[]
  Comments         BlogComment[]
  Reactions        BlogReaction[]
  Bookmarks        BlogBookmark[]
  Reports          BlogReport[]
  Features         BlogFeature[]

  @@unique([authorUserId, slug])
  @@index([status, visibility, publishedAt])
  @@index([organizationId, status, publishedAt])
  @@index([authorUserId, status, updatedAt])
}

model BlogPostDraft {
  postId          String   @id
  revision        Int      @default(1)
  title           String
  summary         String?
  contentMarkdown String   @db.Text
  references      Json
  classification  Json     @default("{}")
  baseVersionId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  Post            BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model BlogPostVersion {
  id                     String                @id
  postId                 String
  version                Int
  title                  String
  summary                String?
  contentMarkdown        String                @db.Text
  contentHash            String
  sourceVersionId        String?
  status                 BlogPostVersionStatus @default(CURRENT)
  visibility             BlogVisibility
  organizationIdSnapshot String?
  classificationSnapshot Json                  @default("{}")
  createdByUserId        String
  createdAt              DateTime              @default(now())
  publishedAt            DateTime              @default(now())
  Post                   BlogPost              @relation("BlogPostVersions", fields: [postId], references: [id], onDelete: Restrict)
  CurrentForPost         BlogPost?             @relation("BlogPostCurrentVersion")
  SourceVersion          BlogPostVersion?      @relation("BlogVersionLineage", fields: [sourceVersionId], references: [id], onDelete: Restrict)
  DerivedVersions        BlogPostVersion[]     @relation("BlogVersionLineage")
  CreatedBy              User                  @relation("BlogVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  References             BlogReference[]

  @@unique([postId, version])
  @@index([postId, publishedAt])
  @@index([contentHash])
  @@index([sourceVersionId])
  @@index([visibility, publishedAt])
}

model BlogReference {
  id                   String                    @id
  postVersionId        String
  ordinal              Int
  referenceType        BlogReferenceType
  referenceId          String
  referenceVersionId   String?
  relationType         BlogReferenceRelationType @default(MENTION)
  displayMode          BlogReferenceDisplayMode  @default(CARD)
  positionKey          String?
  snapshotData         Json
  accessMode           BlogVisibility
  status               BlogReferenceStatus       @default(CURRENT)
  problemId            String?
  solutionVersionId    String?
  contestId            String?
  standingSnapshotId   String?
  ratingChangeId       String?
  submissionSnapshotId String?
  createdAt            DateTime                  @default(now())
  PostVersion          BlogPostVersion           @relation(fields: [postVersionId], references: [id], onDelete: Restrict)
  Problem              Problem?                  @relation("BlogReferenceProblem", fields: [problemId], references: [id], onDelete: Restrict)
  SolutionVersion      ProblemSolutionVersion?   @relation(fields: [solutionVersionId], references: [id], onDelete: Restrict)
  Contest              Contest?                  @relation(fields: [contestId], references: [id], onDelete: Restrict)
  StandingSnapshot     ContestStandingSnapshot?  @relation(fields: [standingSnapshotId], references: [id], onDelete: Restrict)
  RatingChange         RatingChange?             @relation(fields: [ratingChangeId], references: [id], onDelete: Restrict)
  SubmissionSnapshot   BlogSubmissionSnapshot?   @relation(fields: [submissionSnapshotId], references: [id], onDelete: Restrict)

  @@unique([postVersionId, ordinal])
  @@index([referenceType, referenceId])
  @@index([problemId, relationType])
  @@index([solutionVersionId])
  @@index([contestId, relationType])
  @@index([standingSnapshotId])
  @@index([ratingChangeId])
  @@index([submissionSnapshotId])
}

model BlogSubmissionSnapshot {
  id              String          @id
  submissionId    Int
  ownerUserId     String
  visibility      BlogVisibility  @default(PRIVATE)
  includeCode     Boolean         @default(false)
  sourcePlatform  String
  sourceProblemId String
  problemTitle    String?
  result          String
  score           Int?
  timeUsed        Int?
  memoryUsed      Int?
  language        String
  inputFilename   String?
  outputFilename  String?
  code            String?         @db.Text
  submittedAt     DateTime
  contentHash     String
  createdAt       DateTime        @default(now())
  Submission      Submission      @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  Owner           User            @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  BlogReferences  BlogReference[]

  @@index([ownerUserId, createdAt])
  @@index([submissionId, createdAt])
  @@index([contentHash])
}

model BlogSeries {
  id             String            @id
  ownerUserId    String
  organizationId String?
  scopeKey       String
  normalizedKey  String
  title          String
  description    String?
  visibility     BlogVisibility    @default(PRIVATE)
  revision       Int               @default(1)
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  Owner          User              @relation("BlogSeriesOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  Organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  Entries        BlogSeriesEntry[]

  @@unique([scopeKey, normalizedKey])
  @@index([ownerUserId, archivedAt, updatedAt])
  @@index([organizationId, visibility, archivedAt])
}

model BlogSeriesEntry {
  seriesId   String
  postId     String
  orderIndex Int
  createdAt  DateTime   @default(now())
  Series     BlogSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  Post       BlogPost   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([seriesId, postId])
  @@unique([seriesId, orderIndex])
  @@index([postId])
}

model BlogTag {
  id            String        @id
  kind          BlogTagKind
  scopeKey      String
  ownerUserId   String?
  name          String
  normalizedKey String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  Owner         User?         @relation("BlogTagOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  Posts         BlogPostTag[]

  @@unique([scopeKey, normalizedKey])
  @@index([kind, normalizedKey])
  @@index([ownerUserId, updatedAt])
}

model BlogPostTag {
  postId        String
  tagId         String
  addedByUserId String
  createdAt     DateTime @default(now())
  Post          BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  Tag           BlogTag  @relation(fields: [tagId], references: [id], onDelete: Restrict)
  AddedBy       User     @relation("BlogPostTagAdder", fields: [addedByUserId], references: [id], onDelete: Restrict)

  @@id([postId, tagId])
  @@index([tagId, postId])
  @@index([addedByUserId])
}

model BlogComment {
  id           String        @id
  postId       String
  authorUserId String
  parentId     String?
  content      String        @db.Text
  status       String        @default("visible")
  editedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  Post         BlogPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  Author       User          @relation("BlogCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  Parent       BlogComment?  @relation("BlogCommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
  Replies      BlogComment[] @relation("BlogCommentReplies")
  Reports      BlogReport[]

  @@index([postId, status, createdAt])
  @@index([parentId, createdAt])
  @@index([authorUserId, createdAt])
}

model BlogReaction {
  postId    String
  userId    String
  type      String
  createdAt DateTime @default(now())
  Post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, type])
  @@index([postId, type])
  @@index([userId, createdAt])
}

model BlogBookmark {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  Post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model BlogReport {
  id               String       @id
  postId           String
  commentId        String?
  reporterUserId   String
  reason           String
  details          String?      @db.Text
  evidenceSnapshot Json
  status           String       @default("pending")
  reviewedByUserId String?
  reviewedAt       DateTime?
  resolutionNote   String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  Post             BlogPost     @relation(fields: [postId], references: [id], onDelete: Restrict)
  Comment          BlogComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  Reporter         User         @relation("BlogReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  ReviewedBy       User?        @relation("BlogReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([postId, status])
  @@index([reporterUserId, createdAt])
  @@index([commentId])
}

model BlogFeature {
  id              String    @id
  postId          String
  createdByUserId String
  status          String    @default("active")
  reason          String?
  createdAt       DateTime  @default(now())
  retiredAt       DateTime?
  Post            BlogPost  @relation(fields: [postId], references: [id], onDelete: Restrict)
  CreatedBy       User      @relation("BlogFeatureCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([postId, status])
}
