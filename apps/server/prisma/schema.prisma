generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         String
  status       String    @default("active")
  avatar       String?
  phone        String?
  email        String?
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  student      Student?
  teacher      Teacher?
  admin        Admin?
}

model School {
  id                        String                 @id @default(uuid())
  name                      String
  announcement              String?
  region                    String?
  schoolType                String?
  educationSystem           String?                @default("6-3-3")
  contactPerson             String?
  contactPhone              String?
  contactEmail              String?
  status                    String                 @default("active")
  currentPrincipalTeacherId String
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  principalTransferLogs     PrincipalTransferLog[]
  students                  Student[]
  teachers                  Teacher[]
  teams                     Team[]
}

model Teacher {
  id         String        @id @default(uuid())
  userId     String        @unique
  name       String
  email      String?
  phone      String?
  avatar     String?
  bio        String?
  title      String?
  status     String        @default("active")
  schoolId   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  milestones Milestone[]
  students   Student[]
  taskLists  TaskList[]
  user       User          @relation(fields: [userId], references: [id])
  school     School?       @relation(fields: [schoolId], references: [id])
}

model Student {
  id             String                @id @default(uuid())
  userId         String?               @unique
  name           String
  gender         String?
  schoolId       String
  enrollmentYear Int?
  targetContest  String?
  headTeacherId  String?
  tags           String?
  notes          String?
  avatar         String?
  rating         Int                   @default(1200)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  problemScores  ContestProblemScore[]
  contestResults ContestResult[]
  milestones     Milestone[]
  user           User?                 @relation(fields: [userId], references: [id])
  school         School                @relation(fields: [schoolId], references: [id])
  headTeacher    Teacher?              @relation(fields: [headTeacherId], references: [id])
  taskProgresses TaskProgress[]
  joinRequests   TeamJoinRequest[]
}

model TaskList {
  id          String    @id @default(uuid())
  title       String
  description String?
  publishAt   DateTime?
  deadline    DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tasks       Task[]
  creator     Teacher   @relation(fields: [createdBy], references: [id])
}

model Task {
  id         String         @id @default(uuid())
  taskListId String
  title      String
  ojName     String?
  problemId  String?
  difficulty String?
  points     Int?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  taskList   TaskList       @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  progresses TaskProgress[]
}

model TaskProgress {
  id            String    @id @default(uuid())
  taskId        String
  studentId     String
  status        String    @default("pending")
  seenEditorial Boolean   @default(false)
  needHelp      Boolean   @default(false)
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
}

model Contest {
  id            String                @id @default(uuid())
  title         String
  description   String?
  contestDate   DateTime
  status        String                @default("upcoming")
  type          String                @default("mock")
  teamId        String?
  countRating   Boolean               @default(false)
  scope         String                @default("public")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  team          Team?                 @relation(fields: [teamId], references: [id])
  problems      ContestProblem[]
  problemScores ContestProblemScore[]
  resources     ContestResource[]
  results       ContestResult[]
}

model ContestResult {
  id           String   @id @default(uuid())
  contestId    String
  studentId    String
  rank         Int?
  score        Float?
  ratingBefore Int
  ratingAfter  Int
  ratingChange Int
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, studentId])
}

model ContestProblem {
  id                String                @id @default(uuid())
  contestId         String
  orderIndex        Int
  title             String?
  description       String?
  ojName            String?
  problemId         String?
  isCustom          Boolean               @default(false)
  difficulty        String?
  points            Int?
  statementType     String                @default("none")
  statementMarkdown String?
  solutionType      String                @default("none")
  solutionMarkdown  String?
  solutionVisible   Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  contest           Contest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  scores            ContestProblemScore[]
  resources         ContestResource[]

  @@unique([contestId, orderIndex])
}

model ContestProblemScore {
  id        String         @id @default(uuid())
  contestId String
  problemId String
  studentId String
  score     Float?
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  contest   Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem   ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId, studentId])
}

model ContestResource {
  id               String          @id @default(uuid())
  contestId        String
  contestProblemId String?
  fileName         String
  fileType         String
  fileFormat       String          @default("pdf")
  fileUrl          String
  visibleRoles     String          @default("all")
  uploadedBy       String
  uploadedAt       DateTime        @default(now())
  contest          Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem          ContestProblem? @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
}

model Milestone {
  id            String   @id @default(uuid())
  studentId     String
  teacherId     String
  title         String
  description   String?
  milestoneDate DateTime
  type          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher       Teacher  @relation(fields: [teacherId], references: [id])
}

model Team {
  id             String            @id @default(uuid())
  name           String
  avatar         String?
  description    String?
  announcement   String?
  schoolId       String
  isPublic       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  contests       Contest[]
  school         School            @relation(fields: [schoolId], references: [id])
  members        TeamMember[]
  joinRequests   TeamJoinRequest[]
}

model TeamMember {
  id        String    @id @default(uuid())
  teamId    String
  userId    String    // 学生ID或教师ID
  userType  String    // 'teacher' | 'student'
  role      String    // 'owner' | 'admin' | 'member'
  status    String    @default("active")  // 'pending' | 'active'
  joinedAt  DateTime  @default(now())
  invitedBy String?   // 邀请人ID
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, userType])
}

model TeamJoinRequest {
  id          String    @id @default(uuid())
  teamId      String
  studentId   String
  status      String    @default("pending")
  message     String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  processedBy String?
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  team        Team      @relation(fields: [teamId], references: [id])

  @@unique([teamId, studentId])
}

model PrincipalTransferLog {
  id                    String   @id @default(uuid())
  schoolId              String
  oldPrincipalTeacherId String?
  newPrincipalTeacherId String
  operatorUserId        String
  result                String
  message               String?
  createdAt             DateTime @default(now())
  school                School   @relation(fields: [schoolId], references: [id])
}

model PasswordResetLog {
  id             String   @id @default(uuid())
  targetUserId   String
  operatorUserId String
  operatorRole   String
  resetMethod    String
  result         String
  message        String?
  createdAt      DateTime @default(now())
}

model UserStatusLog {
  id             String   @id @default(uuid())
  targetUserId   String
  operatorUserId String
  operatorRole   String
  oldStatus      String
  newStatus      String
  reason         String?
  createdAt      DateTime @default(now())
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}
