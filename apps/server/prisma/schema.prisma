  Progress               AssignmentProblemProgress[]
  Corrections            AssignmentCorrection[]
  Feedback               AssignmentFeedback[]
  ScoreAdjustments       AssignmentScoreAdjustment[]
  GradeSnapshots         AssignmentGradeSnapshot[]
  Events                 AssignmentEvent[]
  Submissions            Submission[]

  @@index([organizationId, status, openAt])
  @@index([teamId, status, openAt])
  @@index([createdByMembershipId, createdAt])
  @@index([status, publishAt])
  @@index([status, dueAt])
  @@index([status, closeAt])
}

model AssignmentProblem {
  id                  String                      @id @default(uuid())
  assignmentId        String
  problemId           String
  orderIndex          Int
  category            AssignmentProblemCategory   @default(REQUIRED)
  required            Boolean                     @default(true)
  maxScore            Int                         @default(100)
  judgeMaxScore       Int                         @default(100)
  targetScore         Int                         @default(100)
  weight              Int                         @default(100)
