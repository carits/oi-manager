  processedAt             DateTime?
  TeamMemberImportBatch   TeamMemberImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([matchType])
  @@index([matchedStudentProfileId])
  @@index([createdStudentProfileId])
}

model TeamOperationLog {
  id           String   @id
  teamId       String
  operatorId   String
  operatorType String
  action       String
  targetId     String?
  targetType   String?
  oldValue     String?
  newValue     String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([operatorId])
  @@index([teamId])
}

model TeamProblemList {
  id            String      @id
  teamId        String
  problemListId String
  addedBy       String
  addedByRole   String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  Team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, problemListId])
  @@index([addedBy])
  @@index([problemListId])
  @@index([teamId])
}

model TestdataFile {
  id                String            @id
  problemId         String
  filename          String
  size              Int
  md5               String?
  sha256            String?
  uploadedAt        DateTime          @default(now())
  Problem           Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  InputForTestcase  ProblemTestcase[] @relation("ProblemTestcaseInput")
  OutputForTestcase ProblemTestcase[] @relation("ProblemTestcaseOutput")

  @@unique([problemId, filename])
  @@index([problemId])
}

model TestdataObject {
  id               String                        @id
  problemId        String
  sha256           String
  size             Int
  storageKey       String
  createdAt        DateTime                      @default(now())
  Problem          Problem                       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  SlotCaseInputs   ProblemTestSetSlotCase[]      @relation("SlotCaseInputObject")
  SlotCaseOutputs  ProblemTestSetSlotCase[]      @relation("SlotCaseOutputObject")
  SlotGroupInputs  ProblemTestSetSlotGroupCase[] @relation("SlotGroupCaseInputObject")
  SlotGroupOutputs ProblemTestSetSlotGroupCase[] @relation("SlotGroupCaseOutputObject")
  CandidateInputs  TestcaseCandidate[]           @relation("CandidateInputObject")
  CandidateOutputs TestcaseCandidate[]           @relation("CandidateOutputObject")

  @@unique([problemId, sha256])
  @@index([problemId])
}

model ProblemTestcase {
  id                  String                        @id
  problemId           String
  inputFileId         String
  outputFileId        String
  source              String                        @default("official")
  hackerId            String?
  hackAttemptId       String?
  inputSha256         String?
  outputSha256        String?
  semanticFingerprint String?
  enabled             Boolean                       @default(true)
  orderIndex          Int                           @default(0)
  isProtected         Boolean                       @default(false)
  protectionReason    String?
  protectedUntil      DateTime?
  createdAt           DateTime                      @default(now())
  Problem             Problem                       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  InputFile           TestdataFile                  @relation("ProblemTestcaseInput", fields: [inputFileId], references: [id], onDelete: Restrict)
  OutputFile          TestdataFile                  @relation("ProblemTestcaseOutput", fields: [outputFileId], references: [id], onDelete: Restrict)
  GroupLinks          ProblemTestcaseGroup[]
  SlotCases           ProblemTestSetSlotCase[]
  SlotGroupCases      ProblemTestSetSlotGroupCase[]

  @@unique([problemId, inputFileId, outputFileId])
  @@index([problemId, source, enabled])
  @@index([hackAttemptId])
}

model TestcaseMembershipRetirement {
  id                     String   @id
  problemId              String
  testcaseId             String
  subtaskId              Int
  groupKey               String
  replacementCandidateId String?
  replacementTestcaseId  String?
  fromGraphHash          String
  toGraphHash            String
  oldMarginalValue       Float    @default(0)
  newMarginalValue       Float    @default(0)
  reason                 String
  metadata               Json?
  createdBy              String?
  createdAt              DateTime @default(now())

  @@index([problemId, createdAt])
  @@index([testcaseId])
  @@index([replacementCandidateId])
  @@index([fromGraphHash, toGraphHash])
}

model ProblemSubtask {
  id           String                     @id
  problemId    String
  subtaskId    Int
  score        Int
  orderIndex   Int
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  Problem      Problem                    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Groups       ProblemTestGroup[]
  Dependencies ProblemSubtaskDependency[] @relation("SubtaskDependencySource")
  RequiredBy   ProblemSubtaskDependency[] @relation("SubtaskDependencyTarget")

  @@unique([problemId, subtaskId])
  @@index([problemId, orderIndex])
}

model ProblemSubtaskDependency {
  id          String         @id
  subtaskId   String
  dependsOnId String
  Subtask     ProblemSubtask @relation("SubtaskDependencySource", fields: [subtaskId], references: [id], onDelete: Cascade)
  DependsOn   ProblemSubtask @relation("SubtaskDependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([subtaskId, dependsOnId])
  @@index([dependsOnId])
}

model ProblemTestGroup {
  id          String                 @id
  problemId   String
  subtaskId   String
  key         String
  name        String
  kind        String
  score       Int                    @default(0)
  aggregation String                 @default("min")
  orderIndex  Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  Problem     Problem                @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Subtask     ProblemSubtask         @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  Testcases   ProblemTestcaseGroup[]

  @@unique([subtaskId, key])
  @@index([problemId, kind])
}

model ProblemTestcaseGroup {
  id         String           @id
  testcaseId String
  groupId    String
  orderIndex Int              @default(0)
  score      Int?
  time       String?
  memory     String?
  Testcase   ProblemTestcase  @relation(fields: [testcaseId], references: [id], onDelete: Cascade)
  Group      ProblemTestGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([testcaseId, groupId])
  @@index([groupId, orderIndex])
}

model ProblemTestSetSlot {
  problemId         String
  slot              ProblemTestSetSlotKind
  mode              String
  source            String
  judgeConfig       String                        @db.Text
  judgeConfigHash   String
  graphHash         String
  materializedPath  String
  fencingToken      Int                           @default(1)
  writerGateClosed  Boolean                       @default(false)
  activeReaderCount Int                           @default(0)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  Problem           Problem                       @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Cases             ProblemTestSetSlotCase[]
  Subtasks          ProblemTestSetSlotSubtask[]
  Groups            ProblemTestSetSlotGroup[]
  GroupCases        ProblemTestSetSlotGroupCase[]
  Readers           ProblemTestSetReader[]

  @@id([problemId, slot])
  @@index([slot, writerGateClosed])
}

model ProblemTestSetSlotCase {
  id             String                 @id
  problemId      String
  slot           ProblemTestSetSlotKind
  testcaseId     String?
  inputObjectId  String
  outputObjectId String
  inputName      String
  outputName     String
  orderIndex     Int
  score          Int?
  time           String?
  memory         String?
  source         String                 @default("official")
  Slot           ProblemTestSetSlot     @relation(fields: [problemId, slot], references: [problemId, slot], onDelete: Cascade)
  Testcase       ProblemTestcase?       @relation(fields: [testcaseId], references: [id], onDelete: SetNull)
  InputObject    TestdataObject         @relation("SlotCaseInputObject", fields: [inputObjectId], references: [id], onDelete: Restrict)
  OutputObject   TestdataObject         @relation("SlotCaseOutputObject", fields: [outputObjectId], references: [id], onDelete: Restrict)

  @@unique([problemId, slot, orderIndex])
  @@index([testcaseId])
}

model ProblemTestSetSlotSubtask {
  id           String                         @id
  problemId    String
  slot         ProblemTestSetSlotKind
  subtaskId    Int
  score        Int
  orderIndex   Int
  Slot         ProblemTestSetSlot             @relation(fields: [problemId, slot], references: [problemId, slot], onDelete: Cascade)
  Groups       ProblemTestSetSlotGroup[]
  Dependencies ProblemTestSetSlotDependency[] @relation("SlotDependencySource")
  RequiredBy   ProblemTestSetSlotDependency[] @relation("SlotDependencyTarget")

  @@unique([problemId, slot, subtaskId])
  @@index([problemId, slot, orderIndex])
}

model ProblemTestSetSlotDependency {
  id          String                    @id
  subtaskId   String
  dependsOnId String
  Subtask     ProblemTestSetSlotSubtask @relation("SlotDependencySource", fields: [subtaskId], references: [id], onDelete: Cascade)
  DependsOn   ProblemTestSetSlotSubtask @relation("SlotDependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([subtaskId, dependsOnId])
  @@index([dependsOnId])
}

model ProblemTestSetSlotGroup {
  id          String                        @id
  problemId   String
  slot        ProblemTestSetSlotKind
  subtaskId   String
  key         String
  name        String
  kind        String
  score       Int                           @default(0)
  aggregation String                        @default("min")
  orderIndex  Int                           @default(0)
  Slot        ProblemTestSetSlot            @relation(fields: [problemId, slot], references: [problemId, slot], onDelete: Cascade)
  Subtask     ProblemTestSetSlotSubtask     @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  Cases       ProblemTestSetSlotGroupCase[]

  @@unique([subtaskId, key])
  @@index([problemId, slot, kind])
}

model ProblemTestSetSlotGroupCase {
  id             String                  @id
  problemId      String
  slot           ProblemTestSetSlotKind
  groupId        String
  testcaseId     String?
  inputObjectId  String
  outputObjectId String
  inputName      String
  outputName     String
  orderIndex     Int                     @default(0)
  score          Int?
  time           String?
  memory         String?
  source         String                  @default("official")
  Slot           ProblemTestSetSlot      @relation(fields: [problemId, slot], references: [problemId, slot], onDelete: Cascade)
  Group          ProblemTestSetSlotGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  Testcase       ProblemTestcase?        @relation(fields: [testcaseId], references: [id], onDelete: SetNull)
  InputObject    TestdataObject          @relation("SlotGroupCaseInputObject", fields: [inputObjectId], references: [id], onDelete: Restrict)
  OutputObject   TestdataObject          @relation("SlotGroupCaseOutputObject", fields: [outputObjectId], references: [id], onDelete: Restrict)

  @@unique([groupId, testcaseId])
  @@index([problemId, slot, groupId, orderIndex])
}

model ProblemTestSetReader {
  id                     String                     @id @default(uuid())
  problemId              String
  slot                   ProblemTestSetSlotKind
  ownerType              String
  ownerId                String
  status                 ProblemTestSetReaderStatus @default(ACTIVE)
  fencingToken           Int
  acquiredAt             DateTime                   @default(now())
  renewedAt              DateTime                   @default(now())
  expiresAt              DateTime?
  releasedAt             DateTime?
  Problem                Problem                    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Slot                   ProblemTestSetSlot         @relation(fields: [problemId, slot], references: [problemId, slot], onDelete: Cascade)
  ContestProblem         ContestProblem?            @relation("ContestProblemTestSetReader")
  JudgeRun               JudgeRun?                  @relation("JudgeRunTestSetReader")
  HackAttempt            ProblemHackAttempt?        @relation("HackAttemptTestSetReader")
  CandidateEvaluationRun CandidateEvaluationRun?    @relation("CandidateEvaluationTestSetReader")
  DataGenerationJob      ProblemDataGenerationJob?  @relation("DataGenerationTestSetReader")
  QualityEvaluationJob   QualityEvaluationJob?      @relation("QualityEvaluationTestSetReader")

  @@unique([problemId, slot, ownerType, ownerId])
  @@index([problemId, slot, status, expiresAt])
}

model ProblemTestSetWriter {
  id           String                     @id @default(uuid())
  problemId    String
  slot         ProblemTestSetSlotKind
  sourceType   String
  sourceId     String?
  requestedBy  String?
  requestHash  String
  status       ProblemTestSetWriterStatus @default(QUEUED)
  requestedAt  DateTime                   @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  errorCode    String?
  errorMessage String?                    @db.Text
  stagingPath  String?
  Problem      Problem                    @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, slot, requestHash])
  @@index([problemId, slot, status, requestedAt])
}

model ProblemTestSetPromotionJob {
  id                      String    @id @default(uuid())
  problemId               String
  status                  String    @default("queued")
  evolvingGraphHash       String
  evolvingFencingToken    Int
  validationReport        Json?
  validatorPassed         Boolean?
  standardPassed          Boolean?
  acceptedReplayPassed    Boolean?
  knownWrongReplaySummary Json?
  requestedBy             String?
  startedAt               DateTime?
  finishedAt              DateTime?
  failureReason           String?
  createdAt               DateTime  @default(now())
  Problem                 Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, status, createdAt])
}

enum TrainingEngineSessionType {
  OI
  ACM
  GENERAL
}

enum TrainingEngineSessionStatus {
  READY
  RUNNING
  PAUSED
  ENDED
  ARCHIVED
}

enum TrainingRoundLifecycle {
  PENDING
  RUNNING
  ENDED
}

enum TrainingRoundEndReason {
  TIME_REACHED
  TEACHER_ADVANCED
  SESSION_ENDED
}

enum TrainingEngineTargetType {
  ALL
  GROUP
  USER
}

enum TrainingEngineProgressStatus {
  NOT_STARTED
  WORKING
  COMPLETED
}

model TrainingSession {
  id                   String                        @id @default(uuid())
  title                String
  description          String?                       @db.Text
  sessionType          TrainingEngineSessionType     @default(GENERAL)
  status               TrainingEngineSessionStatus   @default(READY)
  organizationId       String?
  teamId               String?
  createdBy            String
  scheduledStartAt     DateTime?
  totalDurationSeconds Int
  startedAt            DateTime?
  runningSince         DateTime?
  pausedAt             DateTime?
  endedAt              DateTime?
  archivedAt           DateTime?
  currentRoundId       String?                       @unique
  activeElapsedSeconds Int                           @default(0)
  statusRevision       Int                           @default(0)
  commandSeq           Int                           @default(0)
  eventSeq             Int                           @default(0)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  Organization         Organization?                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  Team                 Team?                         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  Problems             TrainingSessionProblem[]
  Rounds               TrainingSessionRound[]        @relation("TrainingSessionRounds")
  CurrentRound         TrainingSessionRound?         @relation("TrainingSessionCurrentRound", fields: [currentRoundId], references: [id], onDelete: SetNull)
  Groups               TrainingSessionGroup[]
  GroupChanges         TrainingSessionGroupChange[]
  Participants         TrainingSessionParticipant[]
  Commands             TrainingSessionCommand[]
  Overlays             TrainingSessionOverlay[]
  Drafts               TrainingSessionProblemDraft[]
  Events               TrainingSessionEvent[]
  Submissions          Submission[]

  @@index([organizationId, status])
  @@index([teamId, status])
  @@index([createdBy, createdAt])
  @@index([status, scheduledStartAt])
}

model TrainingSessionProblem {
  id                  String                           @id @default(uuid())
  sessionId           String
  problemId           String
  alias               String?
  titleSnapshot       String
  statementsSnapshot  Json?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  Session             TrainingSession                  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Problem             Problem                          @relation(fields: [problemId], references: [id], onDelete: Restrict)
  Assignments         TrainingRoundProblemAssignment[]
  Progress            TrainingSessionProblemProgress[]
  Drafts              TrainingSessionProblemDraft[]
  ScoreEvents         TrainingSessionScoreEvent[]
  Overlays            TrainingSessionOverlay[]
  CurrentParticipants TrainingSessionParticipant[]     @relation("TrainingParticipantCurrentProblem")
  ReturnParticipants  TrainingSessionParticipant[]     @relation("TrainingParticipantReturnProblem")
  Submissions         Submission[]

  @@unique([sessionId, problemId])
  @@index([problemId])
}

model TrainingSessionRound {
  id                   String                           @id @default(uuid())
  sessionId            String
  name                 String
  orderIndex           Int
  lifecycle            TrainingRoundLifecycle           @default(PENDING)
  timeLimitSeconds     Int?
  startedAt            DateTime?
  runningSince         DateTime?
  activeElapsedSeconds Int                              @default(0)
  endedAt              DateTime?
  endReason            TrainingRoundEndReason?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  Session              TrainingSession                  @relation("TrainingSessionRounds", fields: [sessionId], references: [id], onDelete: Cascade)
  CurrentForSession    TrainingSession?                 @relation("TrainingSessionCurrentRound")
  Assignments          TrainingRoundProblemAssignment[]
  GroupChanges         TrainingSessionGroupChange[]
  Submissions          Submission[]

  @@unique([sessionId, orderIndex])
  @@index([sessionId, lifecycle, orderIndex])
}

model TrainingRoundProblemAssignment {
  id               String                 @id @default(uuid())
  roundId          String
  groupId          String
  sessionProblemId String
  orderIndex       Int
  active           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  Round            TrainingSessionRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  Group            TrainingSessionGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  SessionProblem   TrainingSessionProblem @relation(fields: [sessionProblemId], references: [id], onDelete: Cascade)

  @@unique([roundId, groupId, sessionProblemId])
  @@unique([roundId, groupId, orderIndex])
  @@index([groupId, active])
  @@index([sessionProblemId])
}

model TrainingSessionParticipant {
  id                      String                           @id @default(uuid())
  sessionId               String
  userId                  String
  groupId                 String
  status                  String                           @default("active")
  currentSessionProblemId String?
  returnSessionProblemId  String?
  joinedAt                DateTime                         @default(now())
  lastHeartbeatAt         DateTime?
  activeSeconds           Int                              @default(0)
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  Session                 TrainingSession                  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User                    User                             @relation(fields: [userId], references: [id], onDelete: Restrict)
  Group                   TrainingSessionGroup             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  CurrentProblem          TrainingSessionProblem?          @relation("TrainingParticipantCurrentProblem", fields: [currentSessionProblemId], references: [id], onDelete: SetNull)
  ReturnProblem           TrainingSessionProblem?          @relation("TrainingParticipantReturnProblem", fields: [returnSessionProblemId], references: [id], onDelete: SetNull)
  Progress                TrainingSessionProblemProgress[]
  ScoreEvents             TrainingSessionScoreEvent[]
  GroupChanges            TrainingSessionGroupChange[]

  @@unique([sessionId, userId])
  @@index([userId, status])
  @@index([sessionId, groupId])
  @@index([currentSessionProblemId])
}

model TrainingSessionGroup {
  id           String                           @id @default(uuid())
  sessionId    String
  name         String
  orderIndex   Int                              @default(0)
  status       String                           @default("active")
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  Session      TrainingSession                  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Participants TrainingSessionParticipant[]
  Assignments  TrainingRoundProblemAssignment[]
  ChangesFrom  TrainingSessionGroupChange[]     @relation("TrainingGroupChangeFrom")
  ChangesTo    TrainingSessionGroupChange[]     @relation("TrainingGroupChangeTo")

  @@unique([sessionId, name])
  @@unique([sessionId, orderIndex])
  @@index([sessionId, status])
}

model TrainingSessionGroupChange {
  id            String                     @id @default(uuid())
  sessionId     String
  participantId String
  fromGroupId   String?
  toGroupId     String
  targetRoundId String?
  reason        String                     @db.Text
  changedBy     String
  appliedAt     DateTime                   @default(now())
  createdAt     DateTime                   @default(now())
  Session       TrainingSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Participant   TrainingSessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
