generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  School    School   @relation(fields: [schoolId], references: [id])
  User      User     @relation(fields: [userId], references: [id])
}

model AiUsageLog {
  id          String   @id @default(cuid())
  userId      String
  problemId   String
  action      String
  sourceLang  String?
  targetLang  String?
  model       String?
  tokensUsed  Int      @default(0)
  status      String   @default("success")
  message     String?
  createdAt   DateTime @default(now())
  statementId String?

  @@index([userId, createdAt])
  @@index([userId, problemId, action, createdAt])
}

model Contest {
  id                  String                @id @default(cuid())
  title               String
  description         String?
  contestDate         DateTime
  status              String                @default("upcoming")
  type                String                @default("mock")
  teamId              String?
  countRating         Boolean               @default(false)
  scope               String                @default("public")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Team                Team?                 @relation(fields: [teamId], references: [id])
  ContestProblem      ContestProblem[]
  ContestProblemNote  ContestProblemNote[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]
  ContestResult       ContestResult[]

  @@index([contestDate])
  @@index([scope])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
}

model ContestProblem {
  id                  String                @id @default(cuid())
  contestId           String
  orderIndex          Int
  title               String?
  description         String?
  ojName              String?
  problemId           String?
  isCustom            Boolean               @default(false)
  difficulty          String?
  points              Int?
  statementType       String                @default("none")
  statementMarkdown   String?
  solutionType        String                @default("none")
  solutionMarkdown    String?
  solutionVisible     Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Contest             Contest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblemNote  ContestProblemNote[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]

  @@unique([contestId, orderIndex])
}

model ContestProblemNote {
  id             String         @id @default(cuid())
  contestId      String
  problemId      String
  studentId      String
  content        String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  Contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId, studentId])
  @@index([studentId])
  @@index([updatedAt])
}

model ContestProblemScore {
  id             String         @id @default(cuid())
  contestId      String
  problemId      String
  studentId      String
  score          Float?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  Contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId, studentId])
}

model ContestResource {
  id               String          @id @default(cuid())
  contestId        String
  contestProblemId String?
  fileName         String
  fileType         String
  fileFormat       String          @default("pdf")
  fileUrl          String
  visibleRoles     String          @default("all")
  uploadedBy       String
  uploadedAt       DateTime        @default(now())
  Contest          Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem   ContestProblem? @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
}

model ContestResult {
  id           String   @id @default(cuid())
  contestId    String
  studentId    String
  rank         Int?
  score        Float?
  ratingBefore Int
  ratingAfter  Int
  ratingChange Int
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  Student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, studentId])
  @@index([createdAt])
  @@index([studentId])
}

model File {
  id           String    @id @default(cuid())
  storageType  String    @default("local")
  disk         String    @default("default")
  relativePath String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  md5Hash      String?
  sha256Hash   String?
  accessLevel  String    @default("private")
  isPublic     Boolean   @default(false)
  ownerType    String
  ownerId      String
  category     String
  status       String    @default("active")
  deletedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([category])
  @@index([md5Hash])
  @@index([ownerType, ownerId])
  @@index([status, deletedAt])
  @@index([storageType, disk])
}

model LoginLog {
  id            String   @id @default(cuid())
  userId        String?
  username      String
  loginRole     String
  userRole      String?
  result        String
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([result])
  @@index([username])
}

model Milestone {
  id            String   @id @default(cuid())
  studentId     String
  teacherId     String
  title         String
  description   String?
  milestoneDate DateTime
  type          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Teacher       Teacher  @relation(fields: [teacherId], references: [id])

  @@index([milestoneDate])
  @@index([studentId])
  @@index([teacherId])
}

model OjAccount {
  id                          String       @id @default(cuid())
  platform                    String
  username                    String
  password                    String?
  passwordIV                  String?
  cookie                      String?
  cookieRaw                   String?
  status                      String       @default("unverified")
  lastVerifiedAt              DateTime?
  lastErrorMessage            String?
  loginMethod                 String       @default("cookie")
  addedBy                     String
  lastLoginAt                 DateTime?
  lastLoginFailureAt          DateTime?
  lastSubmitAt                DateTime?
  lastRateLimitAt             DateTime?
  consecutiveFailures         Int          @default(0)
  rateLimitCount              Int          @default(0)
  totalSubmissions            Int          @default(0)
  totalSubmissionErrors       Int          @default(0)
  enabled                     Boolean      @default(true)
  priority                    Int          @default(0)
  maxConsecutiveFailures      Int          @default(3)
  freezeDurationMinutes       Int          @default(30)
  submitMaxRetries            Int          @default(1)
  retryIntervalSeconds        Int          @default(10)
  minSubmitIntervalSeconds    Int          @default(30)
  minRequestIntervalSeconds   Int          @default(3)
  maxConcurrentSubmissions    Int          @default(1)
  maxConcurrentRequests       Int          @default(2)
  loginFailureCooldownMinutes Int          @default(15)
  cookieValidMinutes          Int          @default(3600)
  renewLoginThresholdMinutes  Int          @default(10)
  reverifyIntervalMinutes     Int          @default(30)
  autoVerifyIntervalMinutes   Int          @default(1440)
  firstPollDelaySeconds       Int          @default(5)
  pollIntervalSeconds         Int          @default(5)
  maxWaitDurationMinutes      Int          @default(10)
  rateLimitThreshold          Int          @default(2)
  banSuspicionCooldownHours   Int          @default(6)
  createdAt                   DateTime     @default(now())
  updatedAt DateTime @updatedAt
  Submission                  Submission[]

  @@unique([platform, username])
  @@index([platform])
  @@index([status])
}

model OjFetchJob {
  id               String   @id @default(cuid())
  platform         String
  problemId        String
  status           String   @default("pending")
  message          String?
  hasAttachment    Boolean  @default(false)
  attachmentStatus String?
  createdProblemId String?
  createdAt        DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, problemId])
  @@index([createdAt])
  @@index([status])
}

model OjPlatformConfig {
  id         String    @id @default(cuid())
  platform   String    @unique
  cookies    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetLog {
  id             String   @id @default(cuid())
  targetUserId   String
  operatorUserId String
  operatorRole   String
  resetMethod    String
  result         String
  message        String?
  createdAt      DateTime @default(now())
}

model PrincipalTransferLog {
  id                    String   @id @default(cuid())
  schoolId              String
  oldPrincipalTeacherId String?
  newPrincipalTeacherId String
  operatorUserId        String
  result                String
  message               String?
  createdAt             DateTime @default(now())
  School                School   @relation(fields: [schoolId], references: [id])
}

model Problem {
  id                String              @id @default(cuid())
  platform          String
  problemId         String
  title             String
  description       String?
  statementType     String              @default("none")
  statementPdfUrl   String?
  solutionType      String              @default("none")
  solutionMarkdown  String?
  solutionPdfUrl    String?
  solutionVisible   Boolean             @default(false)
  difficulty        String?
  timeLimit         Int?
  memoryLimit       Int?
  judgeConfig       String?
  problemType       String              @default("default")
  visibility        String              @default("private")
  ownerType         String              @default("teacher")
  ownerId           String
  status            String              @default("draft")
  createdAt         DateTime            @default(now())
  updatedAt DateTime @updatedAt
  allowedLanguages  String?
  ojBindings        String?
  ProblemAttachment ProblemAttachment[]
  ProblemListEntry  ProblemListEntry[]
  ProblemNote       ProblemNote[]
  ProblemStatement  ProblemStatement[]
  TestdataFile      TestdataFile[]
  TrainingProblem   TrainingProblem[]

  @@unique([platform, problemId])
  @@index([createdAt])
  @@index([ownerId, ownerType])
  @@index([visibility])
  @@index([visibility, status])
}

model ProblemAttachment {
  id          String   @id @default(cuid())
  problemId   String
  fileName    String
  fileSize    Int
  fileUrl     String
  description String?
  uploadedAt  DateTime @default(now())
  Problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model ProblemList {
  id                 String               @id @default(cuid())
  title              String
  description        String?
  coverUrl           String?
  schoolId           String?
  ownerId            String
  ownerType          String               @default("teacher")
  visibility         String               @default("private")
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt DateTime @updatedAt
  ProblemListSection ProblemListSection[]
  ProblemListShare   ProblemListShare[]
  SchoolProblemList  SchoolProblemList[]
  TeamProblemList    TeamProblemList[]

  @@index([createdAt])
  @@index([ownerId, ownerType])
  @@index([schoolId])
  @@index([visibility])
}

model ProblemListEntry {
  id                 String             @id @default(cuid())
  sectionId          String
  problemId          String
  sortOrder          Int                @default(0)
  alias              String?
  notes              String?
  ojName             String?
  createdAt          DateTime           @default(now())
  updatedAt DateTime @updatedAt
  Problem            Problem            @relation(fields: [problemId], references: [id])
  ProblemListSection ProblemListSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, problemId])
  @@index([problemId])
  @@index([sectionId])
}

model ProblemListSection {
  id               String             @id @default(cuid())
  problemListId    String
  title            String
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt DateTime @updatedAt
  ProblemListEntry ProblemListEntry[]
  ProblemList      ProblemList        @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@index([problemListId])
}

model ProblemListShare {
  id            String      @id @default(cuid())
  problemListId String
  targetType    String
  targetId      String
  permission    String      @default("view")
  sharedBy      String
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)

  @@unique([problemListId, targetType, targetId])
  @@index([sharedBy])
  @@index([targetType, targetId])
}

model ProblemNote {
  id        String   @id @default(cuid())
  problemId String
  userId    String
  userType  String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId, userType])
  @@index([updatedAt])
  @@index([userId])
}

model ProblemStatement {
  id        String   @id @default(cuid())
  problemId String
  type      String
  format    String
  language  String?
  content   String?
  fileUrl   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, type, format, language])
  @@index([problemId, type])
}

model School {
  id                        String                 @id @default(cuid())
  name                      String
  announcement              String?
  region                    String?
  schoolType                String?
  educationSystem           String?                @default("6-3-3")
  contactPerson             String?
  contactPhone              String?
  contactEmail              String?
  status                    String                 @default("active")
  currentPrincipalTeacherId String
  createdAt                 DateTime               @default(now())
  updatedAt DateTime @updatedAt
  Admin                     Admin[]
  PrincipalTransferLog      PrincipalTransferLog[]
  SchoolProblemList         SchoolProblemList[]
  Student                   Student[]
  Teacher                   Teacher[]
  Team                      Team[]
  User                      User[]
}

model SchoolProblemList {
  id            String      @id @default(cuid())
  schoolId      String
  problemListId String
  addedBy       String
  addedByRole   String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  School        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, problemListId])
  @@index([addedBy])
  @@index([problemListId])
  @@index([schoolId])
}

model Student {
  id                        String                      @id @default(cuid())
  userId                    String                      @unique
  name                      String
  gender                    String?
  schoolId                  String
  enrollmentYear            Int?
  targetContest             String?
  headTeacherId             String?
  tags                      String?
  notes                     String?
  avatar                    String?
  rating                    Int                         @default(1200)
  createdAt                 DateTime                    @default(now())
  updatedAt DateTime @updatedAt
  ContestProblemNote        ContestProblemNote[]
  ContestProblemScore       ContestProblemScore[]
  ContestResult             ContestResult[]
  Milestone                 Milestone[]
  Teacher                   Teacher?                    @relation(fields: [headTeacherId], references: [id])
  School                    School                      @relation(fields: [schoolId], references: [id])
  User                      User                        @relation(fields: [userId], references: [id])
  TeamJoinRequest           TeamJoinRequest[]
  TeamMemberExternalAccount TeamMemberExternalAccount[]

  @@index([enrollmentYear])
  @@index([headTeacherId])
  @@index([rating])
  @@index([schoolId, headTeacherId])
  @@index([schoolId])
}

model Submission {
  id                Int        @id @default(autoincrement())
  userId            String
  oj                String
  problemId         String
  language          String
  code              String
  codeLength        Int
  result            String     @default("queuing")
  timeUsed          Int?
  memoryUsed        Int?
  submitMethod      String
  ojAccountId       String?
  ojRemoteId        String?
  errorMessage      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  problemInternalId String?
  cases             String?
  score             Int?
  subtasks          String?
  isGlobalVisible   Boolean    @default(true)
  sourceId          String?
  submitSource      String?
  OjAccount         OjAccount? @relation(fields: [ojAccountId], references: [id])
  User              User       @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([createdAt, result])
  @@index([isGlobalVisible])
  @@index([language])
  @@index([oj])
  @@index([problemId])
  @@index([result])
  @@index([sourceId])
  @@index([submitSource])
  @@index([userId])
  @@index([userId, oj, problemId])
}

model Teacher {
  id        String      @id @default(cuid())
  userId    String      @unique
  name      String
  email     String?
  phone     String?
  avatar    String?
  bio       String?
  title     String?
  status    String      @default("active")
  schoolId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime @updatedAt
  Milestone Milestone[]
  Student   Student[]
  School    School      @relation(fields: [schoolId], references: [id])
  User      User        @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([schoolId])
  @@index([status])
}

model Team {
  id                        String                      @id @default(cuid())
  name                      String
  avatar                    String?
  description               String?
  announcement              String?
  schoolId                  String
  isPublic                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt DateTime @updatedAt
  Contest                   Contest[]
  School                    School                      @relation(fields: [schoolId], references: [id])
  TeamJoinRequest           TeamJoinRequest[]
  TeamMember                TeamMember[]
  TeamMemberExternalAccount TeamMemberExternalAccount[]
  TeamMemberImportBatch     TeamMemberImportBatch[]
  TeamProblemList           TeamProblemList[]
  Training                  Training[]

  @@index([createdAt])
  @@index([isPublic])
  @@index([schoolId])
  @@index([schoolId, isPublic])
}

model TeamJoinRequest {
  id          String    @id @default(cuid())
  teamId      String
  studentId   String
  status      String    @default("pending")
  message     String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  processedBy String?
  Student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Team        Team      @relation(fields: [teamId], references: [id])

  @@unique([teamId, studentId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  userType  String
  role      String
  status    String   @default("active")
  joinedAt  DateTime @default(now())
  invitedBy String?
  Team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, userType])
  @@index([status])
  @@index([teamId, role])
  @@index([teamId, status, role])
  @@index([userId, userType, status])
}

model TeamMemberExternalAccount {
  id               String   @id @default(cuid())
  teamId           String
  studentId        String?
  platform         String
  platformUsername String
  displayName      String?
  status           String   @default("pending")
  inviteId         String?
  createdAt        DateTime @default(now())
  updatedAt DateTime @updatedAt
  Student          Student? @relation(fields: [studentId], references: [id])
  Team             Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, platform, platformUsername])
  @@index([platform, platformUsername])
  @@index([studentId])
}

model TeamMemberImportBatch {
  id                   String                 @id @default(cuid())
  teamId               String?
  operatorId           String
  platform             String
  totalCount           Int
  successCount         Int                    @default(0)
  skipCount            Int                    @default(0)
  errorCount           Int                    @default(0)
  status               String                 @default("pending")
  rawInput             String?
  createdAt            DateTime               @default(now())
  completedAt          DateTime?
  Team                 Team?                  @relation(fields: [teamId], references: [id])
  TeamMemberImportItem TeamMemberImportItem[]

  @@index([operatorId])
  @@index([teamId])
}

model TeamMemberImportItem {
  id                    String                @id @default(cuid())
  batchId               String
  lineNumber            Int
  rawUsername           String
  rawStudentName        String?
  parsedUsername        String?
  candidateDisplayName  String?
  matchType             String
  matchStatus           String                @default("pending")
  matchedStudentId      String?
  matchedStudentName    String?
  createdStudentId      String?
  action                String?
  userChoice            String?
  errorMessage          String?
  createdAt             DateTime              @default(now())
  processedAt           DateTime?
  TeamMemberImportBatch TeamMemberImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([matchType])
}

model TeamOperationLog {
  id           String   @id @default(cuid())
  teamId       String
  operatorId   String
  operatorType String
  action       String
  targetId     String?
  targetType   String?
  oldValue     String?
  newValue     String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([operatorId])
  @@index([teamId])
}

model TeamProblemList {
  id            String      @id @default(cuid())
  teamId        String
  problemListId String
  addedBy       String
  addedByRole   String
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  ProblemList   ProblemList @relation(fields: [problemListId], references: [id], onDelete: Cascade)
  Team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, problemListId])
  @@index([addedBy])
  @@index([problemListId])
  @@index([teamId])
}

model TestdataFile {
  id         String   @id @default(cuid())
  problemId  String
  filename   String
  size       Int
  md5        String?
  uploadedAt DateTime @default(now())
  Problem    Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, filename])
  @@index([problemId])
}

model Training {
  id                  Int                   @id @default(autoincrement())
  teamId              String
  title               String
  description         String?
  format              String                @default("ioi")
  startTime           DateTime
  endTime             DateTime
  status              String                @default("upcoming")
  createdBy           String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  Team                Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  TrainingParticipant TrainingParticipant[]
  TrainingProblem     TrainingProblem[]

  @@index([startTime])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
}

model TrainingAttachment {
  id                String          @id @default(cuid())
  trainingProblemId String
  fileName          String
  fileUrl           String
  fileSize          Int
  uploadedBy        String
  uploadedAt        DateTime        @default(now())
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)

  @@index([trainingProblemId])
}

model TrainingParticipant {
  id         String   @id @default(cuid())
  trainingId Int
  userId     String
  userType   String
  joinedAt   DateTime @default(now())
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, userType])
  @@index([trainingId])
  @@index([userId])
}

model TrainingProblem {
  id                 String               @id @default(cuid())
  trainingId         Int
  problemId          String
  alias              String
  orderIndex         Int
  points             Int?
  createdAt          DateTime             @default(now())
  TrainingAttachment TrainingAttachment[]
  Problem            Problem              @relation(fields: [problemId], references: [id])
  Training           Training             @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  TrainingSolution   TrainingSolution?

  @@unique([trainingId, alias])
  @@unique([trainingId, orderIndex])
  @@index([problemId])
  @@index([trainingId])
}

model TrainingSolution {
  id                String          @id @default(cuid())
  trainingProblemId String          @unique
  content           String
  visible           Boolean         @default(false)
  createdBy         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
}

model User {
  id                  String                @id @default(cuid())
  username            String                @unique
  passwordHash        String
  role                String
  schoolId            String
  status              String                @default("active")
  avatar              String?
  phone               String?
  email               String?
  bio                 String?
  createdAt           DateTime              @default(now())
  updatedAt DateTime @updatedAt
  Admin               Admin?
  Student             Student?
  Submission          Submission[]
  Teacher             Teacher?
  School              School                @relation(fields: [schoolId], references: [id])
  UserPlatformBinding UserPlatformBinding[]

  @@index([createdAt])
  @@index([role])
  @@index([schoolId])
  @@index([status])
}

model UserPlatformBinding {
  id               String    @id @default(cuid())
  userId           String
  platform         String
  platformUsername String?
  bindingStatus    String    @default("unbound")
  bindingData      String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt DateTime @updatedAt
  platformConfig   String?
  platformUid      String?
  statusMessage    String?
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([platform])
  @@index([userId])
}

model UserStatusLog {
  id             String   @id @default(cuid())
  targetUserId   String
  operatorUserId String
  operatorRole   String
  oldStatus      String
  newStatus      String
  reason         String?
  createdAt      DateTime @default(now())
}

model carits_sequence {
  id     Int @id @default(1)
  nextId Int @default(1000)
}
