model ProblemTestSetRevisionSubtask {
  id           String                             @id
  revisionId   String
  subtaskId    Int
  score        Int
  orderIndex   Int
  Revision     ProblemTestSetRevision             @relation(fields: [revisionId], references: [id], onDelete: Cascade)
