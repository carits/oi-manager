enum TrainingEngineSessionType {
  OI
  ACM
  GENERAL
}

enum TrainingEngineSessionStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  ENDED
  ARCHIVED
}

enum TrainingEngineStageMode {
  FREE
  SEQUENTIAL
  FOCUS
  SCORE_PROGRESSIVE
  TEACHING
  REVIEW
  MOCK_CONTEST
}

enum TrainingEngineAdvanceMode {
  MANUAL
  TIME
  COMPLETION
  HYBRID
}

enum TrainingEngineProblemAccessMode {
  ALL
  STAGE_ONLY
  SEQUENTIAL
  FOCUS_ONLY
}

enum TrainingEngineSubmissionMode {
  ENABLED
  DISABLED
}

enum TrainingEnginePauseMode {
  SOFT
  HARD
}

enum TrainingEngineTargetType {
  ALL
  GROUP
  TEAM
  USER
}

enum TrainingEngineProgressStatus {
  NOT_STARTED
  WORKING
  STUCK
  COMPLETED
  SKIPPED
  PAUSED
  FOCUS_OVERRIDE
}

enum TrainingEngineRankingMode {
  OFF
  PROGRESS_ONLY
  SCORE
  ACM_RANKING
}

enum TrainingEnginePeerVisibility {
  NONE
  PROGRESS
  SCORE
  FULL
}

enum TrainingEngineJoinMode {
  CURRENT_STAGE
  FROM_BEGINNING
  TEACHER_ASSIGN
}

enum TrainingEngineHintOpenMode {
  MANUAL
  TIME
  ATTEMPT
  SCORE
}

model TrainingSession {
  id                         String                      @id @default(uuid())
  legacyTrainingId           Int?                        @unique
  title                      String
  description                String?                     @db.Text
  sessionType                TrainingEngineSessionType  @default(GENERAL)
  status                     TrainingEngineSessionStatus @default(DRAFT)
  organizationId             String?
  teamId                     String?
  createdBy                  String
  scheduledStartAt           DateTime?
  startedAt                  DateTime?
  runningSince               DateTime?
  pausedAt                   DateTime?
  endedAt                    DateTime?
  archivedAt                 DateTime?
  activeElapsedSeconds       Int                         @default(0)
  currentStageId             String?
  statusRevision             Int                         @default(0)
  commandSeq                 Int                         @default(0)
  eventSeq                   Int                         @default(0)
  defaultProblemAccessMode   TrainingEngineProblemAccessMode @default(STAGE_ONLY)
  defaultSubmissionMode      TrainingEngineSubmissionMode @default(ENABLED)
  pauseMode                  TrainingEnginePauseMode?
  allowHints                 Boolean                     @default(true)
  allowSolution              Boolean                     @default(false)
  allowDiscussion            Boolean                     @default(false)
  rankingMode                TrainingEngineRankingMode   @default(PROGRESS_ONLY)
  peerVisibility             TrainingEnginePeerVisibility @default(PROGRESS)
  joinMode                   TrainingEngineJoinMode      @default(CURRENT_STAGE)
  settings                   Json?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  Organization               Organization?               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  Team                       Team?                       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  Stages                     TrainingSessionStage[]
  Participants               TrainingSessionParticipant[]
  Groups                     TrainingSessionGroup[]
  Commands                   TrainingSessionCommand[]
  Overlays                   TrainingSessionOverlay[]
  Drafts                     TrainingSessionProblemDraft[]
  Hints                      TrainingSessionHint[]
  Events                     TrainingSessionEvent[]
  Overrides                  TrainingSessionUserOverride[]
  Submissions                Submission[]

  @@index([organizationId, status])
  @@index([teamId, status])
  @@index([createdBy, createdAt])
  @@index([status, scheduledStartAt])
}

model TrainingSessionStage {
  id                        String                         @id @default(uuid())
  sessionId                 String
  name                      String
  description               String?                        @db.Text
  orderIndex                Int
  mode                      TrainingEngineStageMode       @default(FREE)
  durationSeconds           Int?
  advanceMode               TrainingEngineAdvanceMode     @default(MANUAL)
  problemAccessMode         TrainingEngineProblemAccessMode @default(STAGE_ONLY)
  submissionMode            TrainingEngineSubmissionMode  @default(ENABLED)
  targetScore               Int?
  completionThreshold       Int?
  minDurationSeconds        Int?
  status                    String                         @default("pending")
  rules                     Json?
  startedAt                 DateTime?
  endedAt                   DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  Session                   TrainingSession                @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Problems                  TrainingSessionStageProblem[]

  @@unique([sessionId, orderIndex])
  @@index([sessionId, status])
}

model TrainingSessionStageProblem {
  id                       String                 @id @default(uuid())
  stageId                  String
  problemId                String
  testSetRevisionId        String
  alias                    String?
  orderIndex               Int
  unlockPolicy             Json?
  targetScore              Int?
  timeLimitSeconds         Int?
  hintPolicy               Json?
  judgeConfigProjection    String?                @db.Text
  allowedSubtaskIds        Json?
  strategyIntervalSeconds  Int?
  maxContinuousWorkSeconds Int?
  forceSwitchOnTimeout     Boolean                @default(false)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  Stage                    TrainingSessionStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  Problem                  Problem                @relation(fields: [problemId], references: [id], onDelete: Restrict)
  TestSetRevision          ProblemTestSetRevision @relation(fields: [testSetRevisionId], references: [id], onDelete: Restrict)
  Progress                 TrainingSessionProblemProgress[]
  Hints                    TrainingSessionHint[]
  ScoreEvents              TrainingSessionScoreEvent[]
  StrategyDecisions        TrainingSessionStrategyDecision[]
  Submissions              Submission[]

  @@unique([stageId, problemId])
  @@unique([stageId, orderIndex])
  @@index([problemId])
  @@index([testSetRevisionId])
}

model TrainingSessionGroup {
  id          String                       @id @default(uuid())
  sessionId   String
  name        String
  orderIndex  Int                          @default(0)
  createdAt   DateTime                     @default(now())
  Session     TrainingSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Participants TrainingSessionParticipant[]

  @@unique([sessionId, name])
  @@index([sessionId, orderIndex])
}

model TrainingSessionParticipant {
  id                String                       @id @default(uuid())
  sessionId         String
  userId            String
  groupId           String?
  status            String                       @default("active")
  currentStageId    String?
  currentProblemId  String?
  returnStageId     String?
  returnProblemId   String?
  joinedAt          DateTime                     @default(now())
  lastHeartbeatAt   DateTime?
  activeSeconds     Int                          @default(0)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  Session           TrainingSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User              User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  Group             TrainingSessionGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  Progress          TrainingSessionProblemProgress[]
  HintAccess        TrainingSessionHintAccess[]
  ScoreEvents       TrainingSessionScoreEvent[]
  StrategyDecisions TrainingSessionStrategyDecision[]

  @@unique([sessionId, userId])
  @@index([userId, status])
  @@index([sessionId, groupId])
}

model TrainingSessionProblemProgress {
  id                 String                       @id @default(uuid())
  participantId      String
  stageProblemId     String
  status             TrainingEngineProgressStatus @default(NOT_STARTED)
  firstOpenedAt      DateTime?
  lastOpenedAt       DateTime?
  activeSeconds      Int                          @default(0)
  continuousActiveSeconds Int                     @default(0)
  attemptCount       Int                          @default(0)
  bestScore          Int?
  bestVerdict        String?
  acAt               DateTime?
  hintCount          Int                          @default(0)
  highestHintLevel   Int                          @default(0)
  lastSubmissionAt   DateTime?
  lastScoreImprovedAt DateTime?
  lastProgressAt     DateTime?
  stuckDetectedAt    DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  Participant        TrainingSessionParticipant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  StageProblem       TrainingSessionStageProblem  @relation(fields: [stageProblemId], references: [id], onDelete: Cascade)

  @@unique([participantId, stageProblemId])
  @@index([stageProblemId, status])
  @@index([participantId, lastProgressAt])
}

model TrainingSessionCommand {
  id          String                   @id @default(uuid())
  sessionId   String
  seq         Int
  type        String
  targetType  TrainingEngineTargetType @default(ALL)
  targetId    String?
  payload     Json?
  createdBy   String
  createdAt   DateTime                 @default(now())
  Session     TrainingSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([sessionId, createdAt])
}

model TrainingSessionOverlay {
  id             String                   @id @default(uuid())
  sessionId      String
  type           String
  targetType     TrainingEngineTargetType @default(ALL)
  targetId       String?
  stageProblemId String?
  payload        Json?
  status         String                   @default("active")
  startedAt      DateTime                 @default(now())
  expiresAt      DateTime?
  endedAt        DateTime?
  createdBy      String
  Session        TrainingSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status, startedAt])
  @@index([expiresAt, status])
}

model TrainingSessionUserOverride {
  id                 String                   @id @default(uuid())
  sessionId          String
  userId             String
  type               String
  stageProblemId     String?
  payload            Json?
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdBy          String
  createdAt          DateTime                 @default(now())
  Session            TrainingSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, userId, type])
  @@index([expiresAt])
}

model TrainingSessionProblemDraft {
  id               String          @id @default(uuid())
  sessionId        String
  userId           String
  problemId        String
  language         String
  code             String          @db.Text
  inputFilename    String?
  outputFilename   String?
  revision         Int             @default(1)
  editorFocused    Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  Session          TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, problemId])
  @@index([userId, updatedAt])
}

model TrainingSessionHint {
  id                       String                       @id @default(uuid())
  sessionId                String
  stageProblemId           String
  level                    Int
  title                    String?
  content                  String                       @db.Text
  openMode                 TrainingEngineHintOpenMode   @default(MANUAL)
  triggerSeconds           Int?
  triggerAttempts          Int?
  triggerScore             Int?
  globallyOpenedAt         DateTime?
  createdBy                String
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  Session                  TrainingSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  StageProblem             TrainingSessionStageProblem  @relation(fields: [stageProblemId], references: [id], onDelete: Cascade)
  Access                   TrainingSessionHintAccess[]

  @@unique([stageProblemId, level])
  @@index([sessionId, level])
}

model TrainingSessionHintAccess {
  id             String                     @id @default(uuid())
  hintId         String
  participantId  String
  openedAt       DateTime                   @default(now())
  source         String
  openedBy       String?
  Hint           TrainingSessionHint        @relation(fields: [hintId], references: [id], onDelete: Cascade)
  Participant    TrainingSessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([hintId, participantId])
  @@index([participantId, openedAt])
}

model TrainingSessionScoreEvent {
  id               String                       @id @default(uuid())
  sessionId        String
  participantId    String
  stageProblemId   String
  submissionId     Int
  score            Int?
  verdict          String?
  createdAt        DateTime                     @default(now())
  Participant      TrainingSessionParticipant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  StageProblem     TrainingSessionStageProblem  @relation(fields: [stageProblemId], references: [id], onDelete: Cascade)

  @@unique([submissionId])
  @@index([sessionId, participantId, createdAt])
  @@index([stageProblemId, createdAt])
}

model TrainingSessionStrategyDecision {
  id               String                       @id @default(uuid())
  sessionId        String
  participantId    String
  stageProblemId   String?
  decision         String
  reason           String?
  activeSecondsAtDecision Int                     @default(0)
  createdAt        DateTime                     @default(now())
  Participant      TrainingSessionParticipant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  StageProblem     TrainingSessionStageProblem? @relation(fields: [stageProblemId], references: [id], onDelete: SetNull)

  @@index([sessionId, participantId, createdAt])
}

model TrainingSessionEvent {
  id          BigInt          @id @default(autoincrement())
  sessionId   String
  seq         Int
  type        String
  targetType  TrainingEngineTargetType @default(ALL)
  targetId    String?
  payload     Json?
  createdAt   DateTime        @default(now())
  expiresAt   DateTime
  Session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
  @@index([sessionId, createdAt])
  @@index([expiresAt])
}

model TrainingSessionTemplate {
  id          String                    @id @default(uuid())
  organizationId String?
  teamId      String?
  key         String
  name        String
  sessionType TrainingEngineSessionType
  description String?
  settings    Json?
  status      String                    @default("active")
  createdBy   String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  Stages      TrainingSessionTemplateStage[]

  @@unique([organizationId, teamId, key])
  @@index([organizationId, status])
  @@index([teamId, status])
}

model TrainingSessionTemplateStage {
  id            String                         @id @default(uuid())
  templateId    String
  name          String
  description   String?
  orderIndex    Int
  mode          TrainingEngineStageMode
  durationSeconds Int?
  advanceMode   TrainingEngineAdvanceMode
  rules         Json?
  Template      TrainingSessionTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, orderIndex])
}

model Training {
  id                        Int                         @id @default(autoincrement())
  teamId                    String?
  title                     String
  description               String?
  format                    String                      @default("ioi")
  startTime                 DateTime
  endTime                   DateTime
  status                    String                      @default("upcoming")
  createdBy                 String
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now())
  includeAdminInRanking     Boolean                     @default(false)
  problemIdVisible          Boolean                     @default(false)
  solutionVisible           Boolean                     @default(false)
  type                      String                      @default("training")
  scope                     String                      @default("campus")
  organizationId            String?
  sourceTrainingId          Int?
  ContestRecord             ContestRecord[]
  ContestUserProblemStatus  ContestUserProblemStatus[]
  Submission                Submission[]
  Organization              Organization?               @relation(fields: [organizationId], references: [id])
  Team                      Team?                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  TrainingParticipant       TrainingParticipant[]
  TrainingProblem           TrainingProblem[]
  TrainingUserProblemStatus TrainingUserProblemStatus[]

  @@index([organizationId])
  @@index([scope])
  @@index([scope, status])
  @@index([startTime])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
}

model TrainingAttachment {
  id                String          @id
  trainingProblemId String
  fileName          String
  fileUrl           String
  fileSize          Int
  uploadedBy        String
  uploadedAt        DateTime        @default(now())
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)

  @@index([trainingProblemId])
}

model TrainingParticipant {
  id         String   @id
  trainingId Int
  userId     String
  userType   String
  joinedAt   DateTime @default(now())
  Training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, userType])
  @@index([trainingId])
  @@index([userId])
}

model TrainingProblem {
  id                        String                           @id
  trainingId                Int
  problemId                 String
  alias                     String?
  orderIndex                Int
  points                    Int?
  createdAt                 DateTime                         @default(now())
  dataVersion               String?
  snapshotCreatedAt         DateTime?
  statementSnapshot         String?
  titleSnapshot             String?
  statementsSnapshotJson    String?                          @db.Text
  timeLimitSnapshot         Int?
  memoryLimitSnapshot       Int?
  judgeConfigSnapshot       String?                          @db.Text
  testGraphRevisionSnapshot Int?
  testSetRevisionId         String?
  allowedLanguagesSnapshot  String?
  sourcePlatformSnapshot    String?
  sourceProblemIdSnapshot   String?
  sourceUrlSnapshot         String?
  ContestUserProblemStatus  ContestUserProblemStatus[]
  TrainingAttachment        TrainingAttachment[]
  Problem                   Problem                          @relation(fields: [problemId], references: [id])
  TestSetRevision           ProblemTestSetRevision?          @relation(fields: [testSetRevisionId], references: [id], onDelete: SetNull)
  Training                  Training                         @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  TrainingSolution          TrainingSolution?
  ContentSnapshot           TrainingProblemContentSnapshot[]
  StatementSet              TrainingProblemStatementSet[]
  TrainingUserProblemStatus TrainingUserProblemStatus[]

  @@unique([trainingId, alias])
  @@unique([trainingId, orderIndex])
  @@index([problemId])
  @@index([trainingId])
  @@index([testSetRevisionId])
}

model TrainingProblemStatementSet {
  id                String                             @id
  trainingProblemId String
  revision          Int
  selectedBy        String
  selectedAt        DateTime                           @default(now())
  TrainingProblem   TrainingProblem                    @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
  Snapshot          TrainingProblemStatementSnapshot[]

  @@unique([trainingProblemId, revision])
  @@index([trainingProblemId, revision])
}

model TrainingProblemStatementSnapshot {
  id                     String                      @id
  statementSetId         String
  sourceType             String
  sourceContentId        String?
  name                   String
  title                  String?
  language               String?
  format                 String
  content                String?                     @db.Text
  snapshotFileId         String?
  fileName               String?
  authorUserId           String?
  authorUsernameSnapshot String?
  isDefault              Boolean                     @default(false)
  orderIndex             Int
  StatementSet           TrainingProblemStatementSet @relation(fields: [statementSetId], references: [id], onDelete: Cascade)

  @@unique([statementSetId, orderIndex])
  @@index([statementSetId, isDefault])
  @@index([sourceContentId])
}

model TrainingProblemContentSnapshot {
  id                     String          @id
  trainingProblemId      String
  kind                   String
  revision               Int
  sourceType             String
  sourceContentId        String?
  sourceRevision         Int?
  format                 String
  language               String?
  title                  String?
  content                String?         @db.Text
  snapshotFileId         String?
  fileName               String?
  authorUserId           String?
  authorUsernameSnapshot String?
  selectedBy             String
  selectedAt             DateTime        @default(now())
  TrainingProblem        TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)

  @@unique([trainingProblemId, kind, revision])
  @@index([trainingProblemId, kind, revision])
  @@index([sourceContentId])
}

model TrainingSolution {
  id                String          @id
  trainingProblemId String          @unique
  content           String
  visible           Boolean         @default(false)
  createdBy         String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now())
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
}

model TrainingUserProblemStatus {
  id                String          @id
  trainingId        Int
  userId            String
  trainingProblemId String
  bestScore         Int?
  bestResult        String?
  attemptCount      Int             @default(0)
  acAt              DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now())
  Training          Training        @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  TrainingProblem   TrainingProblem @relation(fields: [trainingProblemId], references: [id], onDelete: Cascade)
  User              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId, trainingProblemId])
  @@index([trainingId, userId])
  @@index([userId])
}

model User {
  id                                       String                            @id
  username                                 String                            @unique
  passwordHash                             String
  // 平台角色仅表达平台级权限；校园身份由 OrganizationMembership 决定。
  role                                     String                            @default("user")
  status                                   String                            @default("active")
  avatar                                   String?
  phone                                    String?
  email                                    String?
  bio                                      String?
  createdAt                                DateTime                          @default(now())
  updatedAt                                DateTime                          @default(now())
  PersonalProfile                          PersonalProfile?
  Problem                                  Problem[]                         @relation("ProblemOwner")
  ProblemHackAttempt                       ProblemHackAttempt[]
  ContestUserProblemStatus                 ContestUserProblemStatus[]
  Submission                               Submission[]
  TeamJoinRequest                          TeamJoinRequest[]
  TeamMember                               TeamMember[]
  TrainingUserProblemStatus                TrainingUserProblemStatus[]
  TrainingSessionParticipants              TrainingSessionParticipant[]
  UserArchivedProblem                      UserArchivedProblem[]
  UserPlatformBinding                      UserPlatformBinding[]
  UserNotification                         UserNotification[]
  UserProblemContent                       UserProblemContent[]
  OrganizationMembership                   OrganizationMembership[]
  OrganizationJoinApplications             OrganizationJoinApplication[]     @relation("JoinApplicationApplicant")
  ReviewedOrganizationJoinApplications     OrganizationJoinApplication[]     @relation("JoinApplicationReviewer")
  OrganizationCreationApplications         OrganizationCreationApplication[] @relation("OrganizationCreationApplicant")
  ReviewedOrganizationCreationApplications OrganizationCreationApplication[] @relation("OrganizationCreationReviewer")
  PlatformAuditLogs                        PlatformAuditLog[]
  OrganizationInvitations                  OrganizationInvitation[]          @relation("OrganizationInvitee")
  SentOrganizationInvitations              OrganizationInvitation[]          @relation("OrganizationInviter")
  CaritsAccount                            CaritsAccount?                    @relation("CaritsAccountUser")
  CaritsTransactions                       CaritsTransaction[]               @relation("CaritsTransactionOperator")
  ContributionEvents                       ContributionEvent[]               @relation("ContributionActor")
  ChatPrivacySetting                       ChatPrivacySetting?
  SentFriendRequests                       FriendRequest[]                   @relation("FriendRequestSender")
  ReceivedFriendRequests                   FriendRequest[]                   @relation("FriendRequestReceiver")
  LowFriendships                           Friendship[]                      @relation("FriendshipLowUser")
  HighFriendships                          Friendship[]                      @relation("FriendshipHighUser")
  RemovedFriendships                       Friendship[]                      @relation("FriendshipRemovedBy")
  BlocksCreated                            UserBlock[]                       @relation("UserBlockBlocker")
  BlocksReceived                           UserBlock[]                       @relation("UserBlockBlocked")
  LowDirectConversations                   DirectConversation[]              @relation("DirectConversationLowUser")
  HighDirectConversations                  DirectConversation[]              @relation("DirectConversationHighUser")
  DirectConversationMembers                DirectConversationMember[]
  SentDirectMessages                       DirectMessage[]
  ChatUserEvents                           ChatUserEvent[]
  ChatReportsFiled                         ChatReport[]                      @relation("ChatReportReporter")
  ChatReportsAgainst                       ChatReport[]                      @relation("ChatReportTarget")
  ChatReportsReviewed                      ChatReport[]                      @relation("ChatReportReviewer")
  CreatedChatStickerPacks                  ChatStickerPack[]                 @relation("ChatStickerPackCreator")
  ChatStickerImports                       ChatStickerImport[]               @relation("ChatStickerImportUploader")

  @@index([createdAt])
  @@index([role])
  @@index([status])
}

model ChatPrivacySetting {
  userId                      String   @id
  allowExactUsernameDiscovery Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  User                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FriendRequest {
  id          String    @id
  requesterId String
  addresseeId String
  message     String?   @db.VarChar(500)
  status      String    @default("pending")
  respondedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Requester   User      @relation("FriendRequestSender", fields: [requesterId], references: [id], onDelete: Restrict)
  Addressee   User      @relation("FriendRequestReceiver", fields: [addresseeId], references: [id], onDelete: Restrict)

  @@index([requesterId, status, createdAt])
  @@index([addresseeId, status, createdAt])
  @@index([expiresAt, status])
}

model Friendship {
  id          String    @id
  userLowId   String
  userHighId  String
  status      String    @default("active")
  acceptedAt  DateTime  @default(now())
  removedAt   DateTime?
  removedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  LowUser     User      @relation("FriendshipLowUser", fields: [userLowId], references: [id], onDelete: Restrict)
  HighUser    User      @relation("FriendshipHighUser", fields: [userHighId], references: [id], onDelete: Restrict)
  RemovedBy   User?     @relation("FriendshipRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([userLowId, userHighId])
  @@index([userLowId, status])
  @@index([userHighId, status])
}

model UserBlock {
  id        String   @id
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  Blocker   User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  Blocked   User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model DirectConversation {
  id                 String                     @id
  userLowId          String
  userHighId         String
  lastMessageSeq     Int                        @default(0)
  lastMessagePreview String?
  lastMessageAt      DateTime?
  lastActivityAt     DateTime                   @default(now())
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  LowUser            User                       @relation("DirectConversationLowUser", fields: [userLowId], references: [id], onDelete: Restrict)
  HighUser           User                       @relation("DirectConversationHighUser", fields: [userHighId], references: [id], onDelete: Restrict)
  Members            DirectConversationMember[]
  Messages           DirectMessage[]
  Reports            ChatReport[]

  @@unique([userLowId, userHighId])
  @@index([lastMessageAt])
  @@index([lastActivityAt, id])
}

model DirectConversationMember {
  id                String             @id
  conversationId    String
  userId            String
  lastReadSeq       Int                @default(0)
  unreadCount       Int                @default(0)
  archivedAt        DateTime?
  mutedUntil        DateTime?
  clearedThroughSeq Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  Conversation      DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User              User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId, archivedAt, updatedAt])
}

model DirectMessage {
  id              String             @id
  conversationId  String
  senderUserId    String
  clientMessageId String
  seq             Int
  content         String             @db.Text
  messageType     String             @default("text")
  stickerId       String?
  createdAt       DateTime           @default(now())
  Conversation    DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  Sender          User               @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  Sticker         ChatSticker?       @relation(fields: [stickerId], references: [id], onDelete: Restrict)
  Reports         ChatReport[]

  @@unique([conversationId, seq])
  @@unique([conversationId, senderUserId, clientMessageId])
  @@index([senderUserId, createdAt])
  @@index([stickerId])
}

model ChatStickerPack {
  id               String              @id
  key              String
  name             String
  version          Int
  status           String              @default("staged")
  sortOrder        Int                 @default(0)
  createdByUserId  String
  publishedAt      DateTime?
  retiredAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  CreatedBy        User                @relation("ChatStickerPackCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  Stickers         ChatSticker[]
  PublishedImports ChatStickerImport[] @relation("ChatStickerImportPublishedPack")

  @@unique([key, version])
  @@index([status, sortOrder, createdAt])
}

model ChatSticker {
  id           String          @id
  packId       String
  key          String
  label        String
  assetBlobId  String
  posterBlobId String
  mimeType     String
  width        Int
  height       Int
  frameCount   Int             @default(1)
  durationMs   Int             @default(0)
  sha256       String
  sortOrder    Int             @default(0)
  status       String          @default("active")
  createdAt    DateTime        @default(now())
  Pack         ChatStickerPack @relation(fields: [packId], references: [id], onDelete: Restrict)
  AssetBlob    BlobObject      @relation("ChatStickerAsset", fields: [assetBlobId], references: [id], onDelete: Restrict)
  PosterBlob   BlobObject      @relation("ChatStickerPoster", fields: [posterBlobId], references: [id], onDelete: Restrict)
  Messages     DirectMessage[]

  @@unique([packId, key])
  @@index([packId, status, sortOrder])
  @@index([assetBlobId])
  @@index([posterBlobId])
}

model ChatStickerImport {
  id               String           @id
  uploadedByUserId String
  status           String           @default("staged")
  reportHash       String
  manifest         Json
  report           Json
  publishedPackId  String?
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  UploadedBy       User             @relation("ChatStickerImportUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  PublishedPack    ChatStickerPack? @relation("ChatStickerImportPublishedPack", fields: [publishedPackId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([expiresAt])
}

model ChatUserEvent {
  id             BigInt   @id @default(autoincrement())
  userId         String
  eventType      String
  conversationId String?
  messageId      String?
  payload        Json?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([expiresAt])
}

model ChatReport {
  id                 String             @id
  conversationId     String
  messageId          String?
  reporterUserId     String
  targetUserId       String
  reason             String
  details            String?            @db.Text
  evidenceSnapshot   Json
  status             String             @default("pending")
  reviewedByUserId   String?
  reviewedAt         DateTime?
  resolutionNote     String?            @db.Text
  evidenceHoldUntil  DateTime?
  evidenceReleasedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  Conversation       DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  Message            DirectMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  Reporter           User               @relation("ChatReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  Target             User               @relation("ChatReportTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  ReviewedBy         User?              @relation("ChatReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([messageId, reporterUserId, status])
}

model ChatMaintenanceCursor {
  name      String   @id
  cursor    String?
  updatedAt DateTime @updatedAt
}

model UserNotification {
  id             String    @id
  userId         String
  scope          String
  contextType    String    @default("account")
  contextKey     String    @default("account")
  organizationId String?
  type           String
  title          String
  body           String
  href           String?
  sourceType     String
  sourceId       String
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contextKey, type, sourceType, sourceId])
  @@index([userId, scope, readAt, createdAt])
  @@index([userId, scope, createdAt])
  @@index([userId, contextKey, readAt, createdAt])
}

model UserArchivedProblem {
  id          String    @id
  userId      String
  platform    String
  problemId   String
  title       String?
  difficulty  String?
  tags        String?
  solvedAt    DateTime?
  sourceUrl   String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  ojRemoteId  String?
  result      String?
  submittedAt DateTime?
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, problemId])
  @@index([platform])
  @@index([userId])
  @@index([userId, platform])
}

model UserPlatformBinding {
  id               String    @id
  userId           String
  platform         String
  platformUsername String?
  bindingStatus    String    @default("unbound")
  bindingData      String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())
  platformConfig   String?
  platformUid      String?
  statusMessage    String?
  User             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([platform])
  @@index([userId])
}

model UserStatusLog {
  id           String   @id
  operatorRole String
  oldStatus    String
  newStatus    String
  reason       String?
  createdAt    DateTime @default(now())
  operatorId   String
  targetId     String
}

model carits_sequence {
  id     Int @id @default(1)
  nextId Int @default(1000)
}
