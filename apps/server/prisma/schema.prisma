  Problem             Problem                     @relation(fields: [problemId], references: [id], onDelete: Restrict)
  Progress            AssignmentProblemProgress[]
  Corrections         AssignmentCorrection[]
  Feedback            AssignmentFeedback[]
  ScoreAdjustments    AssignmentScoreAdjustment[]
  Submissions         Submission[]

  @@unique([assignmentId, problemId])
  @@unique([assignmentId, orderIndex])
  @@index([problemId])
}

model AssignmentRecipient {
  id               String                        @id @default(uuid())
  assignmentId     String
  userId           String
  membershipId     String
  source           String                        @default("snapshot")
  status           AssignmentRecipientStatus     @default(ASSIGNED)
  assignedAt       DateTime                      @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  dueAtEffective   DateTime
  closeAtEffective DateTime
  exemptReason     String?
