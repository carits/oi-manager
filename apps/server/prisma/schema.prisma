generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Admin {
  id        String   @id
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id])
}

model Contest {
  id                  String                @id
  title               String
  description         String?
  contestDate         DateTime
  status              String                @default("upcoming")
  type                String                @default("mock")
  teamId              String?
  countRating         Boolean               @default(false)
  scope               String                @default("public")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Team                Team?                 @relation(fields: [teamId], references: [id])
  ContestProblem      ContestProblem[]
  ContestProblemNote  ContestProblemNote[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]
  ContestResult       ContestResult[]

  @@index([teamId])
  @@index([status])
  @@index([scope])
  @@index([contestDate])
  @@index([teamId, status])
}

model ContestProblem {
  id                  String                @id
  contestId           String
  orderIndex          Int
  title               String?
  description         String?
  ojName              String?
  problemId           String?
  isCustom            Boolean               @default(false)
  difficulty          String?
  points              Int?
  statementType       String                @default("none")
  statementMarkdown   String?
  solutionType        String                @default("none")
  solutionMarkdown    String?
  solutionVisible     Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  Contest             Contest               @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblemNote  ContestProblemNote[]
  ContestProblemScore ContestProblemScore[]
  ContestResource     ContestResource[]

  @@unique([contestId, orderIndex])
}

model ContestProblemNote {
  id             String         @id
  contestId      String
  problemId      String
  studentId      String
  content        String         @default("")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  Contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId, studentId])
  @@index([studentId])
  @@index([updatedAt])
}

model ContestProblemScore {
  id             String         @id
  contestId      String
  problemId      String
  studentId      String
  score          Float?
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  Contest        Contest        @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem ContestProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  Student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId, studentId])
}

model ContestResource {
  id               String          @id
  contestId        String
  contestProblemId String?
  fileName         String
  fileType         String
  fileFormat       String          @default("pdf")
  fileUrl          String
  visibleRoles     String          @default("all")
  uploadedBy       String
  uploadedAt       DateTime        @default(now())
  Contest          Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  ContestProblem   ContestProblem? @relation(fields: [contestProblemId], references: [id], onDelete: Cascade)
}

model ContestResult {
  id           String   @id
  contestId    String
  studentId    String
  rank         Int?
  score        Float?
  ratingBefore Int
  ratingAfter  Int
  ratingChange Int
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  Student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, studentId])
  @@index([studentId])
  @@index([createdAt])
}

model File {
  id           String    @id
  storageType  String    @default("local")
  disk         String    @default("default")
  relativePath String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  md5Hash      String?
  sha256Hash   String?
  accessLevel  String    @default("private")
  isPublic     Boolean   @default(false)
  ownerType    String
  ownerId      String
  category     String
  status       String    @default("active")
  deletedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([category])
  @@index([status, deletedAt])
  @@index([md5Hash])
  @@index([ownerType, ownerId])
  @@index([storageType, disk])
}

model LoginLog {
  id            String   @id
  userId        String?
  username      String
  loginRole     String
  userRole      String?
  result        String
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([username])
  @@index([result])
  @@index([createdAt])
}

model Milestone {
  id            String   @id
  studentId     String
  teacherId     String
  title         String
  description   String?
  milestoneDate DateTime
  type          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Teacher       Teacher  @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([teacherId])
  @@index([milestoneDate])
}

model OjFetchJob {
  id               String   @id
  platform         String
  problemId        String
  status           String   @default("pending")
  message          String?
  hasAttachment    Boolean  @default(false)
  attachmentStatus String?
  createdProblemId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@unique([platform, problemId])
  @@index([status])
  @@index([createdAt])
}

model OjPlatformConfig {
  id         String    @id
  platform   String    @unique
  cookies    String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
}

model PasswordResetLog {
  id             String   @id
  targetUserId   String
  operatorUserId String
  operatorRole   String
  resetMethod    String
  result         String
  message        String?
  createdAt      DateTime @default(now())
}

model PrincipalTransferLog {
  id                    String   @id
  schoolId              String
  oldPrincipalTeacherId String?
  newPrincipalTeacherId String
  operatorUserId        String
  result                String
  message               String?
  createdAt             DateTime @default(now())
  School                School   @relation(fields: [schoolId], references: [id])
}

model Problem {
  id                String              @id
  problemCode       String              @unique
  title             String
  description       String?
  statementType     String              @default("none")
  statementPdfUrl   String?
  solutionType      String              @default("none")
  solutionMarkdown  String?
  solutionPdfUrl    String?
  solutionVisible   Boolean             @default(false)
  difficulty        String?
  timeLimit         Int?
  memoryLimit       Int?
  judgeConfig       String?
  visibility        String              @default("private")
  ownerType         String              @default("teacher")
  ownerId           String
  status            String              @default("draft")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  ojBindings        String?
  ProblemAttachment ProblemAttachment[]
  ProblemNote       ProblemNote[]
  ProblemStatement  ProblemStatement[]

  @@index([visibility])
  @@index([ownerId, ownerType])
  @@index([visibility, status])
  @@index([createdAt])
}

model ProblemAttachment {
  id          String   @id
  problemId   String
  fileName    String
  fileSize    Int
  fileUrl     String
  description String?
  uploadedAt  DateTime @default(now())
  Problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
}

model ProblemNote {
  id        String   @id
  problemId String
  userId    String
  userType  String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId, userType])
  @@index([userId])
  @@index([updatedAt])
}

model ProblemStatement {
  id        String   @id
  problemId String
  type      String
  format    String
  language  String?
  content   String?
  fileUrl   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, type, format, language])
  @@index([problemId, type])
}

model School {
  id                        String                 @id
  name                      String
  announcement              String?
  region                    String?
  schoolType                String?
  educationSystem           String?                @default("6-3-3")
  contactPerson             String?
  contactPhone              String?
  contactEmail              String?
  status                    String                 @default("active")
  currentPrincipalTeacherId String
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime
  PrincipalTransferLog      PrincipalTransferLog[]
  Student                   Student[]
  Teacher                   Teacher[]
  Team                      Team[]
}

model Student {
  id                  String                @id
  userId              String                @unique
  name                String
  gender              String?
  schoolId            String
  enrollmentYear      Int?
  targetContest       String?
  headTeacherId       String
  tags                String?
  notes               String?
  avatar              String?
  rating              Int                   @default(1200)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  ContestProblemNote  ContestProblemNote[]
  ContestProblemScore ContestProblemScore[]
  ContestResult       ContestResult[]
  Milestone           Milestone[]
  User                User                  @relation(fields: [userId], references: [id])
  School              School                @relation(fields: [schoolId], references: [id])
  Teacher             Teacher               @relation(fields: [headTeacherId], references: [id])
  TaskProgress        TaskProgress[]
  TeamJoinRequest     TeamJoinRequest[]

  @@index([schoolId])
  @@index([headTeacherId])
  @@index([rating])
  @@index([schoolId, headTeacherId])
  @@index([enrollmentYear])
}

model Task {
  id           String         @id
  taskListId   String
  title        String
  ojName       String?
  problemId    String?
  difficulty   String?
  points       Int?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  TaskList     TaskList       @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  TaskProgress TaskProgress[]
}

model TaskList {
  id          String    @id
  title       String
  description String?
  publishAt   DateTime?
  deadline    DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Task        Task[]
  Teacher     Teacher   @relation(fields: [createdBy], references: [id])

  @@index([createdBy])
  @@index([createdAt])
}

model TaskProgress {
  id            String    @id
  taskId        String
  studentId     String
  status        String    @default("pending")
  seenEditorial Boolean   @default(false)
  needHelp      Boolean   @default(false)
  notes         String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  Task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  Student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
  @@index([studentId])
  @@index([status])
}

model Teacher {
  id        String      @id
  userId    String      @unique
  name      String
  email     String?
  phone     String?
  avatar    String?
  bio       String?
  title     String?
  status    String      @default("active")
  schoolId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime
  Milestone Milestone[]
  Student   Student[]
  TaskList  TaskList[]
  User      User        @relation(fields: [userId], references: [id])
  School    School?     @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([status])
  @@index([createdAt])
}

model Team {
  id              String            @id
  name            String
  avatar          String?
  description     String?
  announcement    String?
  schoolId        String
  isPublic        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Contest         Contest[]
  School          School            @relation(fields: [schoolId], references: [id])
  TeamJoinRequest TeamJoinRequest[]
  TeamMember      TeamMember[]

  @@index([schoolId])
  @@index([isPublic])
  @@index([schoolId, isPublic])
  @@index([createdAt])
}

model TeamJoinRequest {
  id          String    @id
  teamId      String
  studentId   String
  status      String    @default("pending")
  message     String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  processedBy String?
  Student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Team        Team      @relation(fields: [teamId], references: [id])

  @@unique([teamId, studentId])
}

model TeamMember {
  id        String   @id
  teamId    String
  userId    String
  userType  String
  role      String
  status    String   @default("active")
  joinedAt  DateTime @default(now())
  invitedBy String?
  Team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId, userType])
  @@index([teamId, status, role])
  @@index([userId, userType, status])
  @@index([teamId, role])
  @@index([status])
}

model TeamOperationLog {
  id           String   @id
  teamId       String
  operatorId   String
  operatorType String
  action       String
  targetId     String?
  targetType   String?
  oldValue     String?
  newValue     String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([teamId])
  @@index([operatorId])
  @@index([action])
  @@index([createdAt])
}

model User {
  id           String   @id
  username     String   @unique
  passwordHash String
  role         String
  status       String   @default("active")
  avatar       String?
  phone        String?
  email        String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Admin        Admin?
  Student      Student?
  Teacher      Teacher?
  PlatformBindings UserPlatformBinding[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model UserPlatformBinding {
  id               String     @id
  userId           String
  platform         String                    // vjudge | luogu | codeforces | atcoder
  platformUsername String?                   // 第三方平台用户名
  bindingStatus    String     @default("unbound")  // unbound | pending | bound | failed
  bindingData      String?                   // JSON: 存储绑定所需的额外数据（如 token、cookie 等）
  verifiedAt       DateTime?                 // 验证成功时间
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  User             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
}

model UserStatusLog {
  id             String   @id
  targetUserId   String
  operatorUserId String
  operatorRole   String
  oldStatus      String
  newStatus      String
  reason         String?
  createdAt      DateTime @default(now())
}
