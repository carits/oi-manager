enum TrainingEngineSessionType {
  OI
  ACM
  GENERAL
}

enum TrainingEngineSessionStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  ENDED
  ARCHIVED
}

enum TrainingEngineStageKind {
  TRAINING
  TEACHING
  REVIEW
}

enum TrainingEngineStageAudienceMode {
  ALL
  GROUPED
}

enum TrainingEngineStageLifecycle {
  PENDING
  RUNNING
  COMPLETED
  ENDED_EARLY
  SKIPPED
}

enum TrainingEngineStageEndPolicy {
  MANUAL
  TIME
  COMPLETION
  HYBRID
}

enum TrainingEngineStageAccessPolicy {
  ALL_AT_ONCE
  SEQUENTIAL
  TEACHER_CONTROLLED
}

enum TrainingEngineGroupChangeEffectiveMode {
  IMMEDIATE
  NEXT_STAGE
}

enum TrainingEngineSubmissionMode {
  ENABLED
  DISABLED
}

enum TrainingEnginePauseMode {
  SOFT
  HARD
}

enum TrainingEngineTargetType {
  ALL
  GROUP
  TEAM
  USER
}

enum TrainingEngineProgressStatus {
  NOT_STARTED
  WORKING
  STUCK
  COMPLETED
  SKIPPED
  PAUSED
  FOCUS_OVERRIDE
}

enum TrainingEngineRankingMode {
  OFF
  PROGRESS_ONLY
  SCORE
  ACM_RANKING
}

enum TrainingEnginePeerVisibility {
  NONE
  PROGRESS
  SCORE
  FULL
}

enum TrainingEngineJoinMode {
  CURRENT_STAGE
  FROM_BEGINNING
  TEACHER_ASSIGN
}

enum TrainingEngineHintOpenMode {
  MANUAL
  TIME
  ATTEMPT
  SCORE
}

model TrainingSession {
  id                    String                          @id @default(uuid())
  legacyTrainingId      Int?                            @unique
  title                 String
  description           String?                         @db.Text
  sessionType           TrainingEngineSessionType       @default(GENERAL)
  status                TrainingEngineSessionStatus     @default(DRAFT)
  organizationId        String?
  teamId                String?
  createdBy             String
  scheduledStartAt      DateTime?
  startedAt             DateTime?
  runningSince          DateTime?
  pausedAt              DateTime?
  endedAt               DateTime?
  archivedAt            DateTime?
  activeElapsedSeconds  Int                             @default(0)
  currentStageId        String?
  statusRevision        Int                             @default(0)
  commandSeq            Int                             @default(0)
  eventSeq              Int                             @default(0)
  defaultAccessPolicy   TrainingEngineStageAccessPolicy @default(ALL_AT_ONCE)
  defaultSubmissionMode TrainingEngineSubmissionMode    @default(ENABLED)
  pauseMode             TrainingEnginePauseMode?
  allowHints            Boolean                         @default(true)
  allowSolution         Boolean                         @default(false)
  allowDiscussion       Boolean                         @default(false)
  rankingMode           TrainingEngineRankingMode       @default(PROGRESS_ONLY)
  peerVisibility        TrainingEnginePeerVisibility    @default(PROGRESS)
  joinMode              TrainingEngineJoinMode          @default(CURRENT_STAGE)
  settings              Json?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  Organization          Organization?                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  Team                  Team?                           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  Stages                TrainingSessionStage[]
  Participants          TrainingSessionParticipant[]
  Commands              TrainingSessionCommand[]
  Overlays              TrainingSessionOverlay[]
  Drafts                TrainingSessionProblemDraft[]
  Hints                 TrainingSessionHint[]
  Events                TrainingSessionEvent[]
  Overrides             TrainingSessionUserOverride[]
  Submissions           Submission[]

  @@index([organizationId, status])
  @@index([teamId, status])
  @@index([createdBy, createdAt])
  @@index([status, scheduledStartAt])
}

model TrainingSessionStage {
  id                     String                                      @id @default(uuid())
  sessionId              String
  name                   String
  description            String?                                     @db.Text
  orderIndex             Int
  kind                   TrainingEngineStageKind                     @default(TRAINING)
  audienceMode           TrainingEngineStageAudienceMode             @default(ALL)
  lifecycle              TrainingEngineStageLifecycle                @default(PENDING)
  endPolicy              TrainingEngineStageEndPolicy                @default(MANUAL)
  accessPolicy           TrainingEngineStageAccessPolicy             @default(ALL_AT_ONCE)
  submissionMode         TrainingEngineSubmissionMode                @default(ENABLED)
  plannedDurationSeconds Int?
  defaultTargetScore     Int?
  completionThreshold    Int?
  minDurationSeconds     Int?
  runningSince           DateTime?
  activeElapsedSeconds   Int                                         @default(0)
  endedBy                String?
  endReason              String?                                     @db.Text
  definitionRevision     Int                                         @default(0)
  rules                  Json?
  startedAt              DateTime?
  endedAt                DateTime?
  createdAt              DateTime                                    @default(now())
  updatedAt              DateTime                                    @updatedAt
  Session                TrainingSession                             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  Problems               TrainingSessionStageProblem[]
  ProblemPlans           TrainingSessionStageProblemPlan[]
  Groups                 TrainingSessionStageGroup[]
  ParticipantAssignments TrainingSessionStageParticipantAssignment[]
  RuntimeSnapshot        TrainingSessionStageRuntimeSnapshot?
  TimeAdjustments        TrainingSessionStageTimeAdjustment[]
  GroupChanges           TrainingSessionStageGroupChange[]

  @@unique([sessionId, orderIndex])
  @@index([sessionId, lifecycle])
}

model TrainingSessionStageProblem {
  id                       String                            @id @default(uuid())
  stageId                  String
  problemId                String
  testSetRevisionId        String
  alias                    String?
  orderIndex               Int
  unlockPolicy             Json?
  targetScore              Int?
  timePolicy              Json?
  stuckPolicy             Json?
  hintPolicy               Json?
  judgeConfigProjection    String?                           @db.Text
  allowedSubtaskIds        Json?
  strategyIntervalSeconds  Int?
  scoreGoals               Json?
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt
  Stage                    TrainingSessionStage              @relation(fields: [stageId], references: [id], onDelete: Cascade)
  Problem                  Problem                           @relation(fields: [problemId], references: [id], onDelete: Restrict)
  TestSetRevision          ProblemTestSetRevision            @relation(fields: [testSetRevisionId], references: [id], onDelete: Restrict)
  Progress                 TrainingSessionProblemProgress[]
  Hints                    TrainingSessionHint[]
  ScoreEvents              TrainingSessionScoreEvent[]
  StrategyDecisions        TrainingSessionStrategyDecision[]
  Submissions              Submission[]
  Plans                    TrainingSessionStageProblemPlan[]

  @@unique([stageId, problemId])
  @@unique([stageId, orderIndex])
  @@index([problemId])
  @@index([testSetRevisionId])
}

model TrainingSessionParticipant {
  id                String                                      @id @default(uuid())
  sessionId         String
  userId            String
  status            String                                      @default("active")
  currentStageId    String?
  currentProblemId  String?
  returnStageId     String?
  returnProblemId   String?
  joinedAt          DateTime                                    @default(now())
