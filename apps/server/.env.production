# 生产环境配置模板
# 复制为 .env.production 并修改为实际值

# PostgreSQL 数据库连接
DATABASE_URL="postgresql://oi:CHANGE_ME@localhost:5432/oi_manager?schema=public"

# JWT Secret（生产环境必须使用强随机密钥）
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# 服务端口
PORT=3002

# API 限流（每分钟最大请求数）
RATE_LIMIT_MAX=2000

# DeepSeek API Key（AI 翻译用）
# DEEPSEEK_API_KEY=sk-xxx

# 洛谷 Cookie（用于下载附件）
# LUOGU_COOKIE="__client_id=xxx; _uid=xxx"

# QOJ Session（用于 PDF 下载）
# QOJ_SESSION="xxx"
