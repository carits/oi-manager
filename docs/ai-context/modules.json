      "stableSpecs": [
        "docs/architecture/ARCHITECTURE_RULES.md"
      ],
      "escalationSpecs": {
        "schema": [
          "docs/architecture/DATA_MODEL.md"
        ],
        "judge": [
          "docs/architecture/JUDGE_AND_SUBMISSIONS.md",
          "docs/architecture/JUDGE_DOMAIN.md"
        ],
        "rating": [
          "docs/architecture/RATING_DOMAIN.md"
        ]
      }
    },
