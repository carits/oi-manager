{
  "name": "oi-manager-v2",
  "version": "1.0.0",
  "private": true,
  "description": "信息学竞赛三端成长管理平台",
  "scripts": {
    "dev": "pnpm --filter @oi-manager/contracts build && pnpm --filter @oi-manager/shared build && pnpm --filter server prisma:generate && bash scripts/check-ports.sh 3001 3002 && pnpm --parallel -r dev",
    "dev:dirty": "pnpm --filter server prisma:generate && bash scripts/check-ports.sh 3001 3002 && pnpm --parallel -r dev",
    "dev:hmr": "pnpm --filter web dev:hmr",
    "preview:build": "bash scripts/build-preview.sh",
    "preview:start": "bash scripts/start-preview.sh",
    "preview:stop": "bash scripts/stop-preview.sh",
    "preview:health": "node scripts/preview-health.mjs",
    "preview:canary": "bash scripts/start-preview-canary.sh",
    "preview:canary:stop": "bash scripts/stop-preview-canary.sh",
    "preview:promote": "bash scripts/promote-preview.sh",
    "preview:rollback": "bash scripts/rollback-preview.sh",
    "start": "bash scripts/restart-dev.sh",
    "restart": "bash scripts/restart-dev.sh",
    "stop": "bash scripts/stop-dev.sh",
    "monitor": "bash scripts/monitor-services.sh",
    "monitor:install": "bash scripts/install-monitor-cron.sh",
    "operations:timers:install": "sudo bash scripts/install-operation-timers.sh",
    "operations:timers:verify": "bash scripts/verify-operation-timers.sh",
    "monitor:verify": "bash scripts/verify-operations-observability.sh",
    "monitor:external:verify": "bash scripts/verify-external-uptime-workflow.sh",
    "logs:archive": "bash scripts/archive-operations-logs.sh",
    "logs:archive:install": "bash scripts/install-log-archive-cron.sh",
    "backup:verify": "bash scripts/verify-backup-restore.sh",
    "backup:verify:core": "bash scripts/verify-restored-core-flows.sh",
    "backup:assets": "bash scripts/backup-assets.sh",
    "backup:assets:verify": "bash scripts/verify-assets-restore.sh",
    "backup:assets:test": "bash scripts/verify-asset-backup.sh",
    "disaster:restore": "bash scripts/restore-production-database.sh",
    "disaster:restore:verify": "bash scripts/verify-production-restore-script.sh",
    "disaster:restore:assets": "bash scripts/restore-production-assets.sh",
    "disaster:restore:assets:verify": "bash scripts/verify-production-asset-restore-script.sh",
    "load:smoke": "bash scripts/load-smoke.sh",
    "runtime:audit": "node scripts/audit-runtime-limits.mjs",
    "network:audit": "node scripts/audit-network-exposure.mjs",
    "security:audit": "node scripts/audit-runtime-security.mjs",
    "security:verify": "bash scripts/verify-runtime-security-audit.sh",
    "security:baseline": "bash scripts/run-security-baseline.sh",
    "security:baseline:verify": "bash scripts/verify-security-baseline-timeout.sh",
    "security:baseline:install": "bash scripts/install-security-baseline-cron.sh",
    "tls:verify": "bash scripts/verify-tls-tooling.sh",
    "csp:verify": "node scripts/verify-csp-response.mjs",
    "security:rotate:check": "pnpm --filter server exec tsx scripts/rotate-runtime-secrets.ts",
    "security:rotate:verify": "bash scripts/verify-secret-rotation.sh",
    "db:bootstrap:check": "pnpm --filter server exec tsx scripts/bootstrap-clean-database.ts",
    "db:bootstrap": "pnpm --filter server exec tsx scripts/bootstrap-clean-database.ts --apply",
    "db:bootstrap:verify": "bash scripts/verify-clean-database-bootstrap.sh",
    "db:install-paths:verify": "bash scripts/verify-database-install-paths.sh",
    "db:baseline:check": "node scripts/verify-database-baseline.mjs",
    "db:baseline:create": "node scripts/create-database-baseline.mjs",
    "sandbox:smoke": "node scripts/smoke-go-judge.mjs",
    "compose": "bash scripts/compose.sh",
    "test:stress:prepare": "pnpm test:ui:prepare",
    "test:stress:judge": "pnpm test:stress:prepare && bash scripts/run-isolated-judge-stress.sh",
    "test:stress:blue-green": "bash scripts/run-isolated-blue-green.sh",
    "test:stress:faults": "bash scripts/run-isolated-infrastructure-faults.sh",
    "build": "pnpm --filter @oi-manager/contracts build && pnpm --filter @oi-manager/shared build && pnpm --filter server prisma:generate && pnpm --filter server build && pnpm --filter web build && pnpm --filter @oi-manager/judge build",
    "test": "pnpm judge:templates:check && pnpm --filter server test && pnpm --filter web test && pnpm --filter @oi-manager/judge test",
    "test:ui:prepare": "pnpm --filter server exec tsx scripts/e2e/reset.ts",
    "test:ui": "pnpm test:ui:prepare && playwright test",
    "test:ui:smoke": "pnpm test:ui:prepare && playwright test --project=chromium-desktop --project=firefox-smoke --grep @smoke",
    "test:ui:ux": "pnpm test:ui:prepare && playwright test e2e/tests/route-smoke.spec.ts --project=chromium-desktop --project=chromium-compact",
    "test:ui:headed": "pnpm test:ui:prepare && playwright test --project=chromium-desktop --headed",
    "test:chat:e2e": "pnpm test:ui:prepare && playwright test e2e/tests/direct-chat-flow.spec.ts --project=chromium-desktop --grep @chat-core",
    "test:chat:release": "pnpm test:ui:prepare && playwright test e2e/tests/direct-chat-flow.spec.ts --project=chromium-desktop --project=chromium-compact --project=firefox-chat",
    "test:chat:race": "bash scripts/run-chat-races.sh",
    "test:chat:live": "playwright test chat-probe.spec.ts --config=playwright.live.config.ts",
    "chat:probe:provision": "bash scripts/provision-chat-probes.sh",
    "test:ui:live": "playwright test --config=playwright.live.config.ts",
    "test:ui:report": "playwright show-report test-results/playwright-report",
    "docs:check": "node scripts/docs-check.mjs && node scripts/audit-api-auth.mjs && pnpm architecture:check",
    "architecture:inventory": "node scripts/generate-architecture-inventory.mjs",
    "architecture:routes:baseline": "node scripts/audit-route-boundaries.mjs --update",
    "architecture:check": "node scripts/generate-architecture-inventory.mjs --check && node scripts/audit-route-boundaries.mjs && node scripts/audit-domain-state-writes.mjs && node scripts/audit-domain-boundaries.mjs && pnpm db:baseline:check",
    "judge:slo": "pnpm --filter server exec tsx scripts/check-judge-slo.ts",
    "judge:slo:check": "pnpm --filter server exec tsx scripts/check-judge-slo.ts --enforce",
    "judge:projection:audit": "pnpm --filter server exec tsx scripts/audit-judge-projection.ts",
    "judge:projection:check": "pnpm --filter server exec tsx scripts/audit-judge-projection.ts --enforce",
    "contest:aggregate:audit": "pnpm --filter server exec tsx scripts/audit-contest-aggregate.ts",
    "contest:aggregate:check": "pnpm --filter server exec tsx scripts/audit-contest-aggregate.ts --enforce",
    "judge:templates:check": "pnpm --filter @oi-manager/contracts build && pnpm --filter @oi-manager/shared build && node scripts/check-judge-program-templates.mjs",
    "judge:protocols:smoke": "pnpm --filter @oi-manager/shared build && pnpm --filter @oi-manager/judge smoke:program-protocols",
    "judge:workflow:live": "node scripts/verify-live-judge-program-workflow.mjs",
    "operations:snapshot": "pnpm --filter server exec tsx scripts/collect-operational-state.ts",
    "operations:check": "pnpm --filter server exec tsx scripts/collect-operational-state.ts --enforce",
    "incident:capture": "bash scripts/capture-incident-evidence.sh",
    "incident:verify": "bash scripts/verify-incident-evidence.sh",
    "api:auth-audit": "node scripts/audit-api-auth.mjs",
    "api:anonymous-audit": "node scripts/check-api-anonymous.mjs",
    "ui:state-check": "node scripts/ui-state-check.mjs && node scripts/ui-contract-check.mjs",
    "ui:contract-baseline": "node scripts/ui-contract-check.mjs --update",
    "routes:audit": "node scripts/audit-web-navigation.mjs",
    "lint": "pnpm -r lint",
    "install:all": "pnpm install"
  },
  "keywords": [
    "oi",
    "education",
    "contest"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.61.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "form-data@<4.0.6": "4.0.6",
      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "path-to-regexp@<0.1.13": "0.1.13",
      "postcss@<8.5.23": "8.5.23",
      "qs@>=6.11.1 <6.16.0": "6.16.0"
    },
    "ignoredOptionalDependencies": [
      "sharp"
    ]
  }
}
