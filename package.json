{
  "name": "oi-manager-v2",
  "version": "1.0.0",
  "private": true,
  "description": "信息学竞赛三端成长管理平台",
  "scripts": {
    "dev": "pnpm --filter @oi-manager/shared build && bash scripts/kill-ports.sh && pnpm --parallel -r dev",
    "dev:dirty": "pnpm --filter @oi-manager/shared build && pnpm --parallel -r dev",
    "restart": "bash scripts/restart-dev.sh",
    "stop": "bash scripts/stop-dev.sh",
    "kill-ports": "bash scripts/kill-ports.sh",
    "build": "pnpm --filter @oi-manager/shared build && pnpm --filter server build && pnpm --filter web build && pnpm --filter @oi-manager/judge build",
    "test": "pnpm --filter server test && pnpm --filter web test && pnpm --filter @oi-manager/judge test",
    "test:ui:prepare": "pnpm --filter server exec tsx scripts/e2e/reset.ts",
    "test:ui": "pnpm test:ui:prepare && playwright test",
    "test:ui:smoke": "pnpm test:ui:prepare && playwright test --project=chromium-desktop --project=firefox-smoke --grep @smoke",
    "test:ui:headed": "pnpm test:ui:prepare && playwright test --project=chromium-desktop --headed",
    "test:ui:live": "playwright test --config=playwright.live.config.ts",
    "test:ui:report": "playwright show-report test-results/playwright-report",
    "docs:check": "node scripts/docs-check.mjs",
    "start:production": "pm2 start ecosystem.config.js --update-env",
    "lint": "pnpm -r lint",
    "install:all": "pnpm install"
  },
  "keywords": [
    "oi",
    "education",
    "contest"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.61.0"
  }
}
